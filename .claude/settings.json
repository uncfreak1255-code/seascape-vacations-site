{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(wc:*)",
      "Bash(set +H:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(/usr/bin/grep *)",
      "mcp__ccd_pr__get_status",
      "Bash(launchctl print *)",
      "Bash(launchctl print-disabled *)",
      "mcp__gbrain__recall",
      "Bash(shasum *)",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "Bash(task list)",
      "Bash(gbrain recall *)",
      "mcp__Claude_Browser__find",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__guide",
      "Bash(plutil -p *)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.netlify/credential*)",
      "Write(**/.netlify/credential*)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  }
}
