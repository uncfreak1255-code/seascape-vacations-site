---
layout: layouts/base.njk
permalink: "/design-lab/why-book-direct/"
eleventyExcludeFromCollections: true
seoIndexable: false
pageTitle: "Why Book Direct Receipt Design Lab"
pageDescription: "Preview-only Seascape direct-booking receipt comparison for the homepage Why Book Direct section."
pageAuthor: "Seascape Vacations Team"
pageImage: "https://seascape-vacations.com/images/seascape-og-default.jpg"
navActive: "home"
navButtonHref: "https://book.seascape-vacations.com"
navButtonLabel: "Book Direct"
navButtonTarget: "_blank"
navButtonRel: "noopener noreferrer"
headExtra: |
  <link rel="stylesheet" href="/css/design-lab-why-book-direct.css">
---
{% from "partials/ui-icon.njk" import uiIcon %}

<div class="direct-lab-note">
  <span>Preview-only homepage section candidate</span>
  <a href="/">Current homepage</a>
</div>

<section class="direct-receipt" aria-labelledby="direct-receipt-title">
  <div class="direct-receipt__shell">
    <div class="direct-receipt__intro">
      <p class="direct-receipt__eyebrow">Why Book Direct</p>
      <h1 id="direct-receipt-title">Same home. Same dates. $386 less.</h1>
      <p class="direct-receipt__lede">Book the same Seascape stay without the platform service fee. This sample receipt shows where the money changes before a guest ever checks in.</p>
      <div class="direct-receipt__cta-row" aria-label="Direct booking proof points">
        <span>{{ uiIcon('check', 'direct-proof__icon') }} No platform service fee</span>
        <span>{{ uiIcon('phone', 'direct-proof__icon') }} Local host support</span>
        <span>{{ uiIcon('star', 'direct-proof__icon direct-proof__icon--star') }} Five-star homes</span>
      </div>
    </div>

    <div class="receipt-board" aria-label="Direct booking savings receipt">
      <div class="receipt-board__summary">
        <span>You save</span>
        <strong>$386</strong>
        <em>about 10% on the same 7-night stay</em>
      </div>

      <div class="receipt-board__grid">
        <article class="receipt-card receipt-card--platform" aria-labelledby="platform-receipt-title">
          <div class="receipt-card__topline">
            <p id="platform-receipt-title">Airbnb</p>
            <span>Platform</span>
          </div>
          <div class="receipt-card__rows">
            <div class="receipt-row">
              <span>7 nights at $450</span>
              <strong>$3,150</strong>
            </div>
            <div class="receipt-row receipt-row--fee">
              <span>Service fee</span>
              <strong>$441</strong>
            </div>
            <div class="receipt-row receipt-row--fee">
              <span>Cleaning with markup</span>
              <strong>$245</strong>
            </div>
            <div class="receipt-row">
              <span>Occupancy taxes</span>
              <strong>$221</strong>
            </div>
          </div>
          <div class="receipt-total">
            <span>Total</span>
            <strong>$3,721</strong>
          </div>
        </article>

        <article class="receipt-card receipt-card--direct" aria-labelledby="direct-receipt-card-title">
          <div class="receipt-card__topline">
            <p id="direct-receipt-card-title">Seascape direct</p>
            <span>Best value</span>
          </div>
          <div class="receipt-card__rows">
            <div class="receipt-row">
              <span>7 nights at $450</span>
              <strong>$3,150</strong>
            </div>
            <div class="receipt-row receipt-row--zero">
              <span>Service fee</span>
              <strong>$0</strong>
            </div>
            <div class="receipt-row">
              <span>Cleaning at actual cost</span>
              <strong>$185</strong>
            </div>
            <div class="receipt-row">
              <span>Occupancy taxes</span>
              <strong>$221</strong>
            </div>
          </div>
          <div class="receipt-total receipt-total--direct">
            <span>Total</span>
            <strong>$3,335</strong>
          </div>
        </article>
      </div>
    </div>

    <blockquote class="direct-review">
      <p>"Hands down the best rental we've ever experienced. The place was spotlessly clean and the hosts responded to every question immediately."</p>
      <footer>Kurt Jones · Dockside Dreams</footer>
    </blockquote>
  </div>
</section>
