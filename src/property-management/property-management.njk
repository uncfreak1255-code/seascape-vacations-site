---
pagination:
  data: seoPages.owner
  size: 1
  alias: seoPage
permalink: "/property-management/{{ seoPage.slug }}/"
eleventyComputed:
  pageTitle: "{{ seoPage.title }}"
  pageDescription: "{{ seoPage.description }}"
---
{% from "partials/owner-evaluation-form.njk" import ownerEvaluationForm %}
{% set ownerProofSource = "" %}
{% if seoPage.proofAssetKey %}{% set ownerProofSource = "src/_data/ownerProofAssets.json" %}{% endif %}
{% set pageUpdatedIso = seoPageLastModifiedIso("owner", seoPage.slug, page.inputPath, ownerProofSource) %}
{% set pageUpdatedDate = seoPageLastModifiedDate("owner", seoPage.slug, page.inputPath, ownerProofSource) %}
{% set pageUpdatedLabel = seoPageLastModifiedLabel("owner", seoPage.slug, page.inputPath, ownerProofSource) %}
{% set proofAsset = seoPage.proofAssetKey and ownerProofAssets[seoPage.proofAssetKey] %}
{% set pageProofStats = seoPage.proofStats or (proofAsset and proofAsset.stats) %}
{% set ownerNetBridgePage = seoPage.slug == "maximize-vacation-rental-income-florida" %}
{% set ownerMoneyPage = seoPage.slug == "vacation-rental-management-fees-florida"
  or seoPage.slug == "vacation-rental-licensing-florida"
  or seoPage.slug == "vrbo-management-services-florida" %}
{% set showOwnerBenchmarkPath = ownerMoneyPage or ownerNetBridgePage %}
{% set pageQuarantined = seoPage.quarantined == true %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary SEO -->
    <title>{{ seoPage.title }} | Seascape Vacations</title>
    <meta name="description" content="{{ seoPage.description }}">
    <meta name="robots" content="{% if pageQuarantined %}noindex, nofollow{% else %}index, follow{% endif %}">
    <link rel="canonical" href="{{ site.url }}/property-management/{{ seoPage.slug }}/">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}/property-management/{{ seoPage.slug }}/">
    <meta property="og:title" content="{{ seoPage.title }}">
    <meta property="og:description" content="{{ seoPage.description }}">
    <meta property="og:image" content="{{ site.url }}/images/seascape-og-default.jpg">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Seascape Vacations">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seoPage.title }}">
    <meta name="twitter:description" content="{{ seoPage.description }}">
    <meta name="twitter:image" content="{{ site.url }}/images/seascape-og-default.jpg">

    {% include "partials/organization-schema.njk" %}
    
<!-- Service Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "{{ seoPage.title }}",
        "description": "{{ seoPage.description }}",
        "provider": {
            "@type": "Organization",
            "name": "Seascape Vacations",
            "url": "{{ site.url }}"
        },
        "areaServed": {
            "@type": "State",
            "name": "Florida"
        },
        "serviceType": "Vacation Rental Property Management"
    }
    </script>
    
    <!-- Breadcrumb Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}"},
            {"@type": "ListItem", "position": 2, "name": "Property Management", "item": "{{ site.url }}/property-management/"},
            {"@type": "ListItem", "position": 3, "name": "{{ seoPage.h1 }}", "item": "{{ site.url }}/property-management/{{ seoPage.slug }}/"}
        ]
    }
    </script>

    <!-- Article Schema for GEO freshness -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "{{ seoPage.title }}",
        "description": "{{ seoPage.description }}",
        "image": "{{ site.url }}/images/seascape-og-default.jpg",
        "author": {% if proofAsset and proofAsset.reviewedBy %}{
            "@type": "Person",
            "name": "{{ proofAsset.reviewedBy }}",
            {% if proofAsset.reviewerRole %}"jobTitle": "{{ proofAsset.reviewerRole }}",
            {% endif %}"worksFor": {
                "@type": "Organization",
                "name": "Seascape Vacations",
                "url": "{{ site.url }}"
            }
        }{% else %}{
            "@type": "Organization",
            "name": "{{ site.author }}",
            "url": "{{ site.url }}"
        }{% endif %},
        "publisher": {
            "@type": "Organization",
            "name": "Seascape Vacations",
            "url": "{{ site.url }}",
            "logo": { "@type": "ImageObject", "url": "{{ site.url }}/logo-optimized.png" }
        },
        "datePublished": "{{ seoPage.datePublished | default('2025-01-15') }}",
        "dateModified": "{{ pageUpdatedIso or pageUpdatedDate }}",
        "mainEntityOfPage": "{{ site.url }}/property-management/{{ seoPage.slug }}/"
    }
    </script>

    {% if not pageQuarantined and seoPage.faqs | length %}
    <!-- FAQPage Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for faq in seoPage.faqs %}
            {
                "@type": "Question",
                "name": "{{ faq.q }}",
                "acceptedAnswer": { "@type": "Answer", "text": "{{ faq.a | stripHtml | escape }}" }
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
    {% endif %}
    
    <link rel="icon" href="/logo-optimized.png" type="image/png">

    {% include "partials/local-font-head.njk" %}
    <link rel="preload" href="/assets/fonts/guest/instrument-serif.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/guest.css?v=waterline-v3">
    <link rel="stylesheet" href="/css/owner.css?v=waterline-v3">
    <link rel="stylesheet" href="/css/owner-lander.css?v=waterline-v1">
</head>
{#- Waterline owner lander (November 2026). Shares tokens and section rules with
    the owner hub (owner.css); lander-only rules live in owner-lander.css. -#}
{% set landerMarkets = { "sarasota": "Sarasota", "siesta-key": "Siesta Key", "bradenton": "Bradenton", "anna-maria-island": "Anna Maria Island" } %}
{% set landerMarket = landerMarkets[seoPage.destination] %}
{% set heroHomeSlug = "sarasota-luxe" if (seoPage.destination == "sarasota" or seoPage.destination == "siesta-key") else "the-oasis" %}
{% set heroHome = properties | propertyBySlug(heroHomeSlug) %}
<body class="guest-site owner-lander" data-guest-version="waterline-v3">
    <a class="g-skip" href="#main">Skip to content</a>
    {#- The shared header holds a wordmark, a call target, this button and the
        menu on one non-wrapping row. seoPage.primaryCta is a full sentence
        ("Request Your Revenue Review"), which pushed the row past a 360-393px
        viewport on all 26 generated owner routes. The page's own hero CTA below
        still carries the full label. -#}
    {% set navActive = "owners" %}
    {% set navButtonLabel = "For owners" if pageQuarantined else "Revenue Review" %}
    {% set navButtonHref = "/property-management/" if pageQuarantined else "#owner-cta" %}
    {% set navButtonAttributes = "" if pageQuarantined else ('data-track-event="owner_primary_cta_click" data-page-slug="' ~ seoPage.slug ~ '"') %}
    {% include "partials/guest-header.njk" %}

    <main id="main" class="g-owner g-lander">
        {% if pageQuarantined %}
        <section class="g-owner-section g-owner-section-last">
            <div class="g-wrap g-lander-read">
                <p class="g-label">{{ seoPage.reviewTag or "Under professional review" }}</p>
                <h1>{{ seoPage.reviewTitle or "This guidance is not available for reliance." }}</h1>
                <p class="g-owner-lede">{{ seoPage.reviewNotice or "Seascape Vacations is not publishing guidance from this page while it is being professionally reviewed. Please consult a qualified professional for advice about your property." }}</p>
                <p><a class="g-button" href="/property-management/">Return to property management</a></p>
            </div>
        </section>
        {% else %}
        <nav class="g-wrap g-breadcrumb g-lander-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span>
            <a href="/property-management/">Property Management</a><span aria-hidden="true">/</span>
            <span aria-current="page">{{ seoPage.h1 }}</span>
        </nav>

        <section class="g-lander-hero owner-dark-band" aria-labelledby="lander-title">
            <div class="g-wrap g-lander-hero-grid">
                <div class="g-lander-hero-copy">
                    <p class="g-label">For Property Owners{% if landerMarket %} &middot; {{ landerMarket }}{% endif %}</p>
                    <h1 id="lander-title">{{ seoPage.h1 }}</h1>
                    <p class="g-owner-lede">{{ seoPage.intro }}</p>
                    <div class="g-owner-actions">
                        <a href="#owner-cta" class="g-button g-lander-primary" data-track-event="owner_primary_cta_click" data-page-slug="{{ seoPage.slug }}">{{ seoPage.primaryCta or "Request Your Revenue Review" }}</a>
                    </div>
                    <p class="g-lander-subcopy">{{ seoPage.ctaSubcopy or "We break down management fees, booking-source costs, and what your current setup is actually costing you before you decide anything." }}</p>
                </div>
                <aside class="g-lander-sheet" aria-labelledby="lander-sheet-title">
                    <p class="g-label" id="lander-sheet-title">The one-page review</p>
                    <ol>
                        <li><span aria-hidden="true">01</span>What looks right</li>
                        <li><span aria-hidden="true">02</span>What deserves a second look</li>
                        <li><span aria-hidden="true">03</span>What we would check next</li>
                    </ol>
                    <p class="g-lander-sheet-foot">Usually back within 48 hours.</p>
                </aside>
            </div>
            {% if showOwnerBenchmarkPath %}
            <div class="g-wrap">
                <div class="g-lander-path">
                    <p class="g-label">{% if ownerNetBridgePage %}Start Here{% else %}Before You Switch{% endif %}</p>
                    <p>
                        {% if ownerNetBridgePage %}
                        If your calendar looks active but your payout still feels thin, start with the <a href="/research/owner-fee-revenue-leak-benchmark-2026/">owner fee guide</a>, then compare
                        <a href="/property-management/vacation-rental-management-fees-florida/">management fees</a> and
                        <a href="/property-management/vrbo-management-services-florida/">booking-channel handling</a> before you
                        <a href="/property-management/#owner-cta">request your review</a>.
                        {% else %}
                        Start with the <a href="/research/owner-fee-revenue-leak-benchmark-2026/">owner fee guide</a>, then compare
                        <a href="/property-management/vacation-rental-management-fees-florida/">fees</a>,
                        <a href="/property-management/vacation-rental-licensing-florida/">licensing</a>, and
                        <a href="/property-management/vrbo-management-services-florida/">VRBO handling</a> before you
                        <a href="/property-management/#owner-cta">request your review</a>.
                        {% endif %}
                    </p>
                </div>
            </div>
            {% endif %}
        </section>

        {% if pageProofStats and pageProofStats | length %}
        <section class="g-owner-section g-lander-proof">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.proofTag or "Proof" }}</p>
                        <h2>{{ seoPage.proofTitle or "What the numbers say before the pitch starts" }}</h2>
                    </div>
                    <p>{{ seoPage.proofSubtitle or "Fee percentages are not the whole story. Revenue quality, direct mix, and execution discipline decide what owners actually keep." }}</p>
                </div>
                <dl class="g-lander-ledger">
                    {% for stat in pageProofStats %}
                    <div>
                        <dt>{{ stat.label }}</dt>
                        <dd class="g-lander-ledger-value">{{ stat.value }}</dd>
                        {% if stat.detail %}
                        <dd class="g-lander-ledger-detail">{{ stat.detail }}</dd>
                        {% endif %}
                    </div>
                    {% endfor %}
                </dl>
                {% if proofAsset %}
                <div class="g-lander-sources">
                    <p class="g-label">Fee Guide Sources</p>
                    <h3>{{ proofAsset.title }}</h3>
                    <p>{{ proofAsset.summary }}</p>
                    <p><strong>Reviewed by:</strong> {{ proofAsset.reviewedBy }}{% if proofAsset.reviewerRole %}, {{ proofAsset.reviewerRole }}{% endif %}</p>
                    <p><strong>Updated:</strong> {{ proofAsset.updatedDateLabel or proofAsset.updatedDate or proofAsset.reviewedDateLabel or proofAsset.reviewedDate }}</p>
                    {% if proofAsset.sources and proofAsset.sources.length %}
                    <p><strong>Sources:</strong>
                        {% for source in proofAsset.sources %}
                        <a href="{{ source.url }}">{{ source.label }}</a>{% if not loop.last %} · {% endif %}
                        {% endfor %}
                    </p>
                    {% elif proofAsset.sourceUrl %}
                    <p><strong>Source:</strong> <a href="{{ proofAsset.sourceUrl }}">{{ proofAsset.sourceLabel }}</a></p>
                    {% endif %}
                    {% if proofAsset.benchmarkUrl %}
                    <p><strong>Owner fee guide:</strong> <a href="{{ proofAsset.benchmarkUrl }}">Compare Airbnb, card-processing, and management charges</a></p>
                    <p>Read the <a href="/property-management/vacation-rental-management-fees-florida/">fee reality page</a> and the <a href="/property-management/maximize-vacation-rental-income-florida/">owner income guide</a> before you compare managers on headline percentage alone.</p>
                    {% endif %}
                    {% if proofAsset.methodology %}
                    <p class="g-lander-muted"><strong>Methodology:</strong> {{ proofAsset.methodology }}</p>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </section>
        {% else %}
        <section class="g-owner-section g-lander-proof">
            <div class="g-wrap">
                <dl class="g-lander-ledger">
                    <div><dt>Management Pricing</dt><dd class="g-lander-ledger-value">Tailored</dd></div>
                    <div><dt>Guest Support</dt><dd class="g-lander-ledger-value">24/7</dd></div>
                    <div><dt>One-Page Revenue Review</dt><dd class="g-lander-ledger-value">48 hr</dd></div>
                    <div><dt>Gulf Coast Team</dt><dd class="g-lander-ledger-value">Local</dd></div>
                </dl>
            </div>
        </section>
        {% endif %}

        {% if heroHome and heroHome.photography and heroHome.photography.photos[0] %}
        {% set bandPhoto = heroHome.photography.photos[0] %}
        <figure class="g-owner-band g-lander-band">
            <img src="{{ bandPhoto.src }}" srcset="{{ bandPhoto.src | replace('.webp', '-800.webp') }} 800w, {{ bandPhoto.src }} 1400w" sizes="100vw" width="{{ bandPhoto.width }}" height="{{ bandPhoto.height }}" alt="{{ bandPhoto.alt }}" loading="lazy" decoding="async">
            <figcaption class="g-wrap">{{ heroHome.name }}, {{ heroHome.city }}. A home we manage.</figcaption>
        </figure>
        {% endif %}

        {% if seoPage.switchReasons and seoPage.switchReasons | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.switchTag or "What Usually Breaks First" }}</p>
                        <h2>{{ seoPage.switchTitle or "Why owners start shopping for a different manager" }}</h2>
                    </div>
                    <p>{{ seoPage.switchSubtitle or "The trigger is rarely one bad month. It is a stack of missed details that keeps showing up in revenue, reviews, and owner trust." }}</p>
                </div>
                <div class="g-lander-cards">
                    {% for reason in seoPage.switchReasons %}
                    <div>
                        <h3>{{ reason.title }}</h3>
                        <p>{{ reason.body }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.benefits and seoPage.benefits | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.benefitsTag or "Execution Gap" }}</p>
                        <h2>{{ seoPage.benefitsTitle or "Where Seascape closes the gap" }}</h2>
                    </div>
                    <p>{{ seoPage.benefitsSubtitle or "Owners do not need a definition of management. They need evidence that the right manager fixes the expensive parts." }}</p>
                </div>
                <ol class="g-owner-checklist g-lander-benefits">
                    {% for benefit in seoPage.benefits %}
                    <li><span aria-hidden="true">{{ loop.index }}</span>{{ benefit }}</li>
                    {% endfor %}
                </ol>
            </div>
        </section>
        {% endif %}

        {% if seoPage.marketReality %}
        <section class="g-owner-section">
            <div class="g-wrap g-lander-split">
                <div>
                    <p class="g-label">{{ seoPage.marketReality.tag or "Market Reality" }}</p>
                    <h2>{{ seoPage.marketReality.title }}</h2>
                </div>
                <div class="g-lander-prose">
                    {{ seoPage.marketReality.body | safe }}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.revenueLevers and seoPage.revenueLevers | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.revenueTag or "Revenue Levers" }}</p>
                        <h2>{{ seoPage.revenueTitle or "What actually moves owner revenue" }}</h2>
                    </div>
                    <p>{{ seoPage.revenueSubtitle or "Better outcomes usually come from compounding improvements, not one trick or one software tool." }}</p>
                </div>
                <div class="g-lander-cards">
                    {% for lever in seoPage.revenueLevers %}
                    <div>
                        <h3>{{ lever.title }}</h3>
                        <p>{{ lever.body }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.reviewDeliverable %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.reviewDeliverable.tag }}</p>
                        <h2>{{ seoPage.reviewDeliverable.title }}</h2>
                    </div>
                    <p>{{ seoPage.reviewDeliverable.intro }}</p>
                </div>
                <div class="g-lander-cards">
                    {% for item in seoPage.reviewDeliverable.items %}
                    <article>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.body }}</p>
                    </article>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.visibilityLayer %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.visibilityLayer.tag }}</p>
                        <h2>{{ seoPage.visibilityLayer.title }}</h2>
                    </div>
                    <p>{{ seoPage.visibilityLayer.intro }}</p>
                </div>
                <div class="g-lander-cards">
                    {% for item in seoPage.visibilityLayer.items %}
                    <article>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.body }}</p>
                    </article>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.processSteps and seoPage.processSteps | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.processTag or "Getting Started" }}</p>
                        <h2>{{ seoPage.processTitle or "How the takeover works" }}</h2>
                    </div>
                    <p>{{ seoPage.processSubtitle or "The goal is to improve the operation without blowing up existing booking momentum." }}</p>
                </div>
                <ol class="g-owner-rows">
                    {% for step in seoPage.processSteps %}
                    <li><span aria-hidden="true">0{{ loop.index }}</span><div><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div></li>
                    {% endfor %}
                </ol>
            </div>
        </section>
        {% else %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">Getting Started</p>
                        <h2>How It Works</h2>
                    </div>
                </div>
                <ol class="g-owner-rows">
                    <li><span aria-hidden="true">01</span><div><h3>Review Your Current Setup</h3><p>Send the listing link or property address and the documents you want reviewed.</p></div></li>
                    <li><span aria-hidden="true">02</span><div><h3>Check the Expensive Gaps</h3><p>We compare the information you provide and flag what still needs verification.</p></div></li>
                    <li><span aria-hidden="true">03</span><div><h3>Get One Clear Next Step</h3><p>Within 48 hours, get a one-page review of what to keep, fix, or discuss.</p></div></li>
                </ol>
            </div>
        </section>
        {% endif %}

        <!-- GEO Intro - citation-ready rich content -->
        {% if seoPage.geoIntro %}
        <section class="g-owner-section">
            <div class="g-wrap g-lander-read">
                <div class="g-lander-prose">
                    {{ seoPage.geoIntro | safe }}
                </div>
                <div class="g-lander-byline">
                    <p class="g-lander-byline-name">{{ (proofAsset and proofAsset.reviewedBy) or site.author }}</p>
                    <p class="g-updated-stamp">{% if proofAsset and proofAsset.reviewerRole %}{{ proofAsset.reviewerRole }} • {% endif %}Updated {{ pageUpdatedLabel }}</p>
                    {% if proofAsset and proofAsset.sources and proofAsset.sources.length %}
                    <p>
                        Sources:
                        {% for source in proofAsset.sources %}
                        <a href="{{ source.url }}">{{ source.label }}</a>{% if not loop.last %} · {% endif %}
                        {% endfor %}
                    </p>
                    {% elif proofAsset and proofAsset.sourceUrl %}
                    <p><a href="{{ proofAsset.sourceUrl }}">Source: {{ proofAsset.sourceLabel }}</a></p>
                    {% endif %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Long-form content for SEO depth -->
        {% if seoPage.longContent %}
        <section class="g-owner-section">
            <div class="g-wrap g-lander-read">
                <h2>{{ seoPage.contentTitle | default("More About " + seoPage.h1) }}</h2>
                <div class="g-lander-prose">
                    {{ seoPage.longContent | safe }}
                </div>
            </div>
        </section>
        {% endif %}

        {% if seoPage.objections and seoPage.objections | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">{{ seoPage.objectionsTag or "Owner Objections" }}</p>
                        <h2>{{ seoPage.objectionsTitle or "The questions that usually stall the decision" }}</h2>
                    </div>
                    <p>{{ seoPage.objectionsSubtitle or "Good owners do not buy on vibe. They pressure-test switching cost, revenue risk, and whether the manager actually knows the market." }}</p>
                </div>
                <div class="g-owner-faq">
                    {% for objection in seoPage.objections %}
                    <details {% if loop.first %}open{% endif %}>
                        <summary><span class="n" aria-hidden="true">{{ loop.index }}</span>{{ objection.question }}</summary>
                        <p>{{ objection.answer }}</p>
                    </details>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- FAQ Section -->
        {% if seoPage.faqs | length %}
        <section class="g-owner-section">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">Frequently Asked Questions</p>
                        <h2>{{ seoPage.h1 }} — FAQ</h2>
                    </div>
                </div>
                <div class="g-owner-faq">
                    {% for faq in seoPage.faqs %}
                    <details {% if loop.first %}open{% endif %}>
                        <summary><span class="n" aria-hidden="true">{{ loop.index }}</span>{{ faq.q }}</summary>
                        <p>{{ faq.a }}</p>
                    </details>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Related Services (Cross-linking) -->
        <section class="g-owner-section g-owner-section-last">
            <div class="g-wrap">
                <div class="g-owner-section-head">
                    <div>
                        <p class="g-label">Related Resources</p>
                        <h2>More for Property Owners</h2>
                    </div>
                    {% if showOwnerBenchmarkPath %}
                    <p>Use the fee guide, management-cost pages, and review request together instead of treating fees, licensing, and booking channels like separate decisions.</p>
                    {% endif %}
                </div>
                {% if showOwnerBenchmarkPath %}
                <p class="g-owner-links g-lander-path-links">
                    <a class="g-inline-link" href="/research/owner-fee-revenue-leak-benchmark-2026/">
                        Read the fee guide
                    </a>
                        {% if seoPage.slug != "vacation-rental-management-fees-florida" %}
                    <a class="g-inline-link" href="/property-management/vacation-rental-management-fees-florida/">
                        Compare management fees
                    </a>
                        {% endif %}
                        {% if seoPage.slug != "vacation-rental-licensing-florida" %}
                    <a class="g-inline-link" href="/property-management/vacation-rental-licensing-florida/">
                        Check licensing risk
                    </a>
                        {% endif %}
                        {% if seoPage.slug != "vrbo-management-services-florida" %}
                    <a class="g-inline-link" href="/property-management/vrbo-management-services-florida/">
                        Review VRBO handling
                    </a>
                        {% endif %}
                    <a class="g-inline-link" href="/property-management/#owner-cta">
                        Request your review
                    </a>
                </p>
                {% endif %}
                <div class="g-lander-related">
                    {% if seoPage.relatedOwnerResources and seoPage.relatedOwnerResources | length %}
                        {% for relatedSlug in seoPage.relatedOwnerResources %}
                            {% for page in seoPages.owner %}
                                {% if page.slug == relatedSlug %}
                    <a href="/property-management/{{ page.slug }}/">
                        <h3>{{ page.title }}</h3>
                        <p>{{ page.description | truncate(100) }}</p>
                    </a>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    {% else %}
                        {% set count = 0 %}
                        {% for page in seoPages.owner %}
                            {% if page.slug != seoPage.slug and count < 4 %}
                                {% if (seoPage.destination and page.destination == seoPage.destination) or (not seoPage.destination and not page.destination) %}
                                    {% set count = count + 1 %}
                    <a href="/property-management/{{ page.slug }}/">
                        <h3>{{ page.title }}</h3>
                        <p>{{ page.description | truncate(100) }}</p>
                    </a>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="cta-section g-lander-cta">
            <div class="g-wrap">
                <div id="owner-cta">
                    {{ ownerEvaluationForm({
                        eyebrow: "Private revenue review",
                        title: "Want the same review on your home?",
                        intro: "Send the listing link or property address, plus a sentence or two about what feels off. Seascape will read what you send and show what is clear, what looks expensive, and what still needs verification before any switch conversation.",
                        formTitle: "Request Your Revenue Review",
                        formIntro: "Start with the listing URL or address. Add one line on what feels off; an owner statement or fee quote makes the review sharper.",
                        proofNote: "Source note: Send what you have. We will tell you if a statement, booking calendar, guest review, or fee quote would make the review more useful.",
                        detailLabel: "What the review checks",
                        detailCopy: "The private revenue review shows what we can verify, what looks expensive, and what still needs a document before you decide whether to stay put, fix the setup, or talk about a transition.",
                        confirmation: "Got it. Seascape will read what you send and return the clearest next step: stay put, fix the current setup, or talk about a transition.",
                        pageSlug: seoPage.slug,
                        market: seoPage.destination or "florida-gulf-coast",
                        leadType: "owner-revenue-teardown",
                        buttonLabel: "Send My Review Request",
                        propertyFieldLabel: "Listing URL or property address",
                        propertyFieldPlaceholder: "airbnb.com/h/your-listing, vrbo.com/..., or full street address",
                        showBenchmarkFields: true,
                        fileHelp: "PDF, spreadsheet, or screenshot. You can submit the form without an upload."
                    }) }}
                    <p class="g-lander-cta-foot">
                        Not ready to send the review yet? Start with the <a href="/research/owner-fee-revenue-leak-benchmark-2026/">owner fee guide</a> or the <a href="/property-management/switch-vacation-rental-management-company/">switch guide</a>.
                    </p>
                    <p class="g-lander-cta-foot">
                        Prefer to talk first? <a href="tel:+19417048545" data-track-event="owner_phone_click" data-page-slug="{{ seoPage.slug }}">Call (941) 704-8545</a>
                    </p>
                </div>
            </div>
        </section>
        {% endif %}
    </main>

    {% include "partials/guest-footer.njk" %}

    {% include "partials/analytics-ga4.njk" %}
    <script defer src="/assets/js/guest.js?v=waterline-v5"></script>
</body>
</html>
