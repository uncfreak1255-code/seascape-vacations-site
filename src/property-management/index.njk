{% set bandHome = properties | propertyBySlug("dockside-dreams") %}
<div class="g-owner" data-owner-page>

  <section class="g-owner-hero" aria-labelledby="owner-title">
    <div class="g-wrap">
      <div class="g-owner-hero-copy">
        <p class="g-label">Property management &middot; Bradenton &amp; Sarasota</p>
        <h1 id="owner-title">Six homes. One local team. <em>Your call gets answered.</em></h1>
        <p class="g-owner-lede">Seascape manages a small collection of pool homes in Bradenton and Sarasota. We list, price, host and clean each one, pay you monthly, and tell you what your home earned and what needs attention before you have to ask.</p>
        <div class="g-owner-actions">
          <a class="g-button" href="#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="property-management">Request your 48-hour revenue review</a>

        </div>
        <p class="g-small g-owner-hero-note">A listing link or an address is enough to start. A sentence on what feels off helps.</p>
      </div>

      <aside class="g-owner-review" id="owner-cta" aria-labelledby="owner-review-title">
        <p class="g-label">48-hour revenue review</p>
        <h2 id="owner-review-title">Send the listing. We send back a one-page review.</h2>
        <p class="g-owner-review-intro">Four short questions, about two minutes. A real Seascape person reads every reply.</p>
        <form class="g-owner-form" novalidate name="owner-revenue-teardown" method="POST" action="/property-management/revenue-review-requested/" enctype="multipart/form-data" data-netlify="true" data-netlify-recaptcha="true" netlify-honeypot="bot-field" data-track-form="owner" data-form-start-event="owner_form_start" data-form-submit-event="owner_form_submit" data-skip-global-submit-track="true" data-page-slug="property-management" data-source-page-slug="property-management" data-market="florida-gulf-coast" data-form-placement="hero-review-panel" data-form-direction="forward">
          <input type="hidden" name="form-name" value="owner-revenue-teardown">
          <input type="hidden" name="page_slug" value="property-management">
          <input type="hidden" name="source_page_slug" value="property-management">
          <input type="hidden" name="market" value="florida-gulf-coast">
          <input type="hidden" name="lead_type" value="owner-revenue-teardown">
          <input type="hidden" name="proof_label" value="">
          <input type="hidden" name="form_placement" value="hero-review-panel">
          <input type="hidden" name="concerns" data-owner-concerns>
          <div hidden aria-hidden="true"><input type="text" name="bot-field" tabindex="-1" autocomplete="off"></div>

          <nav class="g-owner-steps" aria-label="Form progress">
            <button class="g-owner-step-dot is-active" type="button" data-form-goto="0" aria-label="Go to step 1">1</button>
            <span class="g-owner-step-line" aria-hidden="true"></span>
            <button class="g-owner-step-dot" type="button" data-form-goto="1" aria-label="Go to step 2">2</button>
            <span class="g-owner-step-line" aria-hidden="true"></span>
            <button class="g-owner-step-dot" type="button" data-form-goto="2" aria-label="Go to step 3">3</button>
            <span class="g-owner-step-line" aria-hidden="true"></span>
            <button class="g-owner-step-dot" type="button" data-form-goto="3" aria-label="Go to step 4">4</button>
            <span class="g-owner-step-meta" data-form-meta>Question 1 of 4</span>
          </nav>

          <div class="g-owner-panel is-active" data-form-step="0">
            <h3>Which listing or property?</h3>
            <p>Paste the Airbnb or Vrbo link, or type the street address.</p>
            <label class="g-owner-field"><span>Listing link or street address</span><input type="text" name="property_address" autocomplete="street-address" placeholder="airbnb.com/h/your-listing or 4250 Palm Ave, Sarasota"></label>
            <label class="g-owner-field g-owner-file"><span>Owner statement, optional</span><input type="file" name="owner_statement" accept=".pdf,.csv,.xls,.xlsx,.png,.jpg,.jpeg,.webp"><small>PDF, spreadsheet or screenshot.</small></label>
            <div class="g-owner-panel-actions">
              <button class="g-button" type="button" data-form-next>Continue</button>
              <button class="g-owner-text-button" type="button" data-form-next>Skip, I would rather describe it</button>
            </div>
          </div>

          <div class="g-owner-panel" data-form-step="1" hidden>
            <h3>What feels off right now?</h3>
            <p>Pick any that apply, then add one line in your own words.</p>
            <div class="g-owner-choices" role="group" aria-label="What feels off">
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Revenue feels low for the market">Revenue feels low for the market</button>
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Booking-site fees feel heavy">Booking-site fees feel heavy</button>
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Reporting feels weak">Reporting feels weak</button>
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Owner communication feels weak">Owner communication feels weak</button>
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Pricing or occupancy concerns">Pricing or occupancy concerns</button>
              <button class="g-owner-choice" type="button" aria-pressed="false" data-concern="Current manager concerns">Current manager concerns</button>
            </div>
            <label class="g-owner-field"><span>One line in your own words</span><textarea name="what_feels_off" rows="3" placeholder="The payout feels light and the statements are hard to follow." data-owner-concerns-mirror data-owner-context-field></textarea></label>
            <div class="g-owner-panel-actions">
              <button class="g-button" type="button" data-form-next>Continue</button>
              <button class="g-owner-text-button" type="button" data-form-back>Back</button>
            </div>
          </div>

          <div class="g-owner-panel" data-form-step="2" hidden>
            <h3>Where should we send it?</h3>
            <p>Name and email. Add a phone number if you want a text when it is ready.</p>
            <div class="g-owner-field-grid">
              <label class="g-owner-field"><span>Your name</span><input type="text" name="name" autocomplete="name" placeholder="First and last name" required></label>
              <label class="g-owner-field"><span>Email</span><input type="email" name="email" autocomplete="email" placeholder="Where the review should go" required></label>
              <label class="g-owner-field g-owner-field-full"><span>Phone, optional</span><input type="tel" name="phone" autocomplete="tel" placeholder="For a text when it is ready"></label>
              <label class="g-owner-field"><span>Current manager</span><input type="text" name="current_manager" placeholder="Manager name, or self-managed"></label>
              <label class="g-owner-field"><span>Fee quote, if known</span><input type="text" name="current_fee_quote" placeholder="15%, 20%, or the fee terms"></label>
            </div>
            <div class="g-owner-panel-actions">
              <button class="g-button" type="button" data-form-next>Continue</button>
              <button class="g-owner-text-button" type="button" data-form-back>Back</button>
            </div>
          </div>

          <div class="g-owner-panel" data-form-step="3" hidden>
            <h3>Ready to send?</h3>
            <p>We read the listing, look at what feels off, and reply with what we would check next.</p>
            <dl class="g-owner-recap" aria-label="Your answers">
              <div><dt>Listing</dt><dd data-confirm-url>Not added yet</dd></div>
              <div><dt>What feels off</dt><dd data-confirm-concerns>Not added yet</dd></div>
              <div><dt>Name</dt><dd data-confirm-name>Not added yet</dd></div>
              <div><dt>Email</dt><dd data-confirm-email>Not added yet</dd></div>
              <div><dt>Phone</dt><dd data-confirm-phone>Optional</dd></div>
            </dl>
            <div data-netlify-recaptcha="true"></div>
            <div class="g-owner-panel-actions">
              <button class="g-button" type="submit">Send my review request</button>
              <button class="g-owner-text-button" type="button" data-form-back>Back</button>
            </div>
          </div>
        </form>
        <p class="g-owner-review-foot">If something is missing we will ask for it rather than fill in the blanks. </p>
      </aside>
    </div>
  </section>

  {% if bandHome and bandHome.photography and bandHome.photography.photos[0] %}
  <figure class="g-owner-band">
    <img src="{{ bandHome.photography.photos[0].src }}" srcset="{{ bandHome.photography.photos[0].src | replace('.webp', '-800.webp') }} 800w, {{ bandHome.photography.photos[0].src }} 1400w" sizes="100vw" width="{{ bandHome.photography.photos[0].width }}" height="{{ bandHome.photography.photos[0].height }}" alt="{{ bandHome.photography.photos[0].alt }}" loading="lazy" decoding="async">
    <figcaption class="g-wrap">{{ bandHome.name }}, {{ bandHome.city }}. One of the six homes Seascape manages.</figcaption>
  </figure>
  {% endif %}

  <section class="g-owner-section" id="what-we-do" aria-labelledby="what-we-do-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="what-we-do-title">What we do for your home</h2>
        <p>The same five jobs, every week, for every home we manage.</p>
      </div>
      <ol class="g-owner-rows">
        <li><span aria-hidden="true">01</span><div><h3>List it on Airbnb, Vrbo and our own booking site</h3><p>Photos, description, house rules and calendar are kept current on every channel, and your home gets its own page on this site where guests book direct.</p></div></li>
        <li><span aria-hidden="true">02</span><div><h3>Reprice your calendar as demand moves</h3><p>Your rates are not set once in the spring and left alone. Every home runs on a demand model: nightly rates and minimum stays move with how the season is actually filling, what comparable Gulf Coast homes are holding for the same week, and what we watch booking across our own six homes and our direct site. A single night stranded between two reservations gets priced to sell instead of sitting empty, and a holiday week never goes out at a Tuesday rate. Patrick sets the pricing and walks you through the reasoning whenever you want it.</p></div></li>
        <li><span aria-hidden="true">03</span><div><h3>Screen and message every guest, locally</h3><p>A person in Bradenton reads the inquiries, screens the bookings and answers the guests. There is no call center.</p></div></li>
        <li><span aria-hidden="true">04</span><div><h3>Coordinate cleaning and maintenance, with photos</h3><p>Turnovers are scheduled and checked. When a deep clean or a repair is needed you get a note and a photo before you have to ask.</p></div></li>
        <li><span aria-hidden="true">05</span><div><h3>Pay you monthly, with a statement</h3><p>Each month you receive a statement of what the home earned and what was spent, along with your payout. County taxes are remitted for you.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="g-owner-section" id="why-seascape" aria-labelledby="why-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="why-title">Why a six-home operator</h2>
        <p>Attention is the one thing a small company can offer that a large one cannot.</p>
      </div>
      <div class="g-owner-three">
        <div>
          <h3>You reach the people who run your home</h3>
          <p>Sawyer and Patrick answer the phone. There is no account manager between you and the people making decisions about your home. <a href="tel:+19417048545">(941) 704-8545</a>, or <a href="/about-us/">meet the team</a>.</p>
        </div>
        <div>
          <h3>One of six, not one of six hundred</h3>
          <p>We keep the collection small on purpose. Six homes is few enough that we know each house, its quirks and its guests.</p>
        </div>
        <div>
          <h3>We tell you before you ask</h3>
          <p>Revenue, payout, reviews, deep-cleaning and maintenance notes come to you as they happen, not when you chase them.</p>
        </div>
      </div>
      <div class="g-owner-pricing">
        <p class="g-label">Pricing</p>
        <p>We do not have one fee for every home. After we look at your listing and statement we quote a share of net rent that fits what the home can earn, and we put the basis, the included services and any separate charges in writing.</p>
        <p>We also say no. If a house cannot carry its own cleaning, maintenance and service costs, we tell you that in the review instead of signing you and hoping it works out.</p>
        <p class="g-owner-links"><a class="g-inline-link" href="/property-management/vacation-rental-management-fees-florida/">How management fees actually work</a> <a class="g-inline-link" href="/research/owner-fee-revenue-leak-benchmark-2026/">What Airbnb host fees and card processing pay for</a></p>
      </div>
    </div>
  </section>

  <section class="g-owner-section" id="homes" aria-labelledby="homes-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="homes-title">The homes we manage</h2>
        <p>Real homes, real photographs. Every one has its own page on this site.</p>
      </div>
      <div class="g-owner-homes">
        {% for property in properties %}
        <a class="g-owner-home" href="{{ property.pageUrl }}">
          {% if property.photography and property.photography.photos[0] %}
          <img src="{{ property.photography.photos[0].src | replace('.webp', '-800.webp') }}" srcset="{{ property.photography.photos[0].src | replace('.webp', '-800.webp') }} 800w, {{ property.photography.photos[0].src }} 1400w" sizes="(min-width: 1051px) 400px, (min-width: 701px) 50vw, calc(100vw - 40px)" width="{{ property.photography.photos[0].width }}" height="{{ property.photography.photos[0].height }}" alt="{{ property.photography.photos[0].alt }}" loading="lazy" decoding="async">
          {% else %}
          <span class="g-photo-unavailable">{{ property.name }} photo unavailable</span>
          {% endif %}
          <h3>{{ property.name }}</h3>
          <p>{{ property.city }}</p>
        </a>
        {% endfor %}
      </div>
      <p class="g-owner-links"><a class="g-inline-link" href="/properties/">See all six homes</a></p>
    </div>
  </section>

  <section class="g-owner-section" id="review" aria-labelledby="review-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="review-title">What comes back in 48 hours</h2>
      </div>
      <div class="g-owner-two">
        <div>
          <p class="g-owner-lede">Send the listing link or the address, and a sentence on what feels off. A real Seascape person reads it. Back comes a one-page review of what deserves a second look and what we would check next, usually within 48 hours.</p>
          <p>If you send an owner statement too, we go line by line and say what each charge pays for. If we need something else to be useful, we ask rather than guess.</p>
          <div class="g-owner-actions">
            <a class="g-button" href="#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="property-management" data-placement="review-section">Request your review</a>
            <a class="g-owner-phone" href="tel:+19417048545" data-track-event="owner_phone_click" data-page-slug="property-management">Prefer to talk first? (941) 704-8545</a>
          </div>
        </div>
        <div>
          <p class="g-label">What we look at</p>
          <ol class="g-owner-checklist">
            <li><span aria-hidden="true">1</span>The listing: photos, description, pricing and calendar settings.</li>
            <li><span aria-hidden="true">2</span>The statement, if you send one: what each line pays for.</li>
            <li><span aria-hidden="true">3</span>What we would check next, in plain language.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="g-owner-section" id="guides" aria-labelledby="guides-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="guides-title">Owner guides</h2>
        <p>For the specific problem, when cleaning, taxes, screening, insurance or buying is the real blocker.</p>
      </div>
      <div class="g-owner-switchers">
        <p class="g-label">Start here if you are switching managers</p>
        <p>Read these in order before you decide: the <a href="/research/owner-fee-revenue-leak-benchmark-2026/">owner fee guide</a>, <a href="/property-management/vacation-rental-management-fees-florida/">how management fees actually work</a>, <a href="/property-management/vacation-rental-licensing-florida/">Florida licensing risk</a>, <a href="/property-management/vrbo-management-services-florida/">Vrbo handling</a>, then <a href="#owner-cta">request your 48-hour revenue review</a>.</p>
      </div>
      <div class="g-owner-guides">
        <a class="g-owner-guide" href="/property-management/maximize-vacation-rental-income-florida/">
          <img src="/images/owner-field-bradenton.jpg" alt="Sailboat near a Gulf Coast shoreline at sunset" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Revenue</span>
          <h3>What cuts into owner income</h3>
          <p>Fees, booking-source costs and operating issues, before a property-specific review.</p>
          <b>Read the guide</b>
        </a>
        <a class="g-owner-guide" href="/research/owner-fee-revenue-leak-benchmark-2026/">
          <img src="/images/owner-field-sarasota.jpg" alt="Palm-lined waterfront bridge at sunset" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Fee guide</span>
          <h3>Airbnb host fees vs card processing</h3>
          <p>Published fee definitions, their limits, and the questions to put beside a management quote.</p>
          <b>Read the fee comparison</b>
        </a>
        <a class="g-owner-guide" href="/property-management/vacation-rental-management-fees-florida/">
          <img src="/images/owner-field-sarasota-sunset.jpg" alt="Sunset over the water in Sarasota" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Fees</span>
          <h3>Vacation rental management fee reality</h3>
          <p>Compare property-management proposals and the services behind each quote.</p>
          <b>Read the management guide</b>
        </a>
        <a class="g-owner-guide" href="/property-management/switch-vacation-rental-management-company/">
          <img src="/images/owner-field-ami-cottages.jpg" alt="Colorful Anna Maria Island cottages with palms and bicycles" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Switching</span>
          <h3>How to switch without wrecking momentum</h3>
          <p>For owners weighing a fixable setup against a clean manager switch.</p>
          <b>Read the switch guide</b>
        </a>
        <a class="g-owner-guide" href="/property-management/vacation-rental-cleaning-services-florida/">
          <img src="/images/owner-field-anna-maria.jpg" alt="Anna Maria Island beach and Gulf water" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Turnover</span>
          <h3>Cleaning services that protect reviews</h3>
          <p>For bad turns, inspection misses and housekeeping control issues that cost repeat bookings.</p>
          <b>Read the cleaning guide</b>
        </a>
        <a class="g-owner-guide" href="/property-management/vacation-rental-guest-screening/">
          <img src="/images/owner-field-siesta-key.jpg" alt="Aerial view of a white sand Gulf Coast beach and turquoise water" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Risk</span>
          <h3>Guest screening standards</h3>
          <p>For owners whose real concern is property damage, neighbor friction or low-quality bookings.</p>
          <b>Read the screening guide</b>
        </a>
        <a class="g-owner-guide" href="/property-management/buy-vacation-rental-property-florida/">
          <img src="/images/owner-field-longboat.jpg" alt="Gulf beach sunset with a swimmer near the shore" loading="lazy" decoding="async" width="1200" height="800">
          <span class="g-label">Buying</span>
          <h3>Buy the right vacation rental property</h3>
          <p>Before another purchase, when a listing agent is selling the dream faster than the operating truth.</p>
          <b>Read the acquisition guide</b>
        </a>
      </div>

      <div class="g-owner-index">
        <div>
          <p class="g-label">Operations</p>
          <ol>
            <li><a href="/property-management/new-vacation-rental-owner-guide-florida/"><span class="n" aria-hidden="true">01</span>New vacation rental owner guide</a></li>
            <li><a href="/property-management/increase-vacation-rental-bookings/"><span class="n" aria-hidden="true">02</span>Increase vacation rental bookings</a></li>
            <li><a href="/property-management/vacation-rental-cleaning-services-florida/"><span class="n" aria-hidden="true">03</span>Cleaning services that protect reviews</a></li>
            <li><a href="/property-management/vacation-rental-guest-screening/"><span class="n" aria-hidden="true">04</span>Guest screening standards</a></li>
            <li><a href="/property-management/vacation-rental-insurance-florida/"><span class="n" aria-hidden="true">05</span>Florida vacation rental insurance</a></li>
            <li><div><span class="n" aria-hidden="true">06</span>Florida vacation rental taxes<small>Professional review required; consult a qualified tax professional.</small></div></li>
            <li><a href="/property-management/buy-vacation-rental-property-florida/"><span class="n" aria-hidden="true">07</span>Buy the right vacation rental property</a></li>
          </ol>
        </div>
        <div>
          <p class="g-label">Specific situations</p>
          <ol>
            <li><a href="/property-management/sell-vacation-rental-property-florida/"><span class="n" aria-hidden="true">08</span>Sell a vacation rental in Florida</a></li>
            <li><a href="/property-management/switch-from-airbnb-self-manage/"><span class="n" aria-hidden="true">09</span>Switch from Airbnb self-management</a></li>
            <li><a href="/property-management/vacation-rental-interior-design-florida/"><span class="n" aria-hidden="true">10</span>Interior design for vacation rentals</a></li>
            <li><a href="/property-management/vacation-rental-licensing-florida/"><span class="n" aria-hidden="true">11</span>Florida licensing requirements</a></li>
            <li><a href="/property-management/vacation-rental-maintenance-florida/"><span class="n" aria-hidden="true">12</span>Maintenance that preserves revenue</a></li>
            <li><a href="/property-management/vacation-rental-management-siesta-key/"><span class="n" aria-hidden="true">13</span>Siesta Key management</a></li>
            <li><a href="/property-management/vacation-rental-photography-florida/"><span class="n" aria-hidden="true">14</span>Vacation rental photography</a></li>
            <li><a href="/property-management/vrbo-management-services-florida/"><span class="n" aria-hidden="true">15</span>Vrbo management services</a></li>
            <li><a href="/property-management/condo-rental-management-florida/"><span class="n" aria-hidden="true">16</span>Condo rental management</a></li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="g-owner-section g-owner-section-last" id="faq" aria-labelledby="faq-title">
    <div class="g-wrap">
      <div class="g-owner-section-head">
        <h2 id="faq-title">Selected FAQ</h2>
        <p>What Gulf Coast owners usually ask first.</p>
      </div>
      <div class="g-owner-faq">
        <details open>
          <summary><span class="n" aria-hidden="true">01</span>How do I know if my market can support professional management fees?</summary>
          <p>Start with the services and fee basis in the agreement, not a generic public percentage. Read the <a href="/research/owner-fee-revenue-leak-benchmark-2026/">Airbnb host fee and card-processing guide</a>, then request a revenue review if you need a property-specific management quote.</p>
        </details>
        <details>
          <summary><span class="n" aria-hidden="true">02</span>What should a local manager handle that a remote manager usually misses?</summary>
          <p>The short answer is local response time. Cleaning quality control, maintenance triage, guest screening, and property checks are all weaker when the manager is not operating in-market. The market-specific service pages break down how that changes between <a href="/property-management/vacation-rental-management-bradenton/">Bradenton</a>, <a href="/property-management/vacation-rental-management-sarasota/">Sarasota</a>, and <a href="/property-management/vacation-rental-management-anna-maria-island/">Anna Maria Island</a>.</p>
        </details>
        <details>
          <summary><span class="n" aria-hidden="true">03</span>What should I read before choosing a vacation rental manager?</summary>
          <p>Start with the page that matches your market, then read the <a href="/property-management/vacation-rental-management-fees-florida/">fee reality page</a>, the <a href="/property-management/maximize-vacation-rental-income-florida/">income breakdown</a>, and the <a href="/property-management/switch-vacation-rental-management-company/">switch-management page</a> if you think the current setup is the real problem.</p>
        </details>
      </div>
    </div>
  </section>

  <div class="g-owner-sticky" data-owner-sticky hidden>
    <span><strong>48-hour revenue review</strong>A listing link or address is enough.</span>
    <a class="g-button" href="#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="property-management" data-placement="sticky">Request review</a>
  </div>
</div>

<script>
  (function () {
    var page = document.querySelector("[data-owner-page]");
    if (!page) return;
    var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // conversion-tracking.js is deferred and defines this AFTER this inline block
    // parses, so read it lazily on every use instead of capturing undefined once.
    function conversionTrackingApi() {
      return window.SeascapeConversionTracking;
    }

    function track(eventName, payload) {
      if (!eventName) return;
      var conversionTracking = conversionTrackingApi();
      if (conversionTracking && typeof conversionTracking.trackEvent === "function") {
        conversionTracking.trackEvent(eventName, payload || {});
        return;
      }
      if (typeof window.seascapeTrackEvent === "function") {
        window.seascapeTrackEvent(eventName, payload || {});
        return;
      }
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, payload || {});
      }
    }

    var sticky = page.querySelector("[data-owner-sticky]");
    var reviewPanel = document.getElementById("owner-cta");
    if (sticky && reviewPanel && "IntersectionObserver" in window) {
      var stickyObserver = new IntersectionObserver(function (entries) {
        sticky.hidden = entries[entries.length - 1].isIntersecting;
      }, { threshold: 0.15 });
      stickyObserver.observe(reviewPanel);
    }

    var form = page.querySelector(".g-owner-form");
    if (!form) return;
    var step = 0;
    var dots = form.querySelectorAll("[data-form-goto]");
    var lines = form.querySelectorAll(".g-owner-step-line");
    var steps = form.querySelectorAll("[data-form-step]");
    var meta = form.querySelector("[data-form-meta]");
    var concernsInput = form.querySelector("[data-owner-concerns]");
    var concernsMirror = form.querySelector("[data-owner-concerns-mirror]");
    var listingField = form.querySelector('input[name="property_address"]');
    var nameField = form.querySelector('input[name="name"]');
    var emailField = form.querySelector('input[name="email"]');
    var phoneField = form.querySelector('input[name="phone"]');
    var confirmUrl = form.querySelector("[data-confirm-url]");
    var confirmConcerns = form.querySelector("[data-confirm-concerns]");
    var confirmName = form.querySelector("[data-confirm-name]");
    var confirmEmail = form.querySelector("[data-confirm-email]");
    var confirmPhone = form.querySelector("[data-confirm-phone]");
    var concerns = [];
    var submitting = false;

    function syncConfirmPanel() {
      var concernSummary = concerns.length ? concerns.join(", ") : "";
      if (concernsMirror && concernsMirror.value.trim()) {
        concernSummary = concernSummary ? concernSummary + " | " + concernsMirror.value.trim() : concernsMirror.value.trim();
      }
      if (confirmUrl) confirmUrl.textContent = listingField && listingField.value.trim() ? listingField.value.trim() : "Not added yet";
      if (confirmConcerns) confirmConcerns.textContent = concernSummary || "Not added yet";
      if (confirmName) confirmName.textContent = nameField && nameField.value.trim() ? nameField.value.trim() : "Not added yet";
      if (confirmEmail) confirmEmail.textContent = emailField && emailField.value.trim() ? emailField.value.trim() : "Not added yet";
      if (confirmPhone) confirmPhone.textContent = phoneField && phoneField.value.trim() ? phoneField.value.trim() : "Optional";
    }

    function getFormPayload(extra) {
      return Object.assign({
        page_slug: form.dataset.pageSlug || "property-management",
        source_page_slug: form.dataset.sourcePageSlug || "property-management",
        market: form.dataset.market || "",
        step_number: step + 1
      }, extra || {});
    }

    function getSubmitPayload(extra) {
      var sourceContext = {};
      var conversionTracking = conversionTrackingApi();
      if (conversionTracking && typeof conversionTracking.getSourceContext === "function") {
        sourceContext = conversionTracking.getSourceContext();
      }
      return Object.assign(
        {},
        sourceContext,
        getFormPayload(Object.assign({
          placement: form.dataset.formPlacement || ""
        }, extra || {}))
      );
    }

    function currentPanelFieldsAreValid() {
      var panel = steps[step];
      if (!panel) return true;
      var requiredFields = panel.querySelectorAll("input[required], textarea[required]");
      for (var i = 0; i < requiredFields.length; i += 1) {
        if (!requiredFields[i].checkValidity()) {
          requiredFields[i].reportValidity();
          return false;
        }
      }
      return true;
    }

    function validateAllRequiredFields() {
      var requiredFields = form.querySelectorAll("input[required], textarea[required]");
      for (var i = 0; i < requiredFields.length; i += 1) {
        if (requiredFields[i].checkValidity()) continue;
        var invalidPanel = requiredFields[i].closest("[data-form-step]");
        var invalidStep = invalidPanel ? Number(invalidPanel.getAttribute("data-form-step")) : step;
        showStep(invalidStep, invalidStep < step ? "back" : "forward", { silent: true });
        requiredFields[i].reportValidity();
        return false;
      }
      return true;
    }

    function validateOwnerContext() {
      var hasListing = listingField && listingField.value.trim();
      var hasConcern = concerns.length > 0 || (concernsInput && concernsInput.value.trim()) || (concernsMirror && concernsMirror.value.trim());
      if (hasListing || hasConcern) return true;

      showStep(0, "back", { silent: true });
      if (listingField) {
        listingField.setCustomValidity("Send the listing or address, or choose what feels off.");
        listingField.reportValidity();
      }
      return false;
    }

    function showStep(nextStep, direction, options) {
      options = options || {};
      step = Math.max(0, Math.min(steps.length - 1, nextStep));
      form.setAttribute("data-form-direction", direction || "forward");
      steps.forEach(function (panel, index) {
        var active = index === step;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
      dots.forEach(function (dot, index) {
        dot.classList.toggle("is-active", index === step);
        dot.classList.toggle("is-complete", index < step);
        dot.textContent = index < step ? "✓" : String(index + 1);
      });
      lines.forEach(function (line, index) {
        line.classList.toggle("is-complete", index < step);
      });
      if (meta) {
        meta.textContent = "Question " + (step + 1) + " of 4";
      }
      if (step === 3) syncConfirmPanel();
      if (!options.silent) {
        track("owner_form_step_view", getFormPayload({ viewed_step: step + 1 }));
        if (window.matchMedia && window.matchMedia("(max-width: 700px)").matches && steps[step]) {
          window.setTimeout(function () {
            steps[step].scrollIntoView({
              block: "start",
              behavior: reduceMotion ? "auto" : "smooth"
            });
          }, 40);
        }
      }
    }

    form.querySelectorAll("[data-form-next]").forEach(function (button) {
      button.addEventListener("click", function () {
        if (!currentPanelFieldsAreValid()) return;
        var nextStep = Math.min(step + 1, steps.length - 1);
        track("owner_form_step_continue", getFormPayload({ from_step: step + 1, to_step: nextStep + 1 }));
        showStep(nextStep, "forward");
      });
    });

    form.querySelectorAll("[data-form-back]").forEach(function (button) {
      button.addEventListener("click", function () {
        var nextStep = Math.max(step - 1, 0);
        track("owner_form_step_back", getFormPayload({ from_step: step + 1, to_step: nextStep + 1 }));
        showStep(nextStep, "back");
      });
    });

    dots.forEach(function (dot) {
      dot.addEventListener("click", function () {
        var targetStep = Number(dot.getAttribute("data-form-goto"));
        if (targetStep > step && !currentPanelFieldsAreValid()) return;
        showStep(targetStep, targetStep < step ? "back" : "forward");
      });
    });

    form.querySelectorAll("[data-concern]").forEach(function (button) {
      button.addEventListener("click", function () {
        var concern = button.getAttribute("data-concern");
        var index = concerns.indexOf(concern);
        if (index >= 0) concerns.splice(index, 1);
        else concerns.push(concern);
        button.classList.toggle("is-active", index < 0);
        button.setAttribute("aria-pressed", index < 0 ? "true" : "false");
        concernsInput.value = concerns.join(", ");
        syncConfirmPanel();
        clearOwnerContextValidity();
        track("owner_form_concern_toggle", getFormPayload({
          concern: concern,
          selected: index < 0 ? "true" : "false"
        }));
      });
    });

    if (listingField) {
      listingField.addEventListener("input", function () {
        listingField.setCustomValidity("");
        syncConfirmPanel();
      });
    }
    function clearOwnerContextValidity() {
      // The listing field carries the "listing or concern" custom error. It can be
      // satisfied by EITHER input, so every path that satisfies it must clear it,
      // not just typing in the listing field.
      if (listingField) listingField.setCustomValidity("");
    }
    if (concernsMirror) concernsMirror.addEventListener("input", function () {
      clearOwnerContextValidity();
      syncConfirmPanel();
    });
    if (nameField) nameField.addEventListener("input", syncConfirmPanel);
    if (emailField) emailField.addEventListener("input", syncConfirmPanel);
    if (phoneField) phoneField.addEventListener("input", syncConfirmPanel);

    form.addEventListener("submit", function (event) {
      // preventDefault first: a second click inside the submit window must not
      // fall through to an unprevented native submit.
      event.preventDefault();
      if (submitting) return;
      if (!validateAllRequiredFields()) return;
      if (!validateOwnerContext()) return;
      submitting = true;
      syncConfirmPanel();
      track("owner_form_submit", getSubmitPayload({
        concerns_count: String(concerns.length),
        concern_note_present: concernsMirror && concernsMirror.value.trim() ? "true" : "false",
        listing_present: listingField && listingField.value.trim() ? "true" : "false"
      }));
      window.setTimeout(function () {
        if (typeof HTMLFormElement !== "undefined" && HTMLFormElement.prototype.submit) {
          HTMLFormElement.prototype.submit.call(form);
          return;
        }
        form.submit();
      }, 120);
    });

    showStep(0, "forward", { silent: true });
    // Deferred: at parse time none of the tracking globals exist yet, so firing
    // here loses the step-1 view and silently zeroes the top of the funnel.
    function trackFirstStepView() {
      track("owner_form_step_view", getFormPayload({ viewed_step: 1 }));
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", trackFirstStepView, { once: true });
    } else {
      trackFirstStepView();
    }
  })();
</script>
