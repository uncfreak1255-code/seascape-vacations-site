<script>
  (function () {
    var page = document.querySelector("[data-owner-field-page]");
    if (!page) return;

    page.querySelectorAll("[data-owner-market]").forEach(function (marketRoot) {
      var buttons = marketRoot.querySelectorAll("[data-market-button]");
      var panels = marketRoot.querySelectorAll("[data-market-panel]");

      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          var id = button.getAttribute("data-market-button");
          buttons.forEach(function (candidate) {
            var active = candidate === button;
            candidate.classList.toggle("is-active", active);
            candidate.setAttribute("aria-pressed", active ? "true" : "false");
          });
          panels.forEach(function (panel) {
            panel.classList.toggle("is-active", panel.getAttribute("data-market-panel") === id);
          });
        });
      });
    });

    var form = page.querySelector(".owner-field-postcard");
    if (!form) return;
    var step = 0;
    var dots = form.querySelectorAll("[data-form-goto]");
    var steps = form.querySelectorAll("[data-form-step]");
    var concernsInput = form.querySelector("[data-owner-concerns]");
    var concerns = [];

    function showStep(nextStep) {
      step = Math.max(0, Math.min(steps.length - 1, nextStep));
      steps.forEach(function (panel, index) {
        panel.classList.toggle("is-active", index === step);
      });
      dots.forEach(function (dot, index) {
        dot.classList.toggle("is-active", index === step);
        dot.classList.toggle("is-complete", index < step);
      });
    }

    form.querySelectorAll("[data-form-next]").forEach(function (button) {
      button.addEventListener("click", function () {
        showStep(step + 1);
      });
    });

    form.querySelectorAll("[data-form-back]").forEach(function (button) {
      button.addEventListener("click", function () {
        showStep(step - 1);
      });
    });

    dots.forEach(function (dot) {
      dot.addEventListener("click", function () {
        showStep(Number(dot.getAttribute("data-form-goto")));
      });
    });

    form.querySelectorAll("[data-concern]").forEach(function (button) {
      button.addEventListener("click", function () {
        var concern = button.getAttribute("data-concern");
        var index = concerns.indexOf(concern);
        if (index >= 0) concerns.splice(index, 1);
        else concerns.push(concern);
        button.classList.toggle("is-active", index < 0);
        concernsInput.value = concerns.join(", ");
      });
    });
  })();
</script>
