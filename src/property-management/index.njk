    align-items: center;
    min-height: 36px;
    padding: 8px 14px;
    border: 1px solid rgba(95, 138, 139, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--owner-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .owner-field-proof-chip a {
    color: inherit;
  }

  .owner-field-stats {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: 48px;
  }

  .owner-field-stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 8px;
    padding: 24px 0 20px;
    border-top: 1px solid rgba(45, 70, 71, 0.45);
    border-bottom: 1px solid rgba(45, 70, 71, 0.45);
  }

  .owner-field-stat--large {
    grid-row: span 2;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: space-between;
  }

  .owner-field-stat strong {
    display: block;
    margin: 10px 0 0;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(48px, 8vw, 126px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .owner-field-stat:not(.owner-field-stat--large) strong {
    font-size: clamp(38px, 4vw, 58px);
  }

  .owner-field-stat-caption {
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(18px, 2vw, 24px);
    font-style: italic;
    line-height: 1.2;
  }

  .owner-field-stat p {
    margin: 4px 0 0;
    color: var(--stone-light);
    font-size: 13px;
    line-height: 1.7;
  }

  .owner-field-market-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: start;
  }

  .owner-field-map {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: var(--owner-ink);
    box-shadow: inset 0 0 0 1px rgba(245, 228, 176, 0.15), 0 30px 60px -30px rgba(45, 70, 71, 0.45);
  }

  .owner-field-map svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .owner-field-map-line.is-animating {
    animation: owner-field-line-draw 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .owner-field-pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 4px;
    border: 0;
    background: transparent;
    color: var(--white);
    transform: translate(-50%, -100%);
    cursor: pointer;
  }

  .owner-field-pin-preview {
    position: absolute;
    bottom: 38px;
    left: 50%;
    width: 168px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--white);
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.4);
    color: var(--owner-ink);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    animation: owner-field-preview-in 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .owner-field-pin:hover .owner-field-pin-preview,
  .owner-field-pin:focus-visible .owner-field-pin-preview {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .owner-field-pin.is-active .owner-field-pin-preview {
    display: none;
  }

  .owner-field-pin-preview::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    background: var(--white);
    transform: translateX(-50%) rotate(45deg);
  }

  .owner-field-pin-preview i {
    display: block;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, rgba(245, 238, 214, 0.94), rgba(201, 169, 98, 0.52));
    background-position: center;
    background-size: cover;
  }

  .owner-field-pin-preview.is-loaded i {
    background-image: var(--preview);
  }

  .owner-field-pin-preview b {
    display: block;
    padding: 8px 12px 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.15;
  }

  .owner-field-pin-preview small {
    display: block;
    padding: 4px 12px 10px;
    color: var(--stone-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .owner-field-pin-dot {
    position: relative;
    width: 22px;
    height: 28px;
    color: var(--cream);
  }

  .owner-field-pin-ring {
    position: absolute;
    inset: -6px;
    border: 1px solid var(--owner-gold-hot);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .owner-field-pin.is-active .owner-field-pin-ring {
    opacity: 1;
    animation: owner-field-pin-pulse 1.6s ease-out infinite;
  }

  .owner-field-pin-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    background: currentColor;
    clip-path: path("M11 0 C4 0 0 5 0 11 C0 18 11 28 11 28 C11 28 22 18 22 11 C22 5 18 0 11 0 Z");
  }

  .owner-field-pin-dot::after {
    content: "";
    position: absolute;
    left: 8px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--owner-ink);
  }

  .owner-field-pin span:last-child {
    padding: 3px 10px;
    border-radius: 30px;
    background: rgba(10, 26, 28, 0.5);
    color: var(--white);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 13px;
    font-style: italic;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .owner-field-pin.is-active {
    color: var(--owner-gold-hot);
  }

  .owner-field-pin.is-active span:last-child {
    background: rgba(10, 26, 28, 0.74);
    color: var(--owner-gold-hot);
    font-size: 16px;
  }

  .owner-field-hq {
    position: absolute;
    left: 44%;
    top: 40%;
    color: var(--owner-gold-hot);
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .owner-field-hq::before {
    content: "";
    display: block;
    width: 10px;
    height: 10px;
    margin: 0 auto 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px rgba(245, 228, 176, 0.24), 0 0 0 6px rgba(245, 228, 176, 0.12);
  }

  .owner-field-hq span {
    display: block;
    color: currentColor;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .owner-field-market-card {
    display: none;
    animation: owner-field-fade-up 0.45s ease both;
  }

  .owner-field-market-card.is-active {
    display: block;
  }

  .owner-field-market-photo {
    position: relative;
    aspect-ratio: 16 / 10;
    margin-bottom: 28px;
    overflow: hidden;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(31, 58, 60, 0.86), rgba(201, 169, 98, 0.46));
    background-position: center;
    background-size: cover;
  }

  .owner-field-market-photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.82;
  }

  .owner-field-market-photo.is-loaded {
    background-image: var(--market-photo);
  }

  .owner-field-market-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.68));
  }

  .owner-field-market-photo strong {
    position: absolute;
    z-index: 1;
    left: 28px;
    bottom: 24px;
    color: var(--white);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .owner-field-market-badge {
    position: absolute;
    z-index: 1;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(10, 26, 28, 0.62);
    color: var(--owner-gold-hot);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .owner-field-market-badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #7FDBA4;
    box-shadow: 0 0 0 4px rgba(127, 219, 164, 0.18);
    animation: owner-field-pulse 1.6s ease-in-out infinite;
  }

  .owner-field-market-card p {
    max-width: 640px;
    margin: 0 0 32px;
    padding-left: 22px;
    border-left: 2px solid rgba(201, 169, 98, 0.58);
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.35;
  }

  .owner-field-market-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid rgba(45, 70, 71, 0.9);
    border-bottom: 1px solid rgba(45, 70, 71, 0.9);
  }

  .owner-field-market-facts div {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .owner-field-market-facts b {
    display: block;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 26px;
    font-weight: 400;
  }

  .owner-field-market-facts span {
    color: var(--stone-light);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .owner-field-market-guidance {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    min-height: 44px;
    color: var(--brand-dark);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--gold);
    padding-block: 8px;
  }

  .owner-field-economics {
    text-align: center;
  }

  .owner-field-mega {
    margin: 34px 0 0;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(96px, 14vw, 210px);
    font-style: italic;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .owner-field-mega span {
    color: var(--owner-ink);
  }

  .owner-field-mega-sub {
    margin-bottom: 48px;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 22px;
    font-style: italic;
  }

  .owner-field-economics > p {
    max-width: 880px;
    margin: 0 auto 56px;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.42;
  }

  .owner-field-econ-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 56px;
    border-top: 1px solid rgba(201, 169, 98, 0.42);
    text-align: left;
  }

  .owner-field-econ-grid strong {
    display: block;
    margin-bottom: 12px;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 40px;
    font-weight: 400;
  }

  .owner-field-econ-grid p {
    margin: 0;
    color: var(--stone-light);
    font-size: 14px;
    line-height: 1.7;
  }

  .owner-field-postcard {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    border: 1px solid rgba(201, 169, 98, 0.32);
    border-radius: 12px;
    background: var(--owner-paper);
    box-shadow: 0 40px 80px -30px rgba(45, 70, 71, 0.35), 0 1px 0 rgba(0, 0, 0, 0.04);
  }

  .owner-field-postcard-grain,
  .owner-field-postcard-inner,
  .owner-field-postcard-divider {
    position: absolute;
    pointer-events: none;
  }

  .owner-field-postcard-grain {
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    mix-blend-mode: multiply;
  }

  .owner-field-postcard-inner {
    inset: 14px;
    border: 1px dashed var(--gold);
    border-radius: 6px;
    opacity: 0.32;
  }

  .owner-field-postcard-divider {
    top: 36px;
    right: 36%;
    bottom: 36px;
    width: 1px;
    background: rgba(201, 169, 98, 0.25);
  }

  .owner-field-stamp {
    position: absolute;
    top: 28px;
    right: 36px;
    z-index: 2;
    width: 110px;
    height: 130px;
    padding: 10px;
    border-radius: 4px;
    background:
      radial-gradient(circle at 0 0, transparent 0 4px, rgba(245, 228, 176, 0.08) 4px) 0 0 / 12px 12px repeat;
    box-shadow: inset 0 0 0 1.5px var(--gold);
    transform: rotate(4deg);
  }

  .owner-field-stamp-inner {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 2px;
    background: linear-gradient(135deg, #2D4647, #1F3A3C);
    color: var(--owner-gold-hot);
  }

  .owner-field-stamp-label {
    margin-bottom: 4px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .owner-field-stamp-time {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 26px;
    font-style: italic;
    line-height: 1;
  }

  .owner-field-stamp-copy {
    margin-top: 4px;
    font-size: 7px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .owner-field-stamp-cancel,
  .owner-field-stamp-ring {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .owner-field-postcard[data-stamped="true"] .owner-field-stamp-cancel {
    opacity: 1;
    animation: owner-field-cancel-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
  }

  .owner-field-postcard[data-stamped="true"] .owner-field-stamp-ring {
    top: 4px;
    left: 4px;
    right: auto;
    bottom: auto;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--owner-gold-hot);
    border-radius: 50%;
    opacity: 0.6;
    animation: owner-field-cancel-in 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.4s both;
  }

  .owner-field-steps {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 60px;
    padding: 28px 48px 0;
  }

  .owner-field-step-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1.5px solid rgba(58, 58, 58, 0.16);
    border-radius: 50%;
    padding: 0;
    background: transparent;
    color: var(--stone-light);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 12px;
    font-style: italic;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .owner-field-step-dot.is-active,
  .owner-field-step-dot.is-complete {
    border-color: var(--gold);
    color: var(--gold);
  }

  .owner-field-step-dot.is-active {
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(201, 169, 98, 0.35);
  }

  .owner-field-step-dot.is-complete {
    background: var(--gold);
    color: var(--white);
  }

  .owner-field-step-line {
    width: 36px;
    height: 1px;
    background: rgba(58, 58, 58, 0.15);
    transition: background 0.4s ease;
  }

  .owner-field-step-line.is-complete {
    background: var(--gold);
  }

  .owner-field-step-meta {
    margin-left: auto;
    padding-right: 4px;
    color: var(--brand-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .owner-field-step-meta::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--gold);
  }

  .owner-field-form-step {
    display: none;
    padding: 32px 48px 48px;
  }

  .owner-field-form-step.is-active {
    display: block;
    animation: owner-field-step-in-fwd 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .owner-field-postcard[data-form-direction="back"] .owner-field-form-step.is-active {
    animation-name: owner-field-step-in-back;
  }

  .owner-field-form-step em {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--brand-dark);
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .owner-field-form-step em::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--gold);
  }

  .owner-field-form-step h3 {
    max-width: 680px;
    margin: 0 0 24px;
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.08;
  }

  .owner-field-form-step p {
    max-width: 680px;
    margin: 0 0 26px;
    color: var(--stone-light);
    font-size: 15px;
    line-height: 1.75;
  }

  .owner-field-input,
  .owner-field-textarea {
    display: block;
    width: 100%;
    max-width: 760px;
    border: 1px solid rgba(201, 169, 98, 0.26);
    border-radius: 0;
    background: rgba(250, 247, 238, 0.82);
    color: var(--owner-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 22px;
    line-height: 1.4;
    padding: 20px 24px;
  }

  .owner-field-input:focus-visible,
  .owner-field-textarea:focus-visible {
    border-color: var(--gold);
    background: var(--white);
  }

  .owner-field-file {
    display: grid;
    gap: 8px;
    max-width: 760px;
    margin-top: 18px;
    color: var(--owner-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .owner-field-file input {
    width: 100%;
    min-height: 48px;
    border: 1px dashed rgba(201, 169, 98, 0.5);
    background: rgba(250, 247, 238, 0.82);
    color: var(--owner-ink);
    font-size: 13px;
    letter-spacing: 0;
    padding: 13px 16px;
    text-transform: none;
  }

  .owner-field-file small {
    color: var(--stone-light);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .owner-field-form-note {
    display: grid;
    gap: 8px;
    max-width: 760px;
    margin-top: 22px;
    color: var(--owner-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .owner-field-form-note small {
    color: var(--stone-light);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .owner-field-input::placeholder,
  .owner-field-textarea::placeholder {
    font-style: italic;
    color: rgba(58, 58, 58, 0.48);
  }

  .owner-field-textarea {
    min-height: 132px;
    resize: vertical;
  }

  .owner-field-choice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 860px;
  }

  .owner-field-choice {
    position: relative;
    min-height: 54px;
    padding: 12px 16px;
    border: 1px solid rgba(95, 138, 139, 0.24);
    border-radius: 999px;
    background: rgba(252, 248, 232, 0.6);
    color: var(--owner-ink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .owner-field-choice:hover,
  .owner-field-choice:focus-visible {
    transform: translateY(-1px);
    border-color: var(--gold);
    box-shadow: 0 4px 12px rgba(201, 169, 98, 0.18);
  }

  .owner-field-choice.is-active {
    border-color: var(--gold);
    background: rgba(201, 169, 98, 0.16);
    box-shadow: inset 0 0 0 1px var(--gold);
  }

  .owner-field-choice.is-active::before {
    content: "";
    position: absolute;
    inset: -6px;
    border: 1.5px solid rgba(201, 169, 98, 0.4);
    border-radius: 40px;
    opacity: 0;
    animation: owner-field-chip-stamp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

