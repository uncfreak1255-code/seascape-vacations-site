<script>
  (function () {
    var page = document.querySelector("[data-owner-field-page]");
    if (!page) return;
    var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var conversionTracking = window.SeascapeConversionTracking;

    function track(eventName, payload) {
      if (!eventName) return;
      if (conversionTracking && typeof conversionTracking.trackEvent === "function") {
        conversionTracking.trackEvent(eventName, payload || {});
        return;
      }
      if (typeof window.seascapeTrackEvent === "function") {
        window.seascapeTrackEvent(eventName, payload || {});
        return;
      }
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, payload || {});
      }
    }

    var phraseRoot = page.querySelector("[data-owner-phrases]");
    if (phraseRoot) {
      var phrases = phraseRoot.querySelectorAll(".sv-pm-h1-phrase-item");
      var phraseIndex = 0;
      function showPhrase(nextIndex) {
        phraseIndex = nextIndex % phrases.length;
        phrases.forEach(function (phrase, index) {
          phrase.classList.toggle("is-active", index === phraseIndex);
        });
        phraseRoot.setAttribute("aria-label", phrases[phraseIndex].textContent || "");
      }
      if (!reduceMotion && phrases.length > 1) {
        window.setInterval(function () {
          showPhrase(phraseIndex + 1);
        }, 3200);
      }
    }

    var ticker = page.querySelector("[data-owner-ticker]");
    if (ticker) {
      var tickerItems = ticker.querySelectorAll(".sv-pm-ticker-fact");
      var tickerDots = ticker.querySelectorAll("[data-ticker-dot]");
      var tickerIndex = 0;
      function showTicker(nextIndex) {
        tickerIndex = nextIndex % tickerItems.length;
        tickerItems.forEach(function (item, index) {
          item.classList.toggle("is-active", index === tickerIndex);
        });
        tickerDots.forEach(function (dot, index) {
          dot.classList.toggle("is-active", index === tickerIndex);
        });
      }
      tickerDots.forEach(function (dot) {
        dot.addEventListener("click", function () {
          showTicker(Number(dot.getAttribute("data-ticker-dot")));
        });
      });
      if (!reduceMotion && tickerItems.length > 1) {
        window.setInterval(function () {
          showTicker(tickerIndex + 1);
        }, 3800);
      }
    }

    function loadDeferredBackground(node, dataAttribute, cssVariable, loadedClass) {
      if (!node || node.getAttribute("data-bg-loaded") === "true") return;
      var source = node.getAttribute(dataAttribute);
      if (!source) return;
      node.style.setProperty(cssVariable, "url('" + source + "')");
      node.classList.add(loadedClass);
      node.setAttribute("data-bg-loaded", "true");
    }

    function loadMarketButtonPreview(button) {
      var preview = button && button.querySelector(".owner-field-pin-preview");
      loadDeferredBackground(button, "data-preview", "--preview", "is-loaded");
      if (preview) preview.classList.add("is-loaded");
    }

    function loadMarketPanel(panel) {
      loadDeferredBackground(panel && panel.querySelector("[data-market-photo]"), "data-market-photo", "--market-photo", "is-loaded");
    }

    var lazyBackgrounds = page.querySelectorAll("[data-guide-photo], .owner-field-section--form");
    if ("IntersectionObserver" in window) {
      var backgroundObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var target = entry.target;
          if (target.hasAttribute("data-guide-photo")) {
            loadDeferredBackground(target, "data-guide-photo", "--guide-photo", "is-loaded");
          } else {
            target.classList.add("is-bg-loaded");
          }
          backgroundObserver.unobserve(target);
        });
      }, { rootMargin: "420px 0px" });
      lazyBackgrounds.forEach(function (node) { backgroundObserver.observe(node); });
    } else {
      lazyBackgrounds.forEach(function (node) {
        if (node.hasAttribute("data-guide-photo")) {
          loadDeferredBackground(node, "data-guide-photo", "--guide-photo", "is-loaded");
        } else {
          node.classList.add("is-bg-loaded");
        }
      });
    }

    page.querySelectorAll("[data-owner-market]").forEach(function (marketRoot) {
      var buttons = marketRoot.querySelectorAll("[data-market-button]");
      var panels = marketRoot.querySelectorAll("[data-market-panel]");
      var line = marketRoot.querySelector("[data-market-line]");

      function setMarketLine(button) {
        if (!line) return;
        var x = button.getAttribute("data-map-x");
        var y = button.getAttribute("data-map-y");
        if (!x || !y) return;
        line.setAttribute("x2", x);
        line.setAttribute("y2", y);
        line.classList.remove("is-animating");
        void line.getBoundingClientRect();
        line.classList.add("is-animating");
      }

      var activeButton = marketRoot.querySelector("[data-market-button].is-active");
      if (activeButton) setMarketLine(activeButton);

      function loadActiveMarket() {
        var activePanel = marketRoot.querySelector("[data-market-panel].is-active");
        if (activePanel) loadMarketPanel(activePanel);
      }

      if ("IntersectionObserver" in window) {
        var marketObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            loadActiveMarket();
            marketObserver.unobserve(marketRoot);
          });
        }, { rootMargin: "260px 0px" });
        marketObserver.observe(marketRoot);
      } else {
        loadActiveMarket();
      }

      buttons.forEach(function (button) {
        button.addEventListener("pointerenter", function () { loadMarketButtonPreview(button); });
        button.addEventListener("focus", function () { loadMarketButtonPreview(button); });
        button.addEventListener("click", function () {
          var id = button.getAttribute("data-market-button");
          loadMarketButtonPreview(button);
          setMarketLine(button);
          buttons.forEach(function (candidate) {
            var active = candidate === button;
            candidate.classList.toggle("is-active", active);
            candidate.setAttribute("aria-pressed", active ? "true" : "false");
          });
          panels.forEach(function (panel) {
            var active = panel.getAttribute("data-market-panel") === id;
            panel.classList.toggle("is-active", active);
            if (active) loadMarketPanel(panel);
          });
        });
      });
    });

    var countups = page.querySelectorAll("[data-countup-value]");
    if (countups.length) {
      function formatCountup(node, current) {
        var decimals = current % 1 === 0 ? 0 : 1;
        var value = current.toFixed(decimals);
        node.textContent = (node.getAttribute("data-countup-prefix") || "") + value + (node.getAttribute("data-countup-suffix") || "");
      }

      function runCountup(node) {
        if (node.getAttribute("data-countup-done") === "true") return;
        node.setAttribute("data-countup-done", "true");
        var target = Number(node.getAttribute("data-countup-value") || "0");
        if (reduceMotion || !target) {
          formatCountup(node, target);
          return;
        }
        var started = null;
        function tick(timestamp) {
          if (!started) started = timestamp;
          var progress = Math.min((timestamp - started) / 1400, 1);
          formatCountup(node, target * progress);
          if (progress < 1) window.requestAnimationFrame(tick);
        }
        window.requestAnimationFrame(tick);
      }

      if ("IntersectionObserver" in window) {
        var countupObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            runCountup(entry.target);
            countupObserver.unobserve(entry.target);
          });
        }, { threshold: 0.45 });
        countups.forEach(function (node) { countupObserver.observe(node); });
      } else {
        countups.forEach(runCountup);
      }
    }

    var form = page.querySelector(".owner-field-postcard");
    if (!form) return;
    var step = 0;
    var dots = form.querySelectorAll("[data-form-goto]");
    var lines = form.querySelectorAll(".owner-field-step-line");
    var steps = form.querySelectorAll("[data-form-step]");
    var meta = form.querySelector("[data-form-meta]");
    var concernsInput = form.querySelector("[data-owner-concerns]");
    var concernsMirror = form.querySelector("[data-owner-concerns-mirror]");
    var listingField = form.querySelector('input[name="property_address"]');
    var nameField = form.querySelector('input[name="name"]');
    var emailField = form.querySelector('input[name="email"]');
    var phoneField = form.querySelector('input[name="phone"]');
    var confirmUrl = form.querySelector("[data-confirm-url]");
    var confirmConcerns = form.querySelector("[data-confirm-concerns]");
    var confirmName = form.querySelector("[data-confirm-name]");
    var confirmEmail = form.querySelector("[data-confirm-email]");
    var confirmPhone = form.querySelector("[data-confirm-phone]");
    var concerns = [];
    var submitting = false;

    function syncConfirmPanel() {
      var concernSummary = concerns.length ? concerns.join(", ") : "";
      if (concernsMirror && concernsMirror.value.trim()) {
        concernSummary = concernSummary ? concernSummary + " | " + concernsMirror.value.trim() : concernsMirror.value.trim();
      }
      if (confirmUrl) confirmUrl.textContent = listingField && listingField.value.trim() ? listingField.value.trim() : "Not added yet";
      if (confirmConcerns) confirmConcerns.textContent = concernSummary || "Not added yet";
      if (confirmName) confirmName.textContent = nameField && nameField.value.trim() ? nameField.value.trim() : "Not added yet";
      if (confirmEmail) confirmEmail.textContent = emailField && emailField.value.trim() ? emailField.value.trim() : "Not added yet";
      if (confirmPhone) confirmPhone.textContent = phoneField && phoneField.value.trim() ? phoneField.value.trim() : "Optional";
    }

    function getFormPayload(extra) {
      return Object.assign({
        page_slug: form.dataset.pageSlug || "property-management",
        source_page_slug: form.dataset.sourcePageSlug || "property-management",
        market: form.dataset.market || "",
        step_number: step + 1
      }, extra || {});
    }

    function getSubmitPayload(extra) {
      var sourceContext = {};
      if (conversionTracking && typeof conversionTracking.getSourceContext === "function") {
        sourceContext = conversionTracking.getSourceContext();
      }
      return Object.assign(
        {},
        sourceContext,
        getFormPayload(Object.assign({
          placement: form.dataset.formPlacement || ""
        }, extra || {}))
      );
    }

    function currentPanelFieldsAreValid() {
      var panel = steps[step];
      if (!panel) return true;
      var requiredFields = panel.querySelectorAll("input[required], textarea[required]");
      for (var i = 0; i < requiredFields.length; i += 1) {
        if (!requiredFields[i].checkValidity()) {
          requiredFields[i].reportValidity();
          return false;
        }
      }
      return true;
    }

    function validateAllRequiredFields() {
      var requiredFields = form.querySelectorAll("input[required], textarea[required]");
      for (var i = 0; i < requiredFields.length; i += 1) {
        if (requiredFields[i].checkValidity()) continue;
        var invalidPanel = requiredFields[i].closest("[data-form-step]");
        var invalidStep = invalidPanel ? Number(invalidPanel.getAttribute("data-form-step")) : step;
        showStep(invalidStep, invalidStep < step ? "back" : "forward", { silent: true });
        requiredFields[i].reportValidity();
        return false;
      }
      return true;
    }

    function validateOwnerContext() {
      var hasListing = listingField && listingField.value.trim();
      var hasConcern = concerns.length > 0 || (concernsInput && concernsInput.value.trim()) || (concernsMirror && concernsMirror.value.trim());
      if (hasListing || hasConcern) return true;

      showStep(0, "back", { silent: true });
      if (listingField) {
        listingField.setCustomValidity("Send the listing or address, or choose what feels expensive or unclear.");
        listingField.reportValidity();
      }
      return false;
    }

    function showStep(nextStep, direction, options) {
      options = options || {};
      step = Math.max(0, Math.min(steps.length - 1, nextStep));
      form.setAttribute("data-form-direction", direction || "forward");
      steps.forEach(function (panel, index) {
        var active = index === step;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
      dots.forEach(function (dot, index) {
        dot.classList.toggle("is-active", index === step);
        dot.classList.toggle("is-complete", index < step);
        dot.textContent = index < step ? "✓" : String(index + 1);
      });
      lines.forEach(function (line, index) {
        line.classList.toggle("is-complete", index < step);
      });
      if (meta) {
        meta.textContent = step < steps.length ? "Question " + (step + 1) + " of 4" : "Postcard sent";
      }
      if (step === 3) syncConfirmPanel();
      if (!options.silent) {
        track("owner_form_step_view", getFormPayload({ viewed_step: step + 1 }));
        if (window.matchMedia && window.matchMedia("(max-width: 700px)").matches && steps[step]) {
          window.setTimeout(function () {
            steps[step].scrollIntoView({
              block: "start",
              behavior: reduceMotion ? "auto" : "smooth"
            });
          }, 40);
        }
      }
    }

    form.querySelectorAll("[data-form-next]").forEach(function (button) {
      button.addEventListener("click", function () {
        if (!currentPanelFieldsAreValid()) return;
        var nextStep = Math.min(step + 1, steps.length - 1);
        track("owner_form_step_continue", getFormPayload({ from_step: step + 1, to_step: nextStep + 1 }));
        showStep(nextStep, "forward");
      });
    });

    form.querySelectorAll("[data-form-back]").forEach(function (button) {
      button.addEventListener("click", function () {
        var nextStep = Math.max(step - 1, 0);
        track("owner_form_step_back", getFormPayload({ from_step: step + 1, to_step: nextStep + 1 }));
        showStep(nextStep, "back");
      });
    });

    dots.forEach(function (dot) {
      dot.addEventListener("click", function () {
        var targetStep = Number(dot.getAttribute("data-form-goto"));
        if (targetStep > step && !currentPanelFieldsAreValid()) return;
        showStep(targetStep, targetStep < step ? "back" : "forward");
      });
    });

    form.querySelectorAll("[data-concern]").forEach(function (button) {
      button.addEventListener("click", function () {
        var concern = button.getAttribute("data-concern");
        var index = concerns.indexOf(concern);
        if (index >= 0) concerns.splice(index, 1);
        else concerns.push(concern);
        button.classList.toggle("is-active", index < 0);
        concernsInput.value = concerns.join(", ");
        syncConfirmPanel();
        track("owner_form_concern_toggle", getFormPayload({
          concern: concern,
          selected: index < 0 ? "true" : "false"
        }));
      });
    });

    if (listingField) {
      listingField.addEventListener("input", function () {
        listingField.setCustomValidity("");
        syncConfirmPanel();
      });
    }
    if (concernsMirror) concernsMirror.addEventListener("input", syncConfirmPanel);
    if (nameField) nameField.addEventListener("input", syncConfirmPanel);
    if (emailField) emailField.addEventListener("input", syncConfirmPanel);
    if (phoneField) phoneField.addEventListener("input", syncConfirmPanel);

    form.addEventListener("submit", function (event) {
      if (submitting) return;
      event.preventDefault();
      if (!validateAllRequiredFields()) return;
      if (!validateOwnerContext()) return;
      submitting = true;
      syncConfirmPanel();
      form.setAttribute("data-stamped", "true");
      track("owner_form_submit", getSubmitPayload({
        concerns_count: String(concerns.length),
        concern_note_present: concernsMirror && concernsMirror.value.trim() ? "true" : "false",
        listing_present: listingField && listingField.value.trim() ? "true" : "false"
      }));
      window.setTimeout(function () {
        if (typeof HTMLFormElement !== "undefined" && HTMLFormElement.prototype.submit) {
          HTMLFormElement.prototype.submit.call(form);
          return;
        }
        form.submit();
      }, reduceMotion ? 1 : 720);
    });

    showStep(0, "forward", { silent: true });
    track("owner_form_step_view", getFormPayload({ viewed_step: 1 }));
  })();
</script>
