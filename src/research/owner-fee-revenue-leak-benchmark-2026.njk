  margin-top:18px;
  max-width:760px;
  font-size:13px !important;
  line-height:1.54;
  color:var(--gold-light) !important;
}
.cta-card{
  margin-top:20px;
  background:var(--white);
  border:1px solid #d9d6cb;
  border-radius:22px;
  padding:27px;
}
.cta-grid{
  display:grid;
  grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
  gap:24px;
  align-items:start;
}
.cta-copy{
  display:grid;
  gap:14px;
}
.cta-copy h3{
  font-size:28px;
  line-height:1.14;
  color:var(--brand-dark);
}
.cta-copy p{
  font-size:15px;
  color:#4a4a4a;
}
.cta-proof-note{
  font-size:13px !important;
  color:var(--brand) !important;
}
.cta-kicker{
  display:block;
  font-size:12px;
  line-height:1.2;
  letter-spacing:.16em;
  text-transform:uppercase;
  font-weight:700;
  color:var(--brand);
  margin-bottom:6px;
}
.cta-copy-small{
  font-size:14px !important;
  color:var(--stone) !important;
}
.cta-confirmation{
  background:var(--cream);
  border:1px solid #e5dcc3;
  border-radius:16px;
  padding:15px;
}
.cta-confirmation p{
  font-size:13px;
  color:var(--brand-dark);
}
.owner-lead-form{
  display:grid;
  gap:14px;
  text-align:left;
}
.owner-form-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
}
.owner-form-field{
  display:grid;
  gap:8px;
  font-size:14px;
  font-weight:600;
  color:var(--brand-dark);
}
.owner-form-field span{
  line-height:1.35;
}
.owner-form-field input,
.owner-form-field textarea{
  width:100%;
  min-height:52px;
  border-radius:14px;
  border:1px solid #d9d6cb;
  background:var(--cream-light);
  color:var(--stone);
  padding:14px 15px;
  font:400 14px/1.4 Poppins,-apple-system,sans-serif;
}
.owner-form-field textarea{
  min-height:72px;
  resize:vertical;
}
.owner-form-field input::placeholder,
.owner-form-field textarea::placeholder{
  color:#7a7a73;
}
.owner-form-field--wide{
  grid-column:1 / -1;
}
.owner-form-field--file input{
  padding:12px 15px;
}
.owner-form-help{
  font-size:12px;
  font-weight:400;
  color:var(--stone-light);
}
.owner-form-submit{
  justify-content:center;
  width:fit-content;
}
.owner-form-note{
  font-size:13px;
  color:var(--stone-light);
  margin:0;
}
.method-mobile{
  display:none;
}
.footer{
  text-align:center;
  color:var(--stone-light);
  font-size:14px;
  padding:0 24px 42px;
}
@media (max-width:980px){
  .hero,
  .cta-grid,
  .fit-grid{
    grid-template-columns:1fr;
  }
  .stack-grid,
  .example-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}
@media (max-width:720px){
  .desktop-only{display:none !important}
  .mobile-only{display:block !important}
  .guide-nav{padding:12px 16px}
  .page{padding:84px 16px 48px}
  .hero,
  .section,
  .cta-shell{padding:20px}
  .hero{
    grid-template-columns:1fr;
    gap:12px;
    border-radius:24px;
  }
  .hero h1{
    font-size:38px;
    line-height:1.05;
    max-width:8ch;
  }
  .hero-lead{
    font-size:15px;
    line-height:1.6;
  }
  .hero-decision-note{
    display:block;
  }
  .proof-rail,
  .scope-pill,
  .source-note,
  .compare-grid,
  .scenario-table-wrap{
    display:none;
  }
  .hero-mobile-scope{
    display:flex;
    margin-top:16px;
  }
  .hero-mobile-actions{
    display:grid;
    gap:10px;
    margin-top:10px;
  }
  .hero-mobile-actions .btn{
    width:100%;
  }
  .hero-mobile-actions .hero-secondary{
    width:max-content;
    color:var(--brand);
    border-color:rgba(95,138,139,.3);
  }
  .hero-mobile-actions .hero-secondary:hover{
    color:var(--brand-dark);
    border-color:rgba(61,92,93,.42);
  }
  .compare-mobile,
  .scenario-cards{
    display:grid;
    gap:12px;
  }
  .stack-grid{
    grid-template-columns:1fr;
  }
  .scenario-cards{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .example-grid{
    grid-template-columns:1fr;
  }
  .cta-shell > p{
    font-size:14px;
    line-height:1.6;
  }
  .cta-card{
    background:transparent;
    border:none;
    padding:0;
    margin-top:16px;
  }
  .cta-copy h3{
    font-size:24px;
    color:var(--white);
  }
  .cta-copy p{
    color:#f2f1ec;
  }
  .cta-proof-note{
    color:var(--gold-light) !important;
  }
  .cta-kicker{
    color:var(--gold-light);
  }
  .cta-copy-small{
    color:#f2f1ec !important;
  }
  .cta-confirmation{
    background:var(--cream-light);
    padding:16px;
  }
  .cta-confirmation p{
    color:var(--brand-dark);
  }
  .owner-form-grid{
    grid-template-columns:1fr;
  }
  .owner-form-submit{
    width:100%;
  }
  .method-mobile{
    display:block;
  }
}
</style>
</head>
<body>
<nav class="guide-nav">
  <a href="/research/">← Research</a>
  <span class="logo">Seascape Vacations</span>
</nav>

<main class="page">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Owner Fee + Revenue Leak Benchmark</span>
      <span class="scope-pill desktop-only">5-property Gulf Coast scope</span>
      <h1>Your management fee is not the whole revenue leak.</h1>
      <p class="hero-lead">Most owners compare 15%, 20%, and 25% management fees. That misses the bigger stack: OTA drag, direct-booking mix, pricing discipline, and how clearly your manager explains what is happening to owner net.</p>
      <p class="hero-support desktop-only">Built from Seascape's current 5-home Gulf Coast portfolio, with scenario math labeled separately from observed operating data.</p>
      <p class="hero-decision-note mobile-only">This benchmark is a decision aid, not a revenue forecast or market-wide fee survey.</p>
      <div class="hero-actions desktop-only">
        <a class="btn btn-gold" href="{{ teardownHref }}" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Teardown</a>
        <a class="hero-secondary" href="#benchmark-math">See the benchmark math</a>
      </div>
      <div class="proof-rail desktop-only">
        {% for label in proofLabels %}
        <span class="proof-chip">{{ label }}</span>
        {% endfor %}
      </div>
    </div>
    <div class="hero-side desktop-only">
      <div class="hero-stack-panel">
        <span class="eyebrow">Observed Seascape portfolio data</span>
        <h2 class="hero-stack-title">Fee stack quick read</h2>
        <p class="hero-stack-copy">Fee, channel drag, direct mix, and operating clarity all hit the same owner statement. This quick read shows why a lower-looking fee can still leave you behind.</p>
        <div class="hero-stack-list">
          <div class="hero-stack-row">
            <div class="hero-stack-copy-group">
              <span class="hero-stack-label">Management fee</span>
              <span class="hero-stack-detail">10-15% company-level range, not a blanket quote</span>
            </div>
            <div class="hero-stack-bar"><span style="width:58%;background:var(--gold)"></span></div>
            <span class="hero-stack-value">range</span>
          </div>
          <div class="hero-stack-row">
            <div class="hero-stack-copy-group">
              <span class="hero-stack-label">OTA drag</span>
              <span class="hero-stack-detail">13.4% observed Airbnb host-fee drag</span>
            </div>
            <div class="hero-stack-bar"><span style="width:78%;background:var(--white)"></span></div>
            <span class="hero-stack-value">13.4%</span>
          </div>
          <div class="hero-stack-row">
            <div class="hero-stack-copy-group">
              <span class="hero-stack-label">Direct payment cost</span>
              <span class="hero-stack-detail">2.9% direct processing reference</span>
            </div>
            <div class="hero-stack-bar"><span style="width:22%;background:var(--gold-light)"></span></div>
            <span class="hero-stack-value">2.9%</span>
          </div>
          <div class="hero-stack-row">
            <div class="hero-stack-copy-group">
              <span class="hero-stack-label">Channel mix</span>
              <span class="hero-stack-detail">Direct vs. OTA share changes what you keep</span>
            </div>
            <div class="hero-stack-bar"><span style="width:50%;background:#8db1b2"></span></div>
            <span class="hero-stack-value">audit</span>
          </div>
          <div class="hero-stack-row">
            <div class="hero-stack-copy-group">
              <span class="hero-stack-label">Operating clarity</span>
              <span class="hero-stack-detail">Pricing, reviews, maintenance, and reporting</span>
            </div>
            <div class="hero-stack-bar"><span style="width:62%;background:var(--gold)"></span></div>
            <span class="hero-stack-value">audit</span>
          </div>
        </div>
        <p class="hero-stack-note">Start here if you want the short version first, then use the sections below to check the math, the examples, and the fit boundary.</p>
      </div>
      <div class="method-rail">
        <span class="eyebrow method-rail-title">How To Read This</span>
        <ul class="method-list">
          {% for note in heroMethodNotes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <div class="hero-mobile-scope mobile-only">
    <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
  </div>
  <div class="hero-mobile-actions mobile-only">
    <a class="btn btn-gold" href="{{ teardownHref }}" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Teardown</a>
    <a class="hero-secondary" href="#benchmark-math">See the benchmark math</a>
  </div>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">The wrong comparison</span>
      <h2>A lower management fee can still leave owner net exposed.</h2>
      <p>The headline <a href="/property-management/vacation-rental-management-fees-florida/">management fee</a> matters, but it is not the whole economic picture. If most bookings arrive through high-drag channels, if direct mix is weak, if cleaning-heavy subtotals inflate OTA fees, or if rate decisions are not explained clearly, the owner can lose margin even when the management fee looks competitive.</p>
      <p><strong>The question is not only "What do they charge?" It is "What actually reaches my owner statement?"</strong></p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Where the leak shows up</span>
      <h2>Owner net gets hit in layers.</h2>
      <p>The management fee is only the first layer. OTA fees, direct payment cost, channel mix, pricing softness, and weak reporting can all change what you keep.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
      </div>
    </div>
    <div class="stack-grid">
      {% for layer in feeLayers %}
      <article class="stack-card">
        <span class="stack-metric">{{ layer.metric }}</span>
        <h3>{{ layer.title }}</h3>
        <p>{{ layer.copy }}</p>
      </article>
      {% endfor %}
    </div>
    <p class="mini-note">Airbnb fee drag can apply to the full booking subtotal, including cleaning. That is why cleaning-heavy bookings can carry a higher effective commission than you might expect.</p>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Channel drag</span>
      <h2>The channel can move owner net as much as the fee conversation.</h2>
      <p>In Seascape's five-home benchmark sample, observed Airbnb host-fee drag averages 13.4% on post-October 2025 Seascape bookings. Direct payment cost is 2.9%. That gap is why <a href="/property-management/maximize-vacation-rental-income-florida/">direct mix</a> belongs in the owner-net conversation.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
        <span class="proof-chip proof-chip--soft">Last refreshed: May 2026</span>
      </div>
    </div>
    <div class="compare-grid">
      <div class="compare-panel">
        <span class="eyebrow">Observed Seascape portfolio data</span>
        <h3>Airbnb Drag vs Direct Payment Cost</h3>
        <div class="bar-list">
          <div class="bar-row">
            <div class="bar-label">Airbnb host drag</div>
            <div class="bar-track"><span class="bar-fill" style="width:89%;background:var(--gold)"></span></div>
            <div class="bar-value">13.4%</div>
          </div>
          <div class="bar-row">
            <div class="bar-label">Direct payment cost</div>
            <div class="bar-track"><span class="bar-fill" style="width:19%;background:var(--brand-dark)"></span></div>
            <div class="bar-value">2.9%</div>
          </div>
          <div class="bar-row">
            <div class="bar-label">Gap to audit</div>
            <div class="bar-track"><span class="bar-fill" style="width:70%;background:rgba(95,138,139,.38)"></span></div>
            <div class="bar-value">10.5 pts</div>
          </div>
        </div>
        <p class="mini-note">Observed Seascape channel-cost references. Airbnb drag is an observed Seascape average; direct cost is a processing reference. This chart is not a market-wide fee survey.</p>
      </div>
      <div class="compare-panel">
        <span class="eyebrow">Where Owner Revenue Actually Leaks</span>
        <ul class="quick-list">
          <li>Airbnb takes its cut on the full subtotal, including cleaning-heavy stays.</li>
          <li>A booking can look fine on occupancy while still leaking margin through the channel mix.</li>
          <li>The owner-net question is not whether direct fixes everything. It is whether the current mix is more expensive than it needs to be.</li>
        </ul>
      </div>
    </div>
    <div class="compare-mobile mobile-only">
      <article class="compare-mobile-card">
        <h3>Airbnb booking</h3>
        <strong>13.4% observed host-fee drag</strong>
        <p>Observed Seascape average, not a universal Airbnb claim.</p>
      </article>
      <article class="compare-mobile-card">
        <h3>Direct booking</h3>
        <strong>2.9% direct payment cost</strong>
        <p>Direct processing reference, not a promise that every booking can move direct.</p>
      </article>
      <p class="mini-note">Observed Seascape channel-cost references. Airbnb drag is an observed Seascape average; direct cost is a processing reference. This chart is not a market-wide fee survey.</p>
    </div>
  </section>

  <section class="section" id="benchmark-math">
    <div class="section-intro">
      <span class="eyebrow">Sample leak math</span>
      <h2>The same management fee can produce different owner outcomes.</h2>
      <p>Use this as a simple way to read the leak stack. The point is not to forecast a specific home's revenue. The point is to show why management fee, channel drag, and direct mix should be evaluated together.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Scenario math, not a forecast</span>
      </div>
    </div>
    <div class="scenario-table-wrap">
      <table class="scenario-table">
        <thead>
          <tr>
            <th>Scenario</th>
            <th>What changes</th>
            <th>Owner-net implication</th>
          </tr>
        </thead>
        <tbody>
          {% for row in scenarioRows %}
          <tr>
            <td>{{ row.title }}</td>
            <td>{{ row.change }}</td>
            <td>{{ row.implication }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="scenario-cards mobile-only">
      {% for row in scenarioRows %}
      <article class="scenario-card">
        <h3>{{ row.title }}</h3>
        <p>{{ row.change }}</p>
        <p class="scenario-card-note">{{ row.implication }}</p>
      </article>
      {% endfor %}
    </div>
    <p class="mini-note">Scenario math showing how channel mix and fee drag can change owner net. It is not a forecast, guarantee, or property-specific quote.</p>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Observed Seascape examples</span>
      <h2>Three examples from the current benchmark inputs.</h2>
      <p>These examples are narrow on purpose. They show what Seascape has observed in its own operating data, not what every Gulf Coast home should expect.</p>
    </div>
    <div class="example-grid">
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Sarasota Luxe</h3>
        <span class="example-metric">32.8%</span>
        <p>In March 2026, Sarasota Luxe had 32.8% direct booking share and saved about <strong>$730</strong> versus Airbnb-like drag.</p>
        <div class="mini-note">Observed March 2026 property example. Not a promise for other homes.</div>
      </article>
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Patrick portfolio</h3>
        <span class="example-metric">5.7%</span>
        <p>In March 2026, the Patrick portfolio had 5.7% direct booking share. One direct booking saved about <strong>$450</strong> versus Airbnb.</p>
        <div class="mini-note">Observed March 2026 portfolio example. Direct mix was real, but still limited.</div>
      </article>
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Bradenton Pool Home</h3>
        <span class="example-metric">16.4%</span>
        <p>In March 2026, Bradenton Pool Home showed 16.4% effective commission because Airbnb took a cut of a cleaning-heavy subtotal.</p>
        <div class="mini-note">Observed leakage example showing why cleaning-heavy subtotals matter.</div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Fit</span>
      <h2>Best fit: premium Gulf Coast homes where owner net deserves close attention.</h2>
      <p><a href="/property-management/">Seascape property management</a> is built for owners who want revenue visibility, strong guest care, local operating attention, and plain-English owner communication. The best fit is a premium Gulf Coast home, especially in the $110k-$150k+ gross lane.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
      </div>
    </div>
    <div class="fit-grid">
      <div class="fit-card">
        <span class="eyebrow">Best Fit</span>
        <ul class="quick-list">
          {% for bullet in fitBullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="fit-card">
        <span class="eyebrow">Fit boundary</span>
        <p class="fit-boundary-copy">Homes projected below $110k gross may need a fee above 15% unless there is a strategic reason to approve the fit. Seascape's current fee structure is 10-15% at the company level, but this benchmark is not a blanket quote for every home.</p>
      </div>
    </div>
  </section>

  <section class="cta-shell">
    <span class="eyebrow">Private teardown</span>
    <h2>Want the same leak scan on your home?</h2>
    <p>Send the listing URL, owner statement, fee quote, or property address. Seascape will run a short Revenue Teardown that separates what is proven, what is likely leaking, and what is still unknown before any switch conversation.</p>
    <a class="btn btn-gold" href="{{ teardownHref }}" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Teardown</a>
    <p class="cta-route-note">This button opens the teardown intake. Missing statements, calendars, reviews, or fee terms stay marked unknown until Seascape can verify them.</p>
  </section>

  <section class="section method-mobile mobile-only">
    <div class="section-intro" style="margin-bottom:0">
      <span class="eyebrow">How To Read This Benchmark</span>
      <p>The benchmark uses Seascape's 5-home Gulf Coast operating data where observed, and labels scenario math separately. It is built to frame the owner-net conversation before a property-specific teardown.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
        <span class="proof-chip proof-chip--soft">Scenario math, not a forecast</span>
        <span class="proof-chip proof-chip--soft">Last refreshed: May 2026</span>
      </div>
    </div>
  </section>
</main>

<footer class="footer">© 2026 <a href="/">Seascape Vacations</a> · <a href="/property-management/">Property Management</a> · <a href="/property-management/vacation-rental-management-fees-florida/">Management Fees</a></footer>
</body>
</html>
