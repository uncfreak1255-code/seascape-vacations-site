  border:1px solid rgba(61,92,93,.12);
  border-radius:16px;
  padding:16px;
}
.scenario-card h3{
  font-family:Poppins,-apple-system,sans-serif;
  font-size:14px;
  font-weight:700;
  color:var(--brand-dark);
  margin-bottom:6px;
}
.scenario-card p{
  font-size:13px;
}
.scenario-card .scenario-card-note{
  color:var(--brand-dark);
}
.fit-grid{
  display:grid;
  grid-template-columns:minmax(0,.95fr) minmax(280px,1.05fr);
  gap:20px;
}
.fit-card{
  background:var(--cream-light);
  border:1px solid rgba(61,92,93,.12);
  border-radius:20px;
  padding:24px;
}
.cta-shell{
  margin-top:32px;
  background:linear-gradient(156deg,var(--brand-darker) 6%, var(--brand-dark) 94%);
  color:var(--white);
  border-radius:28px;
  padding:34px 30px;
  box-shadow:0 20px 42px rgba(45,70,71,.18);
}
.cta-shell .eyebrow{
  color:#8db1b2;
}
.cta-shell h2{
  color:var(--white);
  margin-top:10px;
}
.cta-shell > p{
  color:rgba(255,255,255,.88);
  max-width:760px;
  margin-top:12px;
}
.cta-card{
  margin-top:20px;
  background:var(--white);
  border:1px solid #d9d6cb;
  border-radius:22px;
  padding:27px;
}
.cta-grid{
  display:grid;
  grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
  gap:24px;
  align-items:start;
}
.cta-copy{
  display:grid;
  gap:14px;
}
.cta-copy h3{
  font-size:28px;
  line-height:1.14;
  color:var(--brand-dark);
}
.cta-copy p{
  font-size:15px;
  color:#4a4a4a;
}
.cta-proof-note{
  font-size:13px !important;
  color:var(--brand-dark) !important;
}
.cta-kicker{
  display:block;
  font-size:12px;
  line-height:1.2;
  letter-spacing:.16em;
  text-transform:uppercase;
  font-weight:700;
  color:var(--brand-dark);
  margin-bottom:6px;
}
.cta-copy-small{
  font-size:14px !important;
  color:var(--stone) !important;
}
.cta-action-row{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:14px;
  margin-top:24px;
}
.cta-action-row .hero-secondary{
  color:var(--gold-light);
}
.cta-action-row .hero-secondary:hover{
  color:var(--white);
}
.cta-proof-inline{
  max-width:760px;
  margin-top:18px;
  color:rgba(255,255,255,.8);
  font-size:13px;
  line-height:1.55;
}
.cta-confirmation{
  background:var(--cream);
  border:1px solid #e5dcc3;
  border-radius:16px;
  padding:15px;
}
.cta-confirmation p{
  font-size:13px;
  color:var(--brand-dark);
}
.owner-lead-form{
  display:grid;
  gap:14px;
  text-align:left;
}
.owner-form-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
}
.owner-form-field{
  display:grid;
  gap:8px;
  font-size:14px;
  font-weight:600;
  color:var(--brand-dark);
}
.owner-form-field span{
  line-height:1.35;
}
.owner-form-field input,
.owner-form-field textarea{
  width:100%;
  min-height:52px;
  border-radius:14px;
  border:1px solid #d9d6cb;
  background:var(--cream-light);
  color:var(--stone);
  padding:14px 15px;
  font:400 14px/1.4 Poppins,-apple-system,sans-serif;
}
.owner-form-field textarea{
  min-height:72px;
  resize:vertical;
}
.owner-form-field input::placeholder,
.owner-form-field textarea::placeholder{
  color:#7a7a73;
}
.owner-form-field--wide{
  grid-column:1 / -1;
}
.owner-form-field--file input{
  padding:12px 15px;
}
.owner-form-help{
  font-size:12px;
  font-weight:400;
  color:var(--stone-light);
}
.owner-form-submit{
  justify-content:center;
  width:fit-content;
}
.owner-form-note{
  font-size:13px;
  color:var(--stone-light);
  margin:0;
}
.method-mobile{
  display:none;
}
.footer{
  text-align:center;
  color:var(--stone-light);
  font-size:14px;
  padding:0 24px 42px;
}
@media (max-width:980px){
  .hero,
  .cta-grid,
  .fit-grid,
  .discipline-grid{
    grid-template-columns:1fr;
  }
  .stack-grid,
  .fee-layer-grid,
  .example-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}
@media (max-width:720px){
  .desktop-only{display:none !important}
  .mobile-only{display:block !important}
  .guide-nav{padding:12px 16px}
  .page{padding:84px 16px 48px}
  .hero,
  .section,
  .cta-shell{padding:20px}
  .hero{
    grid-template-columns:1fr;
    gap:12px;
    border-radius:24px;
  }
  .hero h1{
    font-size:38px;
    line-height:1.05;
    max-width:8ch;
  }
  .hero-lead{
    font-size:15px;
    line-height:1.6;
  }
  .hero-decision-note{
    display:block;
  }
  .proof-rail,
  .scope-pill,
  .source-note,
  .stack-grid,
  .compare-grid,
  .scenario-table-wrap{
    display:none;
  }
  .hero-mobile-scope{
    display:flex;
    margin-top:16px;
  }
  .hero-mobile-actions{
    display:grid;
    gap:10px;
    margin-top:10px;
  }
  .hero-mobile-actions .btn{
    width:100%;
  }
  .hero-mobile-actions .hero-secondary{
    width:max-content;
  }
  .compare-mobile,
  .scenario-cards{
    display:grid;
    gap:12px;
  }
  .discipline-metrics{
    grid-template-columns:1fr;
  }
  .scenario-cards{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .fee-layer-grid{
    display:grid;
    grid-template-columns:1fr;
  }
  .example-grid{
    grid-template-columns:1fr;
  }
  .cta-shell > p{
    font-size:14px;
    line-height:1.6;
  }
  .cta-card{
    background:transparent;
    border:none;
    padding:0;
    margin-top:16px;
  }
  .cta-copy h3{
    font-size:24px;
    color:var(--white);
  }
  .cta-copy p{
    color:#f2f1ec;
  }
  .cta-proof-note{
    color:var(--gold-light) !important;
  }
  .cta-kicker{
    color:var(--gold-light);
  }
  .cta-copy-small{
    color:#f2f1ec !important;
  }
  .cta-action-row{
    display:grid;
    gap:12px;
  }
  .cta-action-row .btn{
    width:100%;
  }
  .cta-action-row .hero-secondary{
    width:max-content;
  }
  .cta-confirmation{
    background:var(--cream-light);
    padding:16px;
  }
  .cta-confirmation p{
    color:var(--brand-dark);
  }
  .owner-form-grid{
    grid-template-columns:1fr;
  }
  .owner-form-submit{
    width:100%;
  }
  .method-mobile{
    display:block;
  }
}
</style>
</head>
<body>
<nav class="guide-nav">
  <a href="/research/">← Research</a>
  <span class="logo">Seascape Vacations</span>
</nav>

<main class="page">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Owner Fee + Net Payout Benchmark</span>
      <span class="scope-pill desktop-only">5-property Gulf Coast scope</span>
      <h1>Your management fee is not the whole payout story.</h1>
      <p class="hero-lead">Most owners compare 15%, 20%, and 25% management fees. That misses the bigger picture: booking-source costs, direct bookings, rate decisions, and how clearly your manager explains what is happening to the money you keep.</p>
      <p class="hero-support desktop-only">Built from Seascape's current 5-home Gulf Coast portfolio, with scenario math labeled separately from observed operating data.</p>
      <p class="hero-decision-note mobile-only">Built from Seascape's 5-home operating data, with scenario math labeled separately.</p>
      <div class="hero-actions desktop-only">
        <a class="btn btn-gold" href="#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Review</a>
        <a class="hero-secondary" href="#benchmark-math">See the benchmark math</a>
      </div>
      <div class="proof-rail desktop-only">
        {% for label in proofLabels %}
        <span class="proof-chip">{{ label }}</span>
        {% endfor %}
      </div>
    </div>
    <div class="hero-side desktop-only">
      <div class="side-panel hero-stack-visual">
        <span class="eyebrow">Observed Seascape portfolio data</span>
        <h2>Owner payout quick read</h2>
        <p>The benchmark opens with the full cost picture, not a stat wall. The owner sees the management fee, booking-source costs, direct bookings, and manager reporting as one decision problem.</p>
        <div class="hero-layer-list">
          {% for layer in feeLayers %}
          <div class="hero-layer">
            <div class="hero-layer-title">
              <strong>{{ layer.title }}</strong>
              <span>{{ layer.detail }}</span>
            </div>
            <div class="hero-layer-track"><span class="hero-layer-fill" style="width:{{ layer.width }}"></span></div>
            <span class="hero-layer-value">{{ layer.value }}</span>
          </div>
          {% endfor %}
        </div>
        <p class="hero-stack-caption">Compact visual only: no decorative stat-card wall. Scenario math and proof captions continue below the hero.</p>
      </div>
      <div class="side-panel">
        <span class="eyebrow">How To Read This</span>
        <ul class="method-list">
          {% for note in heroMethodNotes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <div class="hero-mobile-scope mobile-only">
    <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
  </div>

  <section class="source-note">
    <p><strong>Source note:</strong> {{ benchmark.sourceLabel }}. This benchmark is a practical reference built from Seascape's 5-home operating data. Scenario math is labeled separately from observed operating facts.</p>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">The wrong comparison</span>
      <h2>A lower management fee can still leave owner revenue exposed.</h2>
      <p>The headline <a href="/property-management/vacation-rental-management-fees-florida/">management fee</a> matters, but it is not the whole economic picture. If most bookings arrive through high-cost channels, if direct bookings are weak, if cleaning-heavy subtotals inflate OTA fees, or if rate decisions are not explained clearly, the owner can lose margin even when the management fee looks competitive. Owners usually pair this with a quick check of <a href="/property-management/vacation-rental-licensing-florida/">Florida licensing exposure</a> and <a href="/property-management/vrbo-management-services-florida/">VRBO channel costs</a> before comparing fee quotes.</p>
      <p><strong>The question is not only "What do they charge?" It is "What actually reaches my owner statement?"</strong></p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
      </div>
    </div>
    <div class="stack-grid">
      <article class="stack-card">
        <span class="stack-metric">Headline fee</span>
        <h3>Management fee</h3>
        <p>The fee still matters, but it is only one piece of what the owner keeps. A lower-looking manager can still underperform if the calendar, booking sources, or operations are weak.</p>
      </article>
      <article class="stack-card">
        <span class="stack-metric">Observed Seascape portfolio data</span>
        <h3>Airbnb booking cost</h3>
        <p>Airbnb's fee hits the full guest subtotal. In Seascape's observed post-October 2025 bookings, that averaged 13.4%.</p>
      </article>
      <article class="stack-card">
        <span class="stack-metric">Observed Seascape portfolio data</span>
        <h3>Direct payment cost</h3>
        <p>Direct processing at about 2.9% does not solve everything by itself. It does show how much owner margin can move when a booking is acquired without the heavier OTA layer.</p>
      </article>
      <article class="stack-card">
        <span class="stack-metric">Property-level review</span>
        <h3>Rate and operations discipline</h3>
        <p>Discount-heavy fills, weak premium-week protection, turnover misses, and poor owner communication rarely show up cleanly in a flat management-fee comparison. They still hit the same payout.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Where payout gets thin</span>
      <h2>Owner revenue gets hit in layers.</h2>
      <p>Management fee is only one layer. The same owner statement can also carry booking-source costs, weak direct bookings, unclear rate decisions, and operating misses that make a lower fee less helpful than it sounds.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
      </div>
    </div>
    <div class="fee-layer-grid">
      {% for layer in feeLayers %}
      <article class="fee-layer-card">
        <h3>{{ layer.title }}</h3>
        <p>{{ layer.detail }}</p>
      </article>
      {% endfor %}
    </div>
    <p class="mini-note">Source note: Airbnb fees apply to the full subtotal, including cleaning-heavy stays. That is why booking-source cost belongs in the same owner review as the management fee.</p>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Booking-channel cost</span>
      <h2>The booking source can move owner revenue as much as the fee conversation.</h2>
      <p>In Seascape's benchmark inputs, observed Airbnb host-fee cost averages 13.4% on post-Oct 2025 Seascape bookings. Direct payment cost is 2.9%. That gap is why <a href="/property-management/maximize-vacation-rental-income-florida/">booking sources</a> belong in the owner revenue conversation.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Observed Seascape portfolio data</span>
        <span class="proof-chip proof-chip--soft">Last refreshed: May 2026</span>
      </div>
    </div>
    <div class="compare-grid">
      <div class="compare-panel">
        <span class="eyebrow">Observed Seascape portfolio data</span>
        <h3>Airbnb cost vs direct payment cost</h3>
        <div class="bar-list">
          <div class="bar-row">
            <div class="bar-label">Airbnb host fee</div>
            <div class="bar-track"><span class="bar-fill" style="width:89%;background:var(--gold)"></span></div>
            <div class="bar-value">13.4%</div>
          </div>
          <div class="bar-row">
            <div class="bar-label">Direct payment cost</div>
            <div class="bar-track"><span class="bar-fill" style="width:19%;background:var(--brand-dark)"></span></div>
            <div class="bar-value">2.9%</div>
          </div>
          <div class="bar-row">
            <div class="bar-label">Gap to audit</div>
            <div class="bar-track"><span class="bar-fill" style="width:70%;background:rgba(95,138,139,.38)"></span></div>
            <div class="bar-value">10.5 pts</div>
          </div>
        </div>
        <p class="mini-note">Source note: Airbnb cost is an observed Seascape average; direct cost is a processing reference. This chart is not a market-wide fee survey.</p>
      </div>
      <div class="compare-panel">
        <span class="eyebrow">Where owner payout gets thin</span>
        <ul class="quick-list">
          <li>Airbnb takes its cut on the full subtotal, including cleaning-heavy stays.</li>
          <li>A booking can look fine on occupancy while still losing margin through the booking source.</li>
          <li>Direct booking will not solve everything, but it does show when the current mix is costing more than it should.</li>
        </ul>
      </div>
    </div>
    <div class="compare-mobile mobile-only">
      <article class="compare-mobile-card">
        <h3>Airbnb booking</h3>
        <strong>13.4% observed host-fee cost</strong>
        <p>Observed Seascape average, not a universal Airbnb claim.</p>
      </article>
      <article class="compare-mobile-card">
        <h3>Direct booking</h3>
        <strong>2.9% direct payment cost</strong>
        <p>Direct processing reference, not a promise that every booking can move direct.</p>
      </article>
      <p class="mini-note">Source note: Airbnb cost is an observed Seascape average; direct cost is a processing reference. This chart is not a market-wide fee survey.</p>
    </div>
  </section>

  <section class="section" id="benchmark-math">
    <div class="section-intro">
      <span class="eyebrow">Sample owner payout math</span>
      <h2>The same management fee can lead to different outcomes.</h2>
      <p>Use this as a simple way to read the full cost picture. The point is not to forecast a specific home's revenue. The point is to show why management fee, booking-channel cost, and direct bookings should be evaluated together.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">Scenario math, not a forecast</span>
      </div>
    </div>
    <div class="scenario-table-wrap">
      <table class="scenario-table">
        <thead>
          <tr>
            <th>Scenario</th>
            <th>What changes</th>
            <th>Owner-net implication</th>
          </tr>
        </thead>
        <tbody>
          {% for row in scenarioRows %}
          <tr>
            <td>{{ row.title }}</td>
            <td>{{ row.change }}</td>
            <td>{{ row.implication }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="scenario-cards mobile-only">
      {% for row in scenarioRows %}
      <article class="scenario-card">
        <h3>{{ row.title }}</h3>
        <p>{{ row.change }}</p>
        <p class="scenario-card-note">{{ row.implication }}</p>
      </article>
      {% endfor %}
    </div>
    <p class="mini-note">Scenario note: This shows how booking sources and total costs can change what the owner keeps. It is not a forecast, guarantee, or property-specific quote.</p>
  </section>

  <div class="hero-mobile-actions mobile-only">
    <a class="btn btn-gold" href="#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Review</a>
  </div>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Observed Seascape examples</span>
      <h2>Three examples from the current benchmark inputs.</h2>
      <p>These examples are narrow on purpose. They show what Seascape has observed in its own operating data, not what every Gulf Coast home should expect.</p>
    </div>
    <div class="example-grid">
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Sarasota Luxe</h3>
        <span class="example-metric">32.8%</span>
        <p>In March 2026, Sarasota Luxe had 32.8% direct booking share and saved about <strong>$730</strong> versus Airbnb-like fees.</p>
        <div class="mini-note">Observed March 2026 property example. Not a promise for other homes.</div>
      </article>
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Patrick portfolio</h3>
        <span class="example-metric">5.7%</span>
        <p>In March 2026, the Patrick portfolio had 5.7% direct booking share. One direct booking saved about <strong>$450</strong> versus Airbnb.</p>
        <div class="mini-note">Observed March 2026 portfolio example. Direct bookings were real, but still limited.</div>
      </article>
      <article class="example-card">
        <span class="eyebrow">Observed property example</span>
        <h3>Bradenton Pool Home</h3>
        <span class="example-metric">16.4%</span>
        <p>In March 2026, Bradenton Pool Home showed 16.4% effective commission because Airbnb took a cut of a cleaning-heavy subtotal.</p>
        <div class="mini-note">Source note: Cleaning-heavy stays can raise Airbnb cost because the fee applies to the full subtotal.</div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <span class="eyebrow">Fit</span>
      <h2>Best fit: premium Gulf Coast homes where owner revenue deserves close attention.</h2>
      <p><a href="/property-management/">Seascape property management</a> is built for owners who want revenue visibility, strong guest care, local operating attention, and plain-English owner communication. The best fit is a premium Gulf Coast home, especially in the $110k-$150k+ gross lane. For market-specific context, compare the <a href="/property-management/vacation-rental-management-anna-maria-island/">AMI</a>, <a href="/property-management/vacation-rental-management-bradenton/">Bradenton</a>, and <a href="/property-management/vacation-rental-management-sarasota/">Sarasota</a> management pages before you request a revenue review. If you are still evaluating acquisition fit, start with <a href="/property-management/buy-vacation-rental-property-florida/">buying a Florida vacation rental property</a>.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
      </div>
    </div>
    <div class="fit-grid">
      <div class="fit-card">
        <span class="eyebrow">Best Fit</span>
        <ul class="quick-list">
          <li>Premium Gulf Coast homes projected around $110k-$150k+ gross.</li>
          <li>Airbnb-heavy homes where booking-source costs may be taking more than the fee quote suggests.</li>
          <li>Owners who want clearer reporting on revenue, booking channels, reviews, and maintenance follow-through.</li>
          <li>Homes where rate decisions and guest standards matter more than raw activity reports.</li>
        </ul>
      </div>
      <div class="fit-card">
        <span class="eyebrow">Fit boundary</span>
        <ul class="quick-list">
          <li>Homes projected below $110k gross may need a fee above 15% unless there is a strategic reason to approve the fit.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta-shell" id="owner-cta">
    <span class="eyebrow">Private revenue review</span>
    <h2>Want this same scan on your home?</h2>
    <p>Send the listing URL, owner statement, fee quote, or property address. Seascape will send back a short revenue review that shows where the payout gets thin, which costs deserve a second look, and what still needs to be confirmed before you switch.</p>
    <div class="cta-action-row">
      <a class="btn btn-gold" href="/property-management/#owner-cta" data-track-event="owner_primary_cta_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Request Your Revenue Review</a>
      <a class="hero-secondary" href="tel:+19417048545" data-track-event="owner_phone_click" data-page-slug="owner-fee-revenue-leak-benchmark-2026">Call (941) 704-8545</a>
    </div>
    <p class="cta-proof-inline">Source note: No embedded form here. If statements, calendars, reviews, or fee terms are missing, the review will mark that clearly instead of guessing.</p>
  </section>

  <section class="section method-mobile mobile-only">
    <div class="section-intro" style="margin-bottom:0">
      <span class="eyebrow">How To Read This Benchmark</span>
      <p>The benchmark uses Seascape's 5-home Gulf Coast operating data where observed, and labels scenario math separately. It is built to help you ask better questions before a property-specific revenue review.</p>
      <div class="section-proof-rail">
        <span class="proof-chip proof-chip--soft">5-property Gulf Coast scope</span>
        <span class="proof-chip proof-chip--soft">Scenario math, not a forecast</span>
        <span class="proof-chip proof-chip--soft">Last refreshed: May 2026</span>
      </div>
    </div>
