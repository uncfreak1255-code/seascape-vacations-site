.shell{margin:0 auto;max-width:1160px;padding:96px 24px 64px}
.hero{background:linear-gradient(148deg,var(--brand-darker) 6%,var(--brand-dark) 54%,#476d6f 94%);border-radius:28px;box-shadow:0 20px 42px rgba(45,70,71,.18);color:white;display:grid;gap:28px;grid-template-columns:minmax(0,1.15fr) minmax(340px,.85fr);margin-bottom:28px;padding:32px}
.eyebrow{color:var(--gold-light);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.scope-chip,.proof-chip{align-items:center;border-radius:999px;display:inline-flex;font-size:12px;font-weight:700;letter-spacing:.08em;line-height:1.2;padding:9px 13px;text-transform:uppercase}
.scope-chip{background:rgba(201,169,98,.18);color:var(--gold-light);margin:14px 0 22px}
.hero h1{font-size:clamp(38px,6vw,62px);max-width:690px}
.hero-copy{color:rgba(255,255,255,.92);font-size:19px;line-height:1.65;margin-top:22px;max-width:700px}
.hero-note{color:rgba(255,255,255,.74);font-size:14px;margin-top:18px;max-width:660px}
.proof-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.proof-chip{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:var(--cream-light);letter-spacing:0;text-transform:none}
.hero-panel{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:22px;padding:24px}
.hero-panel h2{color:var(--gold-light);font-family:Poppins,sans-serif;font-size:12px;font-weight:700;letter-spacing:.18em;margin-bottom:18px;text-transform:uppercase}
.stat-grid{display:grid;gap:14px;grid-template-columns:repeat(2,minmax(0,1fr))}
.stat-card{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:18px}
.stat-value{color:var(--gold-light);display:block;font-family:'Playfair Display',Georgia,serif;font-size:32px;font-weight:700;line-height:1.05;margin-bottom:8px}
.stat-label{color:var(--gold-light);display:block;font-size:11px;font-weight:700;letter-spacing:.14em;line-height:1.25;text-transform:uppercase}
.stat-card p{color:rgba(255,255,255,.82);font-size:13px;line-height:1.55;margin-top:10px}
.source-note{background:var(--cream-light);border:1px solid rgba(61,92,93,.12);border-radius:20px;color:var(--stone-light);font-size:14px;margin:0 0 30px;padding:22px 24px}
.source-note strong{color:var(--stone)}
.scan-section{margin:0 0 34px}
.scan-head{align-items:end;display:flex;gap:18px;justify-content:space-between;margin:0 0 16px}
.scan-head h2{color:var(--brand-dark);font-size:clamp(28px,4vw,38px)}
.scan-head p{color:var(--stone-light);font-size:14px;max-width:430px}
.scan-grid{display:grid;gap:14px;grid-template-columns:repeat(4,minmax(0,1fr))}
.scan-card{background:var(--white);border:1px solid rgba(61,92,93,.1);border-radius:20px;box-shadow:0 10px 26px rgba(61,92,93,.05);color:var(--stone);display:flex;flex-direction:column;gap:12px;min-height:224px;padding:18px;text-decoration:none}
.scan-card:hover{border-color:rgba(61,92,93,.28);box-shadow:0 12px 30px rgba(61,92,93,.1);text-decoration:none;transform:translateY(-1px)}
.scan-badge{align-self:flex-start;background:var(--cream-light);border:1px solid var(--cream-dark);border-radius:999px;color:var(--brand-dark);font-size:11px;font-weight:700;letter-spacing:.08em;line-height:1.2;padding:7px 10px;text-transform:uppercase}
.scan-metric{color:var(--brand-darker);display:block;font-family:'Playfair Display',Georgia,serif;font-size:40px;font-weight:700;line-height:1}
.scan-card h3{color:var(--brand-dark);font-family:Poppins,sans-serif;font-size:15px;font-weight:700;line-height:1.25}
.scan-card p{color:var(--stone-light);font-size:13px;line-height:1.5}
.scan-link{color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.1em;margin-top:auto;text-transform:uppercase}
.chart-card{background:var(--white);border:1px solid rgba(61,92,93,.08);border-radius:24px;box-shadow:0 12px 30px rgba(61,92,93,.06);margin:24px 0;padding:30px}
.chart-card header{max-width:780px}
.chart-card h2{color:var(--brand-dark);font-size:clamp(30px,4vw,40px);margin:12px 0 10px}
.chart-card .summary{color:var(--stone);font-size:16px;margin-bottom:22px;max-width:790px}
.chart-media{background:var(--cream-light);border:1px solid rgba(61,92,93,.12);border-radius:20px;margin:22px 0;overflow:hidden;padding:16px}
.chart-media img{background:var(--cream-light);display:block;height:auto;width:100%}
.chart-detail{display:grid;gap:18px;grid-template-columns:minmax(0,1fr) minmax(280px,.75fr)}
.source-box,.embed-box{background:var(--cream-light);border:1px solid rgba(61,92,93,.12);border-radius:18px;padding:20px}
.source-box h3,.embed-box h3{color:var(--brand);font-family:Poppins,sans-serif;font-size:12px;font-weight:700;letter-spacing:.18em;margin-bottom:10px;text-transform:uppercase}
.source-box p,.embed-box p{color:var(--stone-light);font-size:14px;margin-bottom:10px}
.embed-code{background:white;border:1px solid rgba(61,92,93,.12);border-radius:12px;color:var(--stone);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.5;overflow-wrap:anywhere;padding:12px}
.citation-panel{background:linear-gradient(166deg,var(--brand-darker) 6%,var(--brand-dark) 94%);border-radius:28px;box-shadow:0 20px 42px rgba(45,70,71,.18);color:white;margin-top:28px;padding:34px}
.citation-panel h2{font-size:clamp(28px,4vw,38px);margin-bottom:14px}
.citation-panel p{color:rgba(255,255,255,.88);margin-bottom:12px;max-width:820px}
.citation-panel a{color:var(--gold-light);font-weight:600}
.footer{color:var(--stone-light);font-size:14px;padding:0 24px 44px;text-align:center}
@media(max-width:860px){
  .chart-nav{padding:14px 16px}.logo{font-size:18px}.shell{padding:84px 16px 46px}.hero{grid-template-columns:1fr;padding:24px}.hero-panel{padding:20px}.scan-head{align-items:start;flex-direction:column}.scan-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.chart-card{padding:22px}.chart-detail{grid-template-columns:1fr}.stat-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:540px){
  .chart-nav{align-items:flex-start;flex-direction:column;gap:4px}.hero h1{font-size:38px}.hero-copy{font-size:17px}.stat-grid,.scan-grid{grid-template-columns:1fr}.scan-card{min-height:0}.proof-chip{width:100%}.chart-media{margin-left:-6px;margin-right:-6px;padding:8px}.source-note,.scan-card,.chart-card,.citation-panel{border-radius:18px}.embed-code{font-size:11px}
}
