<h1 class="title">2026 Gulf Coast Vacation Rental Chart Pack</h1>
<p class="intro">Static, embeddable visuals built from Seascape's published research pages. Use them with attribution; do not treat them as market-wide claims beyond the stated dataset and source boundaries.</p>

{% set charts = [
  {
    "title": "Airbnb channel dependence",
    "src": "/images/research/airbnb-channel-dependence-2026.svg",
    "alt": "Airbnb accounts for 87 percent of analyzed Gulf Coast vacation rental bookings.",
    "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026."
  },
  {
    "title": "74-day booking window",
    "src": "/images/research/booking-window-74-days-2026.svg",
    "alt": "Average booking lead time is 74 days and median booking lead time is 62 days.",
    "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026."
  },
  {
    "title": "Seasonal ADR spread",
    "src": "/images/research/seasonal-adr-spread-2026.svg",
    "alt": "Average nightly rates are 686 dollars in spring, 680 dollars in winter, 623 dollars in summer, and 499 dollars in fall.",
    "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026."
  },
  {
    "title": "Bradenton vs Sarasota vs AMI trip cost",
    "src": "/images/research/bradenton-sarasota-ami-trip-cost-2026.svg",
    "alt": "Average lodging rates used in the cost index are 248 dollars in Bradenton, 340 dollars in Sarasota, and 783 dollars on Anna Maria Island.",
    "source": "Source: Seascape Vacations 2026 Gulf Coast vacation cost index."
  }
] %}

{% for chart in charts %}
<section class="chart-card">
  <img src="{{ chart.src }}" alt="{{ chart.alt }}" loading="lazy">
  <h2>{{ chart.title }}</h2>
  <p>{{ chart.source }}</p>
  <div class="embed">&lt;img src="https://seascape-vacations.com{{ chart.src }}" alt="{{ chart.alt }}"&gt;</div>
</section>
{% endfor %}

