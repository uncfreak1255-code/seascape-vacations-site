<body>
<nav class="chart-nav"><a href="/research/">&#8592; Research</a><span class="logo">Seascape Vacations</span></nav>
<main class="shell">
  <section class="hero">
    <div>
      <p class="eyebrow">Gulf Coast Vacation Rental Chart Pack</p>
      <span class="scope-chip">Static 2026 research visuals</span>
      <h1>Four charts for the booking and trip-cost questions people actually ask.</h1>
      <p class="hero-copy">This chart pack gives you clean visuals for Airbnb channel dependence, the 74-day booking window, seasonal ADR spread, and the Bradenton vs Sarasota vs Anna Maria Island cost gap.</p>
      <p class="hero-note">The charts are intentionally narrow. The booking visuals come from Seascape's 545 confirmed-booking research set. The trip-cost visual comes from the separate 2026 Gulf Coast vacation cost index.</p>
      <div class="proof-row" aria-label="Source labels">
        <span class="proof-chip">545 confirmed bookings</span>
        <span class="proof-chip">June 2022-March 2026</span>
        <span class="proof-chip">Cost index, March 2026</span>
        <span class="proof-chip">Static SVG charts</span>
      </div>
    </div>
    <aside class="hero-panel" aria-label="How to read this chart pack">
      <h2>How To Read This</h2>
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-value">87%</span>
          <span class="stat-label">Airbnb share</span>
          <p>Observed share of confirmed bookings from Airbnb in the booking-trends dataset.</p>
        </div>
        <div class="stat-card">
          <span class="stat-value">74</span>
          <span class="stat-label">Days</span>
          <p>Average booking lead time, with a 62-day median in the same dataset.</p>
        </div>
        <div class="stat-card">
          <span class="stat-value">$686</span>
          <span class="stat-label">Spring ADR</span>
          <p>Peak seasonal average nightly rate in the booking-trends report.</p>
        </div>
        <div class="stat-card">
          <span class="stat-value">$783</span>
          <span class="stat-label">AMI lodging</span>
          <p>Average nightly lodging input used in the cost-index comparison.</p>
        </div>
      </div>
    </aside>
  </section>

  <section class="source-note" aria-label="Source limits">
    <p><strong>Source note:</strong> The first three charts cite the <a href="/research/gulf-coast-vacation-booking-trends-2026/">Gulf Coast booking trends report</a>. The trip-cost chart cites the <a href="/research/real-cost-florida-beach-vacation-bradenton-sarasota-ami-2026/">Bradenton vs Sarasota vs AMI cost index</a>. Do not treat these visuals as a market-wide fee survey, a forecast, or a quote for a specific stay.</p>
  </section>

  {% set charts = [
    {
      "title": "Airbnb channel dependence",
      "kicker": "Channel mix",
      "src": "/images/research/airbnb-channel-dependence-2026.svg",
      "alt": "Airbnb accounts for 87 percent of analyzed Gulf Coast vacation rental bookings, followed by VRBO and HomeAway at 9.2 percent, direct bookings at 2.8 percent, Booking.com at 1.1 percent, and Google at 0.2 percent.",
      "summary": "Nearly nine out of ten confirmed bookings in the Seascape research set came from Airbnb. That makes the channel-mix story easy to cite, but it should stay tied to this portfolio dataset.",
      "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026.",
      "limit": "Use this as an observed channel-mix chart for the Seascape booking-trends set, not as a claim about every Gulf Coast rental operator.",
      "metric": "87%",
      "badge": "545 bookings"
    },
    {
      "title": "74-day booking window",
      "kicker": "Booking timing",
      "src": "/images/research/booking-window-74-days-2026.svg",
      "alt": "Average booking lead time is 74 days and median booking lead time is 62 days in the analyzed Gulf Coast booking set.",
      "summary": "The average guest booked 74 days before arrival, while the median sat at 62 days. That makes the practical planning answer simple: start looking about two to three months out.",
      "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026.",
      "limit": "Use this for planning-window context. Peak weeks and large homes can still require earlier booking than the average.",
      "metric": "74 days",
      "badge": "Booking timing"
    },
    {
      "title": "Seasonal ADR spread",
      "kicker": "Seasonality",
      "src": "/images/research/seasonal-adr-spread-2026.svg",
      "alt": "Average nightly rates are 686 dollars in spring, 680 dollars in winter, 623 dollars in summer, and 499 dollars in fall.",
      "summary": "Spring and winter sit almost even at the top of the rate curve, while fall drops 27 percent below the spring peak. This is the cleanest visual for flexible travelers.",
      "source": "Source: 545 confirmed Gulf Coast bookings from Seascape Vacations, June 2022-March 2026.",
      "limit": "Use this as seasonal ADR context from collected booking data, not a guarantee that a specific home or date will price this way.",
      "metric": "$686",
      "badge": "Seasonal ADR"
    },
    {
      "title": "Bradenton vs Sarasota vs AMI trip cost",
      "kicker": "Trip cost",
      "src": "/images/research/bradenton-sarasota-ami-trip-cost-2026.svg",
      "alt": "Average lodging rates used in the cost index are 248 dollars in Bradenton, 340 dollars in Sarasota, and 783 dollars on Anna Maria Island.",
      "summary": "The cost gap is mostly lodging. Bradenton is the lower-cost base, Sarasota lands in the middle, and Anna Maria Island carries the island-scarcity premium.",
      "source": "Source: Seascape Vacations 2026 Gulf Coast vacation cost index.",
      "limit": "Use this as a planning comparison for the cost-index inputs, not as a live quote or full-market lodging average.",
      "metric": "$783",
      "badge": "Cost index"
    }
  ] %}

  <section class="scan-section" aria-labelledby="quick-scan-title">
    <div class="scan-head">
      <h2 id="quick-scan-title">Find the right chart fast.</h2>
      <p>Airbnb's useful lesson here is scan speed: one visible metric, one source label, and a clear next click. These cards use Seascape source language instead of platform-style badges.</p>
    </div>
    <div class="scan-grid">
      {% for chart in charts %}
      <a class="scan-card" href="#{{ chart.title | slug }}">
        <span class="scan-badge">{{ chart.badge }}</span>
        <span class="scan-metric">{{ chart.metric }}</span>
        <h3>{{ chart.title }}</h3>
        <p>{{ chart.kicker }} chart with the source limits visible below the graphic.</p>
        <span class="scan-link">View chart</span>
      </a>
      {% endfor %}
    </div>
  </section>

  {% for chart in charts %}
  <section class="chart-card" id="{{ chart.title | slug }}">
    <header>
      <p class="eyebrow">{{ chart.kicker }}</p>
      <h2>{{ chart.title }}</h2>
      <p class="summary">{{ chart.summary }}</p>
    </header>
    <div class="chart-media">
      <img src="{{ chart.src }}" alt="{{ chart.alt }}">
    </div>
    <div class="chart-detail">
      <div class="source-box">
        <h3>Source Note</h3>
        <p>{{ chart.source }}</p>
        <p>{{ chart.limit }}</p>
      </div>
      <div class="embed-box">
        <h3>Embed Image</h3>
        <p>Use the hosted SVG with the chart title and source line intact.</p>
        <div class="embed-code">&lt;img src="https://seascape-vacations.com{{ chart.src }}" alt="{{ chart.alt }}"&gt;</div>
      </div>
    </div>
  </section>
  {% endfor %}

  <section class="citation-panel">
    <p class="eyebrow">Citation Guidance</p>
    <h2>Cite the chart and the source page together.</h2>
    <p>Recommended attribution: "Chart by Seascape Vacations, based on its 2026 Gulf Coast vacation rental research."</p>
    <p>For booking-channel, booking-window, or seasonal-rate charts, link to the <a href="/research/gulf-coast-vacation-booking-trends-2026/">booking trends report</a>. For Bradenton, Sarasota, and Anna Maria Island cost comparisons, link to the <a href="/research/real-cost-florida-beach-vacation-bradenton-sarasota-ami-2026/">cost index</a>.</p>
  </section>
</main>
<footer class="footer">© 2026 <a href="/">Seascape Vacations</a> · <a href="/research/gulf-coast-vacation-booking-trends-2026/">Booking Trends</a> · <a href="/research/real-cost-florida-beach-vacation-bradenton-sarasota-ami-2026/">Cost Index</a></footer>
</body>
</html>
