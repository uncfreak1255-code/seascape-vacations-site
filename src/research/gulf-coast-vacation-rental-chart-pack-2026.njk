<style>
:root{--brand:#5F8A8B;--brand-light:#7BA3A4;--brand-dark:#3D5C5D;--brand-darker:#2D4647;--gold:#C9A962;--gold-light:#E8D5A3;--cream:#F5EED6;--cream-dark:#EBE4CC;--cream-light:#FAF7EE;--stone:#3A3A3A;--stone-light:#595959;--white:#FFFFFF}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--cream);color:var(--stone);font-family:Poppins,sans-serif;line-height:1.7}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:500;letter-spacing:-.02em;line-height:1.12}
a{color:var(--brand);text-decoration:none}
a:hover{color:var(--brand-dark);text-decoration:underline}
.chart-nav{align-items:center;background:rgba(255,255,255,.95);border-bottom:1px solid rgba(61,92,93,.08);display:flex;inset:0 0 auto 0;justify-content:space-between;padding:16px 24px;position:fixed;z-index:20}
.chart-nav a{font-weight:600}
