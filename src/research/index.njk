:root{--brand:#5F8A8B;--brand-light:#7BA3A4;--brand-dark:#3D5C5D;--gold:#C9A962;--cream:#F5EED6;--cream-dark:#EBE4CC;--stone:#3A3A3A;--stone-light:#595959;--white:#FFFFFF}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Poppins,sans-serif;background:var(--cream);color:var(--stone);line-height:1.7}
.guide-container{max-width:800px;margin:0 auto;padding:64px 24px 60px}
