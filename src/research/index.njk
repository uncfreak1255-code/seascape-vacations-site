.report-card h2{font-family:'Playfair Display',serif;font-size:20px;color:var(--brand-dark);margin-bottom:8px}
.report-card .meta{font-size:14px;color:var(--stone-light);margin-bottom:8px}
.report-card .summary{font-size:15px;color:var(--stone);line-height:1.6}
.media-contact{margin-top:48px;padding:32px;background:var(--cream-dark);border-radius:16px;font-size:15px;color:var(--stone)}
.media-contact strong{display:block;margin-bottom:8px;font-size:16px;color:var(--brand-dark)}
.media-contact a{color:var(--brand)}
.guide-footer{text-align:center;padding:40px 24px;color:var(--stone-light);font-size:14px}
.guide-footer a{color:var(--brand);text-decoration:none}
@media(max-width:768px){.guide-container{padding:32px 16px 40px}.report-card{padding:20px 24px}}
