<script>
(function(){
  const areas = {
    bradenton: { label: "Bradenton", nightly: 248 },
    sarasota: { label: "Sarasota", nightly: 340 },
    ami: { label: "Anna Maria Island", nightly: 783 }
  };
  const styles = {
    budget: { label: "Budget", food: 530, activities: 100, transport: 280, defaultPoolHeat: false },
    mid: { label: "Mid-range", food: 825, activities: 275, transport: 315, defaultPoolHeat: true },
    comfortable: { label: "Comfortable", food: 1250, activities: 750, transport: 715, defaultPoolHeat: true }
  };
  const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
  const ids = ["area","style","nights","nightsNumber","guests","guestsNumber","poolHeat","marketplaceFee"];
  const el = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
  const out = {
    total: document.getElementById("totalEstimate"),
    sub: document.getElementById("totalSub"),
    lodging: document.getElementById("lodgingCost"),
    food: document.getElementById("foodCost"),
    activity: document.getElementById("activityCost"),
    transport: document.getElementById("transportCost"),
    fee: document.getElementById("feeNote")
  };
  let userChangedPool = false;

  function boundedNumber(input, min, max) {
    const value = Number(input.value);
    if (!Number.isFinite(value)) return min;
    return Math.min(max, Math.max(min, Math.round(value)));
  }

  function syncNumber(source, target, min, max) {
    const value = boundedNumber(source, min, max);
    source.value = value;
    target.value = value;
    return value;
  }

  function update() {
    const area = areas[el.area.value];
    const profile = styles[el.style.value];
    const nights = boundedNumber(el.nights, 3, 14);
    const guests = boundedNumber(el.guests, 2, 16);
    const nightScale = nights / 5;
    const guestScale = guests / 6;
    const lodging = area.nightly * nights;
    const food = profile.food * nightScale * guestScale;
    const activities = profile.activities * nightScale * guestScale;
    const poolHeat = el.poolHeat.checked ? 40 * nights : 0;
    const transport = (profile.transport * nightScale) + poolHeat;
    const total = lodging + food + activities + transport;
    const feeLow = lodging * 0.10;
    const feeHigh = lodging * 0.15;

    out.total.textContent = money.format(total);
    out.sub.textContent = `${nights} nights for ${guests} guests in ${area.label} · ${profile.label} style`;
    out.lodging.textContent = money.format(lodging);
    out.food.textContent = money.format(food);
    out.activity.textContent = money.format(activities);
    out.transport.textContent = money.format(transport);
    out.fee.textContent = el.marketplaceFee.checked
      ? `If this lodging is booked through a marketplace, guest service fees can add roughly ${money.format(feeLow)}-${money.format(feeHigh)} on top of the listed lodging amount. Direct booking may avoid that guest-fee layer when available.`
      : "Marketplace-fee view is off. The total above excludes guest service-fee exposure, cleaning fees, and taxes.";
  }

  el.nights.addEventListener("input", () => { syncNumber(el.nights, el.nightsNumber, 3, 14); update(); });
  el.nightsNumber.addEventListener("input", () => { syncNumber(el.nightsNumber, el.nights, 3, 14); update(); });
  el.guests.addEventListener("input", () => { syncNumber(el.guests, el.guestsNumber, 2, 16); update(); });
  el.guestsNumber.addEventListener("input", () => { syncNumber(el.guestsNumber, el.guests, 2, 16); update(); });
  el.poolHeat.addEventListener("change", () => { userChangedPool = true; update(); });
  el.marketplaceFee.addEventListener("change", update);
  el.area.addEventListener("change", update);
  el.style.addEventListener("change", () => {
    if (!userChangedPool) el.poolHeat.checked = styles[el.style.value].defaultPoolHeat;
    update();
  });
  el.poolHeat.checked = styles[el.style.value].defaultPoolHeat;
  update();
})();
</script>
