---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% set excludedUrls = [
    '/guides/anna-maria-island-vacation-cost-guide-2026/',
    '/guides/best-time-to-visit-anna-maria-island/',
    '/guides/bradenton-vs-sarasota-vacation-rental-comparison/'
  ] %}
  {% for entry in collections.all %}
  {% set url = entry.url %}
  {% set entryIndexable = entry.data.seoIndexable %}
  {% set shouldIndex = entryIndexable != false and entryIndexable != 'false' %}
  {% if url and url != '/404.html' and url != '/sitemap.xml' and url not in excludedUrls and shouldIndex %}
  <url>
    <loc>{{ site.url }}{{ url }}</loc>
    <lastmod>{{ site.dateUpdated }}</lastmod>
    <changefreq>{% if url == '/' or '/guides/' in url or '/properties/' in url %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if url == '/' %}1.0{% elif '/guides/' in url or '/properties/' in url %}0.8{% else %}0.7{% endif %}</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
