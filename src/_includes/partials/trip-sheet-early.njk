{# Reserve the homepage search row before first paint. If the sheet cannot start, restore the inline trip form. #}
<script>(function(){var root=document.documentElement;if(!window.matchMedia||!matchMedia('(max-width:700px)').matches||!window.HTMLDialogElement||!HTMLDialogElement.prototype.showModal)return;root.classList.add('ts-sheet-on');addEventListener('load',function(){var pill=document.querySelector('.ts-home-search .ts-pill');if(!pill||pill.hidden)root.classList.remove('ts-sheet-on')})})();</script>
