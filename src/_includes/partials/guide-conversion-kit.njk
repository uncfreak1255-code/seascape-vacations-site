{% macro guideConversionKit(config = {}) %}
{% set primaryCtaHref = config.primaryCtaHref or (config.stays[0].href if config.stays and config.stays[0] else '/properties/') %}
<style>
  .guide-conversion-shell,
  .guide-save50-module {
    --kit-paper: #F6F3EB;
    --kit-ink: #173D42;
    --kit-muted: #52676A;
    --kit-clay: #A4533E;
    --kit-rule: #CAD4CF;
  }

  .guide-conversion-shell {
    margin: 40px auto 48px;
    padding: 0;
    border-top: 1px solid var(--kit-ink);
    background: var(--kit-paper);
    color: var(--kit-ink);
    font: 400 15px/1.65 Poppins, system-ui, sans-serif;
  }

  .guide-conversion-shell *,
  .guide-save50-module * {
    box-sizing: border-box;
  }

  .guide-conversion-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .guide-conversion-main {
    padding: 40px 48px 40px 0;
  }

  .guide-email-capture {
    padding: 40px 0 40px 48px;
    border-left: 1px solid var(--kit-rule);
  }

  .guide-conversion-shell .guide-conversion-label {
    display: block;
    margin: 0 0 16px;
    color: var(--kit-muted);
    font: 500 12px/1.4 Poppins, system-ui, sans-serif;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .guide-conversion-shell .guide-conversion-title {
    margin: 0 0 16px;
    color: var(--kit-ink);
    font: 400 56px/1.08 "Instrument Serif", Georgia, serif;
    letter-spacing: -0.025em;
  }

  .guide-conversion-shell h3.guide-conversion-title {
    font-size: 30px;
    line-height: 1.15;
  }

  .guide-conversion-shell .guide-conversion-copy,
  .guide-conversion-shell .guide-email-capture-copy,
  .guide-conversion-shell .guide-email-capture-note {
    margin: 0 0 16px;
    color: var(--kit-muted);
    line-height: 1.65;
  }

  .guide-conversion-shell .guide-email-capture-note {
    margin: 16px 0 0;
    font-size: 13px;
  }

  .guide-savings-bullets {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-savings-bullets li {
    padding: 16px 0;
    border-top: 1px solid var(--kit-rule);
    color: var(--kit-muted);
  }

  .guide-savings-bullets strong {
    display: block;
    margin-bottom: 4px;
    color: var(--kit-ink);
    font-weight: 500;
  }

  .guide-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin: 28px 0 0;
  }

  .guide-conversion-shell a.guide-cta-btn,
  .guide-save50-module a.guide-save50-cta,
  .guide-email-capture-form button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    border: 0;
    border-radius: 4px;
    background: var(--kit-ink);
    background-image: none;
    box-shadow: none;
    color: var(--kit-paper);
    font: 500 14px/1.35 Poppins, system-ui, sans-serif;
    text-decoration: none;
    cursor: pointer;
  }

  .guide-conversion-shell a.guide-cta-btn:hover,
  .guide-save50-module a.guide-save50-cta:hover,
  .guide-email-capture-form button:hover {
    background: var(--kit-ink);
    color: var(--kit-paper);
    text-decoration: none;
  }

  .guide-conversion-shell a.guide-cta-btn--ghost,
  .guide-save50-module a.guide-save50-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    color: var(--kit-ink);
    font: 500 14px/1.35 Poppins, system-ui, sans-serif;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .guide-conversion-shell a.guide-cta-btn--ghost::after {
    content: "\2192" / "";
    text-decoration: none;
    display: inline-block;
  }

  .guide-conversion-shell a.guide-cta-btn--ghost:hover,
  .guide-save50-module a.guide-save50-secondary:hover {
    color: var(--kit-ink);
    text-decoration-thickness: 2px;
  }

  .guide-conversion-shell a:focus-visible,
  .guide-conversion-shell button:focus-visible,
  .guide-conversion-shell input:focus-visible,
  .guide-save50-module a:focus-visible,
  .guide-save50-module button:focus-visible {
    outline: 3px solid var(--kit-clay);
    outline-offset: 3px;
  }

  .guide-stay-module,
  .guide-repeat-stay-links {
    margin-top: 40px;
  }

  .guide-stay-grid,
  .guide-repeat-grid {
    display: block;
    border-bottom: 1px solid var(--kit-rule);
  }

  .guide-conversion-shell a.guide-stay-card,
  .guide-conversion-shell a.guide-repeat-link {
    position: relative;
    display: block;
    min-height: 56px;
    margin: 0;
    padding: 16px 40px 16px 0;
    border: 0;
    border-top: 1px solid var(--kit-rule);
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--kit-muted);
    text-decoration: none;
    transform: none;
  }

  .guide-conversion-shell a.guide-stay-card::after,
  .guide-conversion-shell a.guide-repeat-link::after {
    content: "\2192" / "";
    position: absolute;
    top: 16px;
    right: 0;
    color: var(--kit-clay);
    font-size: 18px;
    line-height: 1.5;
  }

  .guide-conversion-shell a.guide-stay-card:hover,
  .guide-conversion-shell a.guide-repeat-link:hover {
    color: var(--kit-muted);
  }

  .guide-conversion-shell a.guide-stay-card:hover strong,
  .guide-conversion-shell a.guide-repeat-link:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .guide-stay-card strong,
  .guide-repeat-link strong {
    display: block;
    margin: 0;
    color: var(--kit-ink);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .guide-email-capture-form {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }

  .guide-email-capture-field {
    display: grid;
    gap: 6px;
  }

  .guide-email-capture-field > span {
    color: var(--kit-ink);
    font: 500 13px/1.4 Poppins, system-ui, sans-serif;
  }

  .guide-email-capture-form input[type="text"],
  .guide-email-capture-form input[type="email"] {
    display: block;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid var(--kit-ink);
    border-radius: 4px;
    background: #FFFFFF;
    box-shadow: none;
    color: var(--kit-ink);
    font: 400 15px/1.4 Poppins, system-ui, sans-serif;
  }

  .guide-email-capture-form button {
    width: 100%;
  }

  .guide-email-capture-success,
  .guide-email-capture-pending,
  .guide-email-capture-error {
    display: none;
    margin-top: 24px;
    padding: 16px 20px;
    border: 1px solid var(--kit-ink);
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--kit-ink);
  }

  .guide-email-capture-success.is-visible,
  .guide-email-capture-pending.is-visible,
  .guide-email-capture-error.is-visible {
    display: block;
  }

  .guide-email-capture [hidden],
  .guide-save50-sticky[hidden] {
    display: none !important;
  }

  .guide-save50-module {
    position: relative;
    margin: 0 0 32px;
    color: var(--kit-ink);
    font: 400 15px/1.65 Poppins, system-ui, sans-serif;
    padding: 24px;
    border: 1px solid var(--kit-ink);
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .guide-save50-top {
    margin-bottom: 12px;
  }

  .guide-save50-dot {
    display: none;
  }

  .guide-save50-label {
    color: var(--kit-muted);
    font: 500 12px/1.4 Poppins, system-ui, sans-serif;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .guide-save50-module .guide-save50-value {
    margin: 0 0 20px;
    color: var(--kit-ink);
    font: 400 30px/1.15 "Instrument Serif", Georgia, serif;
    letter-spacing: -0.025em;
  }

  .guide-save50-value em {
    padding-right: 0.08em;
    color: var(--kit-ink);
    font-style: italic;
  }

  .guide-save50-chip {
    display: flex;
    align-items: stretch;
    margin-bottom: 16px;
    border: 1px solid var(--kit-ink);
    border-radius: 4px;
    background: #FFFFFF;
  }

  .guide-save50-code {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: 10px 16px;
  }

  .guide-save50-code dt {
    margin: 0;
    color: var(--kit-muted);
    font-size: 11px;
    letter-spacing: .13em;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.3;
  }

  .guide-save50-code dd {
    margin: 0;
  }

  .guide-save50-code b {
    color: var(--kit-ink);
    font-family: ui-monospace, Menlo, monospace;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.25;
  }

  .guide-save50-module .guide-save50-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 48px;
    min-height: 48px;
    margin: 4px;
    padding: 0 16px;
    border: 1px solid var(--kit-ink);
    border-radius: 4px;
    background: none;
    color: var(--kit-ink);
    font: 500 12px/1 Poppins, system-ui, sans-serif;
    letter-spacing: .13em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .guide-save50-module .guide-save50-copy.is-copied {
    background: var(--kit-ink);
    color: var(--kit-paper);
  }

  .guide-save50-copy svg {
    width: 14px;
    height: 14px;
  }

  .guide-save50-eligibility {
    margin: 0 0 20px;
    color: var(--kit-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .guide-save50-eligibility b {
    color: var(--kit-ink);
    font-weight: 500;
  }

  .guide-save50-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }

  .guide-save50-module a.guide-save50-cta {
    width: 100%;
  }

  .guide-save50-module a.guide-save50-secondary {
    align-self: flex-start;
    margin-top: 12px;
  }

  .guide-save50-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Sticky mobile bar: ink band with the citron button DESIGN.md allows on sticky CTA bars. */
  .guide-save50-sticky {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 16px calc(11px + env(safe-area-inset-bottom));
    background: #173D42;
    color: #F6F3EB;
    text-decoration: none;
  }

  .guide-save50-sticky.is-visible {
    display: flex;
  }

  .guide-save50-sticky-code {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .guide-save50-sticky-code small {
    color: #CAD4CF;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .guide-save50-sticky-code b {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 14px;
    letter-spacing: .1em;
  }

  .guide-save50-sticky-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 4px;
    background: #D6EB85;
    color: #173D42;
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .guide-conversion-grid {
      grid-template-columns: 1fr;
    }

    .guide-conversion-main {
      padding: 32px 0;
    }

    .guide-email-capture {
      padding: 32px 0;
      border-top: 1px solid var(--kit-rule);
      border-left: 0;
    }

    .guide-conversion-shell .guide-conversion-title {
      font-size: 40px;
    }

    .guide-conversion-shell h3.guide-conversion-title {
      font-size: 30px;
    }
  }

  @media (min-width: 1024px) {
    .guide-save50-module {
      position: sticky;
      top: 96px;
    }

    .guide-save50-sticky {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .guide-save50-module {
      margin: 24px 0;
    }
  }
</style>

<section class="guide-conversion-shell" data-guide-conversion data-guide-slug="{{ config.guideSlug }}">
  <div class="guide-conversion-grid">
    <div class="guide-conversion-main">
      <div class="guide-book-direct-savings">
        <p class="guide-conversion-label">{{ config.label or "Book Direct Math" }}</p>
        <h2 class="guide-conversion-title">{{ config.title or "Use this guide to save money, not just read about it" }}</h2>
        <p class="guide-conversion-copy">{{ config.copy or "Direct booking only matters if it changes your trip economics. The links below go straight to the homes this guide points to, with no platform service fees on the final price." }}</p>
        {% if config.savingsBullets and config.savingsBullets | length %}
        <ul class="guide-savings-bullets">
          {% for bullet in config.savingsBullets %}
          <li>
            <strong>{{ bullet.title }}</strong>
            <span>{{ bullet.copy }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>

      <div class="guide-cta-row" data-save50-state="cold">
        <a
          class="guide-cta-btn"
          href="{{ primaryCtaHref }}"
          data-track-event="guide_book_direct_click"
          data-guide-slug="{{ config.guideSlug }}"
          data-track-label="{{ config.primaryCtaLabel or 'Browse direct homes' }}"
        >{{ config.primaryCtaLabel or "Browse Direct Homes" }}</a>
        <a
          class="guide-cta-btn--ghost"
          href="{{ config.bookingEngineHref or '/properties/' }}"
          {% if config.bookingEngineHref %}
          target="_blank"
          rel="noopener"
          data-track-event="booking_engine_handoff"
          {% else %}
          data-track-event="guide_book_direct_click"
          data-placement="guide_kit_secondary"
          {% endif %}
          data-guide-slug="{{ config.guideSlug }}"
          data-track-label="{{ config.bookingEngineLabel or 'Check direct availability' }}"
        >{{ config.bookingEngineLabel or "Check Direct Availability" }}</a>
      </div>

      <div class="guide-stay-module">
        <p class="guide-conversion-label">{{ config.staysLabel or "Relevant Stays" }}</p>
        <div class="guide-stay-grid">
          {% for stay in config.stays or [] %}
          <a
            class="guide-stay-card"
            href="{{ stay.href }}"
            data-track-event="guide_stay_click"
            data-guide-slug="{{ config.guideSlug }}"
            data-track-label="{{ stay.title }}"
          >
            <strong>{{ stay.title }}</strong>
            <span>{{ stay.copy }}</span>
          </a>
          {% endfor %}
        </div>
      </div>

      <div class="guide-repeat-stay-links">
        <p class="guide-conversion-label">{{ config.repeatLabel or "Plan The Stay" }}</p>
        <div class="guide-repeat-grid">
          {% for link in config.repeatLinks or [] %}
          <a class="guide-repeat-link" href="{{ link.href }}">
            <strong>{{ link.title }}</strong>
            <span>{{ link.copy }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="guide-email-capture">
      <aside class="guide-save50-module save-module" data-save50-state="warm" aria-label="Your saved offer" hidden>
        <div class="guide-save50-top">
          <span class="guide-save50-dot" aria-hidden="true"></span>
          <span class="guide-save50-label">Welcome back &middot; code saved</span>
        </div>

        <p class="guide-save50-value">Your <em>$50 off</em> is waiting on this trip</p>

        <div class="guide-save50-chip save-chip">
          <dl class="guide-save50-code">
            <dt>Your code</dt>
            <dd><b>SAVE50</b></dd>
          </dl>
          <button type="button" class="guide-save50-copy save-copy" aria-label="Copy code SAVE50 to clipboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span class="guide-save50-copy-label save-copy-label">Copy</span>
          </button>
        </div>

        <p class="guide-save50-eligibility">Applies to your <b>first direct booking</b> of <b>3 nights or more</b>. Added at checkout.</p>

        <div class="guide-save50-cta-wrap">
          <a
            class="guide-save50-cta save-cta"
            href="{{ primaryCtaHref }}"
            data-track-event="guide_book_direct_click"
            data-guide-slug="{{ config.guideSlug }}"
            data-track-label="{{ config.primaryCtaLabel or 'Browse direct homes' }}"
          >{{ config.primaryCtaLabel or "Browse Direct Homes" }} <span class="arr" aria-hidden="true">→</span></a>
          <a
            class="guide-save50-secondary"
            href="{{ config.bookingEngineHref or '/properties/' }}"
            {% if config.bookingEngineHref %}
            target="_blank"
            rel="noopener"
            data-track-event="booking_engine_handoff"
            {% else %}
            data-track-event="guide_book_direct_click"
            data-placement="guide_kit_secondary"
            {% endif %}
            data-guide-slug="{{ config.guideSlug }}"
            data-track-label="{{ config.bookingEngineLabel or 'Open Direct Availability' }}"
          >{{ config.bookingEngineLabel or "Open Direct Availability" }} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </aside>

      <div data-email-capture-content data-save50-state="cold">
      <p class="guide-conversion-label">{{ config.emailLabel or "Direct Booking List" }}</p>
      <h3 class="guide-conversion-title">{{ config.emailTitle or "Get practical direct-booking tips for your Gulf Coast stay" }}</h3>
      <p class="guide-email-capture-copy">{{ config.emailCopy or "Join the list for direct-booking savings, shoulder-season ideas, and Seascape stay options without platform service fees setting the final price." }}</p>

      <form
        class="guide-email-capture-form"
        data-email-capture-form
        data-inline-email-capture="true"
        data-track-form="email_capture"
        data-form-submit-event="email_capture_submit"
        data-guide-slug="{{ config.guideSlug }}"
        data-form-placement="inline"
        data-utility-moment="{{ config.utilityMoment or 'guide_direct_booking_help' }}"
        data-utility-source-label="{{ config.utilitySourceLabel or 'guide_conversion_direct_booking_list' }}"
        data-requested-value="{{ config.requestedValue or 'direct_booking_savings_and_local_stay_ideas' }}"
        data-guest-intent="{{ config.guestIntent or 'planning_gulf_coast_stay' }}"
        data-delivery-channel="{{ config.deliveryChannel or 'email' }}"
        data-consent-basis="{{ config.consentBasis or 'guest_requested_email_followup' }}"
      >
        <input type="hidden" name="guide_slug" value="{{ config.guideSlug }}">
        <input type="text" name="trip_url" value="" tabindex="-1" autocomplete="off" aria-hidden="true" data-guest-capture-honeypot style="position:absolute;left:-9999px;width:0;height:0;padding:0;border:0;margin:0;opacity:0;overflow:hidden;">
        <label class="guide-email-capture-field"><span>First name</span><input type="text" name="name" placeholder="First name" aria-label="First name" autocomplete="name" required></label>
        <label class="guide-email-capture-field"><span>Email address</span><input type="email" name="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required></label>
        <button type="submit">{{ config.emailButtonLabel or "Join The Direct-Booking List" }}</button>
      </form>
      <p class="guide-email-capture-note">{{ config.emailNote or "No spam. Just direct-booking savings and useful Gulf Coast stay ideas." }}</p>
      <p class="guide-email-capture-error" data-email-capture-error role="alert" hidden>We could not finish saving your email. Please try again in a moment.</p>
      </div>
      <div class="guide-email-capture-pending" data-email-capture-pending hidden>
        We're still confirming your signup. Keep browsing, and try again in a few minutes if this stays pending.
      </div>
      <div class="guide-email-capture-success" data-email-capture-success data-save50-state="cold">
        You're on the list. In the meantime, the stay links in this box show which homes fit your trip.
      </div>
    </div>
  </div>
  <a class="guide-save50-sticky save-sticky" data-save50-state="warm" href="{{ primaryCtaHref }}" data-track-event="guide_book_direct_click" data-guide-slug="{{ config.guideSlug }}" data-track-label="{{ config.primaryCtaLabel or 'Browse direct homes' }} (sticky)" hidden>
    <span class="guide-save50-sticky-code"><small>Code saved</small><b>SAVE50</b></span>
    <span class="guide-save50-sticky-btn">Browse Homes</span>
  </a>
  <span id="save50-live-{{ config.guideSlug }}" class="guide-save50-sr-only" aria-live="polite"></span>
</section>
<script>
(function () {
  function showGuestSocialProofSave50() {
    if (typeof URLSearchParams !== "function" || !window.location) return;

    var params = new URLSearchParams(window.location.search || "");
    var campaign = (params.get("utm_campaign") || "").trim().toLowerCase();

    var shell = document.querySelector('[data-guide-conversion][data-guide-slug="{{ config.guideSlug }}"]');
    if (!shell) return;

    var show = campaign === "guest_social_proof" ? "warm" : "cold";
    shell.querySelectorAll("[data-save50-state]").forEach(function (el) {
      if (el.getAttribute("data-save50-state") === show) {
        el.removeAttribute("hidden");
      } else {
        el.setAttribute("hidden", "");
      }
    });

    if (campaign !== "guest_social_proof") return;

    var module = shell.querySelector(".guide-save50-module");
    var copyButton = shell.querySelector(".guide-save50-copy");
    var copyLabel = shell.querySelector(".guide-save50-copy-label");
    var live = shell.querySelector("[aria-live]");
    var resetTimer;

    if (module && window.matchMedia && window.matchMedia("(max-width: 640px)").matches) {
      var guideIntro = document.querySelector(".guide-intro");
      if (guideIntro && guideIntro.parentNode && module.parentNode !== guideIntro.parentNode) {
        guideIntro.parentNode.insertBefore(module, guideIntro.nextSibling);
      }
    }

    function setCopiedState() {
      if (!copyButton) return;
      copyButton.classList.add("is-copied");
      if (copyLabel) copyLabel.textContent = "Copied";
      if (live) live.textContent = "Code SAVE50 copied to clipboard";
      clearTimeout(resetTimer);
      resetTimer = setTimeout(function () {
        copyButton.classList.remove("is-copied");
        if (copyLabel) copyLabel.textContent = "Copy";
        if (live) live.textContent = "";
      }, 2100);
    }

    function selectCodeFallback() {
      var code = shell.querySelector(".guide-save50-code b");
      if (code && window.getSelection && document.createRange) {
        var range = document.createRange();
        range.selectNodeContents(code);
        var selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
      }
      if (live) live.textContent = "Code SAVE50 selected. Press Cmd or Ctrl C to copy.";
    }

    if (copyButton && !copyButton.dataset.save50CopyBound) {
      copyButton.dataset.save50CopyBound = "true";
      copyButton.addEventListener("click", function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText("SAVE50").then(setCopiedState).catch(selectCodeFallback);
        } else {
          selectCodeFallback();
        }
      });
    }

    var sticky = shell.querySelector(".guide-save50-sticky");
    if (module && sticky && "IntersectionObserver" in window && !sticky.dataset.save50StickyBound) {
      sticky.dataset.save50StickyBound = "true";
      var observer = new IntersectionObserver(function (entries) {
        sticky.classList.toggle("is-visible", !entries[0].isIntersecting);
      }, { rootMargin: "-10px 0px 0px 0px", threshold: 0 });
      observer.observe(module);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", showGuestSocialProofSave50);
  } else {
    showGuestSocialProofSave50();
  }
})();
</script>
{% endmacro %}
