{# Phone-width search pill. Hidden until trip-sheet.js moves the trip form into the sheet; without JS the plain form stays on the page. #}
<button class="ts-pill" type="button" data-trip-sheet-open aria-haspopup="dialog" aria-controls="trip-sheet" hidden>
  <svg class="ts-pill-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <span class="ts-pill-text"><span class="ts-pill-label">Dates and guests</span><span class="ts-pill-value" data-trip-summary>Flexible dates</span></span>
</button>
