{% elif page.url.indexOf('/about-us/') == 0 %}{% set navCurrent = "about" %}
{% elif page.url.indexOf('/property-management/') == 0 or page.url.indexOf('/research/') == 0 %}{% set navCurrent = "owners" %}
{% endif %}
  <header class="g-header">
    <a class="g-wordmark" href="/" data-trip-link aria-label="Seascape Vacations home">seascape<span>VACATIONS</span></a>
    <nav class="g-nav" aria-label="Primary">
      <a href="/properties/" data-trip-link{% if navCurrent == "our-homes" %} aria-current="page"{% endif %}>Our homes</a><a href="/guides/" data-trip-link{% if navCurrent == "explore" %} aria-current="page"{% endif %}>Explore the coast</a><a href="/about-us/" data-trip-link{% if navCurrent == "about" %} aria-current="page"{% endif %}>About Seascape</a><a href="/property-management/" data-track-event="owner_primary_cta_click" data-page-slug="{{ page.url | replace('/', '') or 'home' }}" data-placement="guest_navigation"{% if navCurrent == "owners" %} aria-current="page"{% endif %}>Property Owners</a>
    </nav>
    <div class="g-header-actions"><a class="g-header-phone" href="tel:9417048545" aria-label="Call Seascape Vacations at (941) 704-8545"><span class="g-header-phone-text">(941) 704-8545</span><span class="g-header-phone-icon" aria-hidden="true">{{ uiIcon('phone') }}</span></a><a class="g-button btn-brand" href="{% if guestHome %}#home-trip{% else %}{{ navButtonHref or "/properties/" }}{% endif %}"{% if not guestHome %} data-trip-link{% endif %}{% if navButtonTarget %} target="{{ navButtonTarget }}"{% endif %}{% if navButtonRel %} rel="{{ navButtonRel }}"{% endif %}{% if navButtonAttributes %} {{ navButtonAttributes | safe }}{% endif %}>{{ navButtonLabel or "Find your home" }} <span aria-hidden="true">{{ uiIcon('arrow-up-right') }}</span></a><button class="g-menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="guest-menu">Menu</button></div>
    <nav class="g-mobile-menu" id="guest-menu" aria-label="Mobile" hidden><a href="/properties/" data-trip-link{% if navCurrent == "our-homes" %} aria-current="page"{% endif %}>Our homes</a><a href="/guides/" data-trip-link{% if navCurrent == "explore" %} aria-current="page"{% endif %}>Explore the coast</a><a href="/about-us/" data-trip-link{% if navCurrent == "about" %} aria-current="page"{% endif %}>About Seascape</a><a href="tel:9417048545">Call (941) 704-8545</a><a href="/property-management/" data-track-event="owner_primary_cta_click" data-page-slug="{{ page.url | replace('/', '') or 'home' }}" data-placement="guest_navigation"{% if navCurrent == "owners" %} aria-current="page"{% endif %}>Property owners</a></nav>
