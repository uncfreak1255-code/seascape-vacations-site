  <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="m8 5 4 4 4-4"/><path d="m8 19 4-4 4 4"/><path d="M4.2 8.5 19.8 15.5"/><path d="m6 15 1-5 5 2"/><path d="m18 9-1 5-5-2"/><path d="M19.8 8.5 4.2 15.5"/><path d="m18 15-5-2 1 5"/><path d="m6 9 5 2-1-5"/></svg>
  {% elif name == "fish" %}
  <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12c3-4 7-6 11-6 1.7 0 3.3.3 4.8 1L21 5v14l-2.2-2c-1.5.7-3.1 1-4.8 1-4 0-8-2-11-6Z"/><circle cx="14.5" cy="10" r=".75"/></svg>
  {% elif name == "sparkles" %}
  <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3Z"/><path d="m19 14 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14Z"/><path d="m5 14 .9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14Z"/></svg>
  {% else %}
  <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
  {% endif %}
</span>
{% endmacro %}

{% macro uiLabel(name, text, className = "", iconClass = "") %}
<span
  class="ui-label{% if className %} {{ className }}{% endif %}"
  style="display:inline-flex;align-items:center;gap:0.55em;vertical-align:middle"
>
  {{ uiIcon(name, iconClass) }}
  <span>{{ text }}</span>
</span>
{% endmacro %}
