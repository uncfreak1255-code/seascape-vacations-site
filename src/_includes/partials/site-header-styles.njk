    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(245, 238, 214, 0.96);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }

    .nav.scrolled {
        background: rgba(245, 238, 214, 0.99);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
    }

    .home-shell .nav:not(.scrolled) {
        background: linear-gradient(180deg, rgba(10, 26, 28, 0.55) 0%, rgba(10, 26, 28, 0.25) 60%, rgba(10, 26, 28, 0) 100%);
        border-bottom: 0;
        box-shadow: none;
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
    }

    .home-shell .nav:not(.scrolled) .nav-inner {
        min-height: 0;
        padding: 24px 48px;
    }

    .nav-inner {
        min-height: 78px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .nav-logo {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        transition: transform 0.3s ease;
    }

    .nav-logo:hover {
        transform: scale(1.02);
    }

    .nav-logo img {
        width: auto;
        height: 40px;
        max-width: none;
        flex: 0 0 auto;
        display: block;
    }

    .nav-logo-copy {
        display: flex;
        flex-direction: column;
    }

    .nav-logo-text {
        font-family: "Playfair Display", serif;
        font-size: 20px;
        font-weight: 500;
        color: var(--brand);
        letter-spacing: 0.05em;
    }

    .home-shell .nav:not(.scrolled) .nav-logo-text {
        color: white;
        font-size: 20px;
        letter-spacing: 0.32em;
        line-height: 1;
        text-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    }

    .nav-logo-sub {
        font-size: 9px;
        letter-spacing: 0.2em;
        color: var(--stone-light);
        text-transform: uppercase;
        margin-top: -2px;
    }

    .home-shell .nav:not(.scrolled) .nav-logo-sub {
        color: #E8C77A;
        font-family: "Playfair Display", serif;
        font-size: 12px;
        font-style: italic;
        letter-spacing: 0.16em;
        line-height: 1;
        margin-top: 4px;
        text-transform: none;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
    }

    .home-shell .nav:not(.scrolled) .nav-logo {
        gap: 12px;
    }

    .home-shell .nav:not(.scrolled) .nav-logo img {
        display: none;
    }

    .home-shell .nav:not(.scrolled) .nav-logo::before {
        content: "";
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 32 32' xmlns='http://www.w3.org/2000/svg'><circle cx='16' cy='16' r='15' fill='none' stroke='%23C9A962' stroke-width='1'/><path d='M6 20 Q10 17 14 20 T22 20 T30 20' fill='none' stroke='%23C9A962' stroke-width='1' stroke-linecap='round'/><path d='M6 23 Q10 20 14 23 T22 23 T30 23' fill='none' stroke='%23C9A962' stroke-width='1' stroke-linecap='round' opacity='.6'/></svg>");
        background-position: center;
        background-repeat: no-repeat;
        background-size: contain;
    }

    .nav-links {
        display: none;
        align-items: center;
        gap: 24px;
        margin-left: 32px;
    }

    .home-shell .nav:not(.scrolled) .nav-links {
        gap: 36px;
        margin-left: 0;
    }

    .nav-link {
        font-size: 14px;
        font-weight: 500;
        color: var(--stone-light);
        position: relative;
        padding: 8px 0;
        transition: color 0.25s ease;
        white-space: nowrap;
    }

    .home-shell .nav:not(.scrolled) .nav-link {
        color: white;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
        text-transform: uppercase;
    }

    button.nav-link {
        background: none;
        border: none;
        cursor: pointer;
        font: inherit;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--brand), var(--gold));
        transition: width 0.25s ease;
    }

    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link.is-current {
        color: var(--brand-dark);
    }

    .home-shell .nav:not(.scrolled) .nav-link:hover,
    .home-shell .nav:not(.scrolled) .nav-link:focus-visible,
    .home-shell .nav:not(.scrolled) .nav-link.is-current {
        color: white;
    }

    .home-shell .nav:not(.scrolled) .nav-link::after {
        display: none;
    }

    .home-shell .nav:not(.scrolled) .nav-links .btn-brand {
        padding: 13px 26px;
        background: var(--gold);
        color: #2A2014;
        border: 0;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.2em;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    }

    .home-shell .nav:not(.scrolled) .nav-links .btn-brand:hover,
    .home-shell .nav:not(.scrolled) .nav-links .btn-brand:focus-visible {
        background: #D4B370;
        color: #2A2014;
        transform: translateY(-1px);
    }

    .home-shell .nav:not(.scrolled) .nav-links .btn-brand::after {
        inset: 3px;
        border-color: rgba(42, 32, 20, 0.25);
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after,
    .nav-link.is-current::after {
        width: 100%;
    }

    .nav-dropdown {
        position: relative;
        display: flex;
        align-items: center;
    }

    .nav-link--trigger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .nav-dropdown-content {
        display: none;
        position: absolute;
        top: calc(100% + 12px);
        left: 50%;
        transform: translateX(-50%);
        min-width: 220px;
        padding: 14px 0 8px;
        background: white;
        border-radius: 14px;
        box-shadow: 0 16px 42px rgba(0, 0, 0, 0.14);
        z-index: 1001;
    }

    .nav-dropdown-content::before {
        content: "";
        position: absolute;
        top: -6px;
        left: 50%;
        width: 12px;
        height: 12px;
        background: white;
        transform: translateX(-50%) rotate(45deg);
    }

    .nav-dropdown:hover .nav-dropdown-content,
    .nav-dropdown:focus-within .nav-dropdown-content {
        display: block;
    }

    .nav-dropdown-content a {
        display: block;
        padding: 12px 20px;
        color: var(--stone);
        font-size: 14px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .nav-dropdown-content a:hover,
    .nav-dropdown-content a:focus-visible {
        background: var(--cream-light);
        color: var(--brand);
        border-left-color: var(--brand);
    }

    .nav-links .btn {
        margin-left: 8px;
        white-space: nowrap;
    }

    .mobile-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--stone);
        padding: 8px;
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .home-shell .nav:not(.scrolled) .mobile-btn {
        color: white;
    }

    .mobile-btn svg {
        width: 22px;
        height: 22px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .mobile-menu {
        display: none;
        padding: 20px 24px 24px;
        background: white;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

    .mobile-menu.active {
        display: block;
    }

    .mobile-item {
        display: block;
        padding: 16px 0;
        color: var(--stone);
        font-size: 15px;
        font-weight: 500;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .mobile-item--sub {
        padding-left: 24px;
        font-size: 14px;
        color: var(--stone-light);
    }

    .mobile-item--current {
        color: var(--brand-dark);
        font-weight: 600;
    }

    .mobile-section-label {
        color: var(--brand);
        font-weight: 600;
    }

    .mobile-menu .btn {
        width: 100%;
        justify-content: center;
        margin-top: 16px;
    }

    @media (min-width: 1200px) {
        .nav-links {
            display: flex;
        }

        .mobile-btn,
        .mobile-menu {
            display: none !important;
        }
    }

    @media (min-width: 1200px) and (max-width: 1399px) {
        .home-shell .nav:not(.scrolled) .nav-inner {
            padding: 22px 28px;
        }

        .home-shell .nav:not(.scrolled) .nav-links {
            gap: 20px;
        }

        .home-shell .nav:not(.scrolled) .nav-link {
            font-size: 10.5px;
            letter-spacing: 0.16em;
        }

        .home-shell .nav:not(.scrolled) .nav-logo-text {
            letter-spacing: 0.22em;
        }

        .home-shell .nav:not(.scrolled) .nav-links .btn-brand {
            padding: 12px 22px;
            letter-spacing: 0.16em;
        }
    }

    @media (max-width: 1199px) {
        .home-shell .nav:not(.scrolled) .nav-inner {
            padding: 18px 16px;
        }

        .nav-inner {
            padding-top: 14px;
            padding-bottom: 14px;
        }

        .nav-logo img {
            height: 36px;
        }

        .nav-logo-text {
            font-size: 18px;
        }
    }
