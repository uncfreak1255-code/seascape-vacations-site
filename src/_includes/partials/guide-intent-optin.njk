{% macro guideIntentOptIn(config = {}) %}
<style>
  .guide-intent-optin {
    margin: 26px 0 30px;
    padding: 24px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(95, 138, 139, 0.1), rgba(255, 255, 255, 0.96));
    border: 1px solid rgba(61, 92, 93, 0.12);
    box-shadow: 0 14px 28px rgba(21, 37, 38, 0.08);
  }

  .guide-intent-optin-label {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5F8A8B;
  }

  .guide-intent-optin h2 {
    margin: 0 0 10px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(25px, 3vw, 32px);
    line-height: 1.12;
    color: #2D4647;
  }

  .guide-intent-optin p {
    margin: 0;
    color: #3A3A3A;
    line-height: 1.7;
  }

  .guide-intent-optin-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 12px;
    margin-top: 18px;
  }

  .guide-intent-optin-form input {
    min-height: 50px;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid rgba(61, 92, 93, 0.14);
    background: white;
    font: inherit;
  }

  .guide-intent-optin-form button {
    min-height: 50px;
    padding: 0 20px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, #C9A962 0%, #B8943A 100%);
    color: #2D4647;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .guide-intent-optin-note {
    margin-top: 12px;
    font-size: 13px;
    color: #595959;
  }

  .guide-intent-optin-success {
    display: none;
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(95, 138, 139, 0.12);
    border: 1px solid rgba(95, 138, 139, 0.16);
    color: #2D4647;
  }

  .guide-intent-optin-success.is-visible,
  .guide-intent-optin-success.show {
    display: block;
  }

  @media (max-width: 760px) {
    .guide-intent-optin {
      padding: 20px;
    }

    .guide-intent-optin-form {
      grid-template-columns: 1fr;
    }
  }
</style>

<section
  class="guide-intent-optin"
  data-email-capture-root
  data-guide-slug="{{ config.guideSlug }}"
>
  <span class="guide-intent-optin-label">{{ config.label or "Trip Planning Shortcut" }}</span>
  <h2>{{ config.title or "Get the short list for this trip" }}</h2>
  <p>{{ config.copy or "We will send one tight email with the better-fit homes, the smarter base, and the direct-book path for this exact kind of Gulf Coast trip." }}</p>

  <form
    class="guide-intent-optin-form"
    data-track-form="email_capture"
    data-form-submit-event="email_capture_submit"
    data-inline-email-capture="true"
    data-form-placement="{{ config.placement or 'guide-inline-top' }}"
    data-guide-slug="{{ config.guideSlug }}"
    data-page-slug="{{ config.pageSlug or config.guideSlug }}"
    data-source-page-slug="{{ config.sourcePageSlug or config.guideSlug }}"
  >
    <input type="hidden" name="form_name" value="guide_optin">
    <input type="hidden" name="source_page_slug" value="{{ config.sourcePageSlug or config.guideSlug }}">
    <input type="hidden" name="entry_point" value="{{ config.entryPoint or 'guide' }}">
    <input type="hidden" name="source_page" value="{{ config.sourcePage or config.guideSlug }}">
    <input type="hidden" name="destination_interest" value="{{ config.destinationInterest or '' }}">
    <input type="hidden" name="trip_intent" value="{{ config.tripIntent or '' }}">
    <input type="hidden" name="party_size_band" value="{{ config.partySizeBand or '' }}">
    <input type="hidden" name="timing_window" value="{{ config.timingWindow or '' }}">
    <input type="hidden" name="property_interest" value="{{ config.propertyInterest or '' }}">
    <input type="hidden" name="market" value="{{ config.market or 'florida-gulf-coast' }}">
    <input type="hidden" name="booking_stage" value="{{ config.bookingStage or 'planning' }}">

    <input type="text" name="name" placeholder="First name" autocomplete="name" required>
    <input type="email" name="email" placeholder="Email address" autocomplete="email" required>
    <button type="submit">{{ config.buttonLabel or "Send My Short List" }}</button>
  </form>

  <div class="guide-intent-optin-success" data-email-capture-success>
    {{ config.successText or "You are in. We will send the direct-booking short list for this trip shape." }}
  </div>
  <p class="guide-intent-optin-note">{{ config.note or "No generic newsletter. Just the direct-booking version of this guide." }}</p>
</section>
{% endmacro %}
