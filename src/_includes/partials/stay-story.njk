<section id="stay-story" class="g-detail-section stay-story" aria-labelledby="stay-story-title">
  <div class="stay-story-heading"><h2 id="stay-story-title">{{ story.heading }}</h2><span>15 seconds · Silent film</span></div>
  <div class="stay-story-player"><video id="stay-story-film" playsinline tabindex="0" preload="none" width="1920" height="1080" aria-label="{{ story.name }} stay story" data-media-dir="{{ story.mediaDir }}" aria-describedby="stay-story-description"></video><button class="story-play" type="button" aria-label="Play stay story" aria-controls="stay-story-film"><svg class="story-play-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l10-6.5z"/></svg><svg class="story-loading-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="42 15"/></svg></button><span class="story-player-status" role="status" aria-live="polite"></span></div>
  <noscript><p><a href="/assets/media/{{ story.mediaDir }}/stay-story-cinema-web.mp4">Watch the landscape film</a> · <a href="/assets/media/{{ story.mediaDir }}/stay-story-portrait-mobile.mp4">Watch the portrait film</a></p></noscript>
  <p id="stay-story-description" class="g-small">{{ story.description }}</p>
</section>
