<script type="application/ld+json">
{"@context":"https://schema.org","@type":"VacationRental","@id":"{{ site.url }}{{ property.pageUrl }}#rental","identifier":{{ property.schemaIdentifier | json | safe }},"name":{{ property.name | json | safe }},"description":{{ (facts.summary + " " + property.bedrooms + " bedrooms, " + property.bathrooms + " bathrooms, sleeps " + property.guests + " guests.") | json | safe }},"url":"{{ site.url }}{{ property.pageUrl }}","image":[{% for photo in property.photography.photos %}"{{ site.url }}{{ photo.src }}"{% if not loop.last %},{% endif %}{% endfor %}],"address":{"@type":"PostalAddress","addressLocality":{{ property.city | json | safe }},"addressRegion":"FL","postalCode":{{ property.postalCode | json | safe }},"addressCountry":"US"},"latitude":{{ property.latitude }},"longitude":{{ property.longitude }},"containsPlace":{"@type":"Accommodation","additionalType":"EntirePlace","numberOfBedrooms":{{ property.bedrooms }},"numberOfBathroomsTotal":{{ property.bathrooms }},"occupancy":{"@type":"QuantitativeValue","value":{{ property.guests }}},"amenityFeature":[{% for amenity in property | propertySchemaAmenities %}{"@type":"LocationFeatureSpecification","name":{{ amenity | json | safe }},"value":true}{% if not loop.last %},{% endif %}{% endfor %}]}}
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Our homes","item":"{{ site.url }}/properties/"},{"@type":"ListItem","position":3,"name":{{ property.name | json | safe }},"item":"{{ site.url }}{{ property.pageUrl }}"}]}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I bring a dog?","acceptedAnswer":{"@type":"Answer","text":{{ facts.pets.text | json | safe }}}},{"@type":"Question","name":"Is pool heating included?","acceptedAnswer":{"@type":"Answer","text":{{ facts.poolHeat | json | safe }}}},{"@type":"Question","name":"What are the cancellation terms?","acceptedAnswer":{"@type":"Answer","text":"Review the cancellation policy shown for your reservation on the booking page before paying. Ask us if you need help understanding the terms."}}]}</script>

{% if facts.reviews | length %}<script type="application/ld+json">[{% for review in facts.reviews %}{"@context":"https://schema.org","@type":"Review","itemReviewed":{"@id":"{{ site.url }}{{ property.pageUrl }}#rental","@type":"VacationRental","name":{{ property.name | json | safe }},"url":"{{ site.url }}{{ property.pageUrl }}"},"author":{"@type":"Person","name":{{ review.author | json | safe }}},"datePublished":{{ review.date | json | safe }},"reviewBody":{{ review.text | json | safe }},"reviewRating":{"@type":"Rating","ratingValue":{{ review.rating }},"bestRating":5}}{% if not loop.last %},{% endif %}{% endfor %}]</script>{% endif %}
