.legal-hero {
    background:
        linear-gradient(180deg, rgba(250, 247, 238, 0.96) 0%, rgba(245, 238, 214, 0.92) 100%),
        radial-gradient(circle at top right, rgba(201, 169, 98, 0.12), transparent 42%);
    border-bottom: 1px solid rgba(61, 92, 93, 0.08);
}

.legal-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 28px 24px 20px;
}

.legal-hero .section-tag {
    margin-bottom: 14px;
}

.legal-title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.08;
    color: var(--brand-dark);
    margin-bottom: 18px;
}

.legal-intro {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--stone);
}

.legal-shell {
    max-width: 880px;
    margin: 0 auto;
}

.legal-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.9fr);
    align-items: start;
}

.legal-card {
    background: white;
    border: 1px solid rgba(61, 92, 93, 0.08);
    border-radius: 20px;
    box-shadow: 0 12px 36px rgba(28, 38, 39, 0.06);
    padding: 28px;
}

.legal-card h2 {
    font-size: clamp(24px, 3vw, 30px);
    color: var(--brand-dark);
    margin-bottom: 14px;
}

.legal-card h3 {
    font-size: 18px;
    color: var(--brand-dark);
    margin: 0 0 10px;
}

.legal-card p:last-child,
.legal-card ul:last-child {
    margin-bottom: 0;
}

.legal-section + .legal-section {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--cream-dark);
}

.legal-list {
    margin: 0;
    padding-left: 22px;
    color: var(--stone);
}

.legal-list li + li {
    margin-top: 10px;
}

.legal-kicker {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-dark);
}

.legal-note {
    background: var(--cream-light);
    border: 1px solid rgba(201, 169, 98, 0.38);
    border-radius: 16px;
    padding: 18px 20px;
}

.legal-note p {
    margin: 0;
}

.legal-contact {
    display: grid;
    gap: 10px;
    margin-top: 18px;
}

.legal-contact a,
.legal-contact span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--stone);
    font-weight: 500;
}

.legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-top: 18px;
}

.legal-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--cream-light);
    border: 1px solid rgba(61, 92, 93, 0.12);
    color: var(--brand-dark);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
}

.legal-links a:hover,
.legal-links a:focus-visible {
    border-color: rgba(201, 169, 98, 0.75);
    background: white;
}

.legal-anchor-list {
    display: grid;
    gap: 12px;
}

.legal-anchor-list a {
    display: block;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid rgba(61, 92, 93, 0.1);
    background: var(--cream-light);
    color: var(--brand-dark);
    font-weight: 600;
    text-decoration: none;
}

.legal-anchor-list span {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 400;
    color: var(--stone-light);
}

@media (max-width: 767px) {
    .legal-hero-inner {
        padding: 24px 16px 16px;
    }

    .legal-intro {
        font-size: 16px;
    }

    .legal-grid {
        grid-template-columns: 1fr;
    }

    .legal-card {
        padding: 22px;
    }

    .legal-section + .legal-section {
        margin-top: 20px;
        padding-top: 20px;
    }
}
