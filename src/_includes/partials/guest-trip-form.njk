<form class="g-trip-form" data-guest-trip-form data-max-guests="{{ property.guests or 17 }}" {% if property %}data-property-name="{{ property.name }}" data-property-slug="{{ property.slug }}" data-booking-url="{{ property.bookingUrl }}"{% endif %} action="{% if property %}{{ property.bookingUrl }}{% else %}/properties/{% endif %}" method="get" {% if property %}target="_blank"{% endif %}>
  <div><label for="{{ tripFormId }}-arrive">Arrival</label><input class="g-arrive" id="{{ tripFormId }}-arrive" name="{% if property %}start{% else %}arrive{% endif %}" type="date"></div>
  <div><label for="{{ tripFormId }}-depart">Departure</label><input class="g-depart" id="{{ tripFormId }}-depart" name="{% if property %}end{% else %}depart{% endif %}" type="date"></div>
  <div><label for="{{ tripFormId }}-guests">Guests</label><select class="g-guests" id="{{ tripFormId }}-guests" name="{% if property %}numberOfGuests{% else %}guests{% endif %}"><option value="">Choose group size</option>{% for n in range(1,(property.guests + 1) if property else 18) %}<option value="{{ n }}">{% if n == 17 %}More than 16{% else %}{{ n }} {% if n == 1 %}guest{% else %}guests{% endif %}{% endif %}</option>{% endfor %}</select></div>
  <button class="g-button btn-brand" type="submit" {% if property %}data-track-event="property_check_availability_click" data-placement="property_booking_panel"{% endif %}>{% if property %}Check dates & total{% else %}Find my home{% endif %}</button>
  <p class="g-form-status" aria-live="polite">{% if property %}Availability, fees and cancellation terms are confirmed on our secure booking page.{% else %}Dates optional. We’ll start with homes that fit your group.{% endif %}</p>
</form>
