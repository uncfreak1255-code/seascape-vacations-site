<div class="property-img">
  <img
    src="{{ property.photography.photos[0].src or property.image | imgProxy(800) }}"
    width="800"
    height="533"
    loading="{{ loading | default('lazy') }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    decoding="async"
    alt="{{ property.name }} - {{ property.specs }} vacation rental in {{ property.city }}, Florida"
    onerror="this.onerror=null;this.hidden=true;this.parentElement.querySelector('[data-photo-unavailable]').hidden=false;"
    style="position:absolute;width:100%;height:100%;object-fit:cover;top:0;left:0;">
  <span data-photo-unavailable hidden style="position:absolute;inset:0;padding:24px;background:#eeeae2;color:#173d42;">{{ property.name }} photo unavailable. Open this home for more details.</span>
  {% if badge %}
  <span class="property-badge">{{ badge | safe }}</span>
  {% endif %}
</div>
