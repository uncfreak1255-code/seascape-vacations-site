<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "disambiguatingDescription": {{ site.disambiguatingDescription | dump | safe }},
    "areaServed": ["Bradenton, FL", "Sarasota, FL"],
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "logo": "{{ site.url }}/logo-optimized.png",
    "sameAs": [
        {% for profile in site.sameAsLinks %}
        {{ profile | dump | safe }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
