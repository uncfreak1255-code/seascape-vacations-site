        .owner-lead-form {
            display: grid;
            gap: 24px;
            text-align: left;
            max-width: 1052px;
            margin: 0 auto;
        }
        .owner-form-context {
            display: grid;
            gap: 12px;
            max-width: 780px;
        }
        .owner-form-eyebrow {
            font-size: 11px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--gold-light);
            font-weight: 700;
            margin: 0;
        }
        .owner-form-title {
            color: white;
            font-size: clamp(34px, 4vw, 48px);
            line-height: 1.08;
            margin: 0;
        }
        .owner-form-copy {
            color: rgba(255, 255, 255, 0.88);
            margin: 0;
            max-width: 760px;
        }
        .owner-form-card {
            display: grid;
            grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.1fr);
            gap: 28px;
            padding: 28px;
            border-radius: 22px;
            border: 1px solid rgba(217, 214, 203, 0.92);
            background: white;
            box-shadow: 0 20px 42px rgba(45, 70, 71, 0.16);
        }
        .owner-form-card-copy {
            display: grid;
            gap: 12px;
            align-content: start;
        }
        .owner-form-card-title {
            color: var(--brand-dark);
            font-size: clamp(30px, 3vw, 42px);
            line-height: 1.12;
            margin: 0;
        }
        .owner-form-card-intro,
        .owner-form-detail-copy {
            color: var(--stone);
            margin: 0;
            font-size: 15px;
            line-height: 1.6;
        }
        .owner-form-proof-note {
            color: var(--brand);
            margin: 0;
            font-size: 14px;
            line-height: 1.55;
        }
        .owner-form-detail-label {
            color: var(--brand);
            margin: 10px 0 0;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }
        .owner-form-confirmation {
            padding: 16px 18px;
            border-radius: 16px;
            border: 1px solid #e5dcc3;
            background: var(--cream);
            color: var(--brand-dark);
            font-size: 14px;
            line-height: 1.6;
        }
        .owner-form-confirmation p {
            margin: 0;
            color: inherit;
        }
        .owner-form-fieldset {
            display: grid;
            gap: 16px;
            align-content: start;
        }
        .owner-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }
        .owner-form-field {
            display: grid;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--brand-dark);
        }
        .owner-form-field span {
            color: inherit;
        }
        .owner-form-field input,
        .owner-form-field textarea {
            width: 100%;
            min-height: 52px;
            border-radius: 14px;
            border: 1px solid #d9d6cb;
            background: var(--cream-light);
            color: var(--brand-dark);
            padding: 0 16px;
            font: inherit;
        }
        .owner-form-field textarea {
            min-height: 92px;
            padding: 14px 16px;
            resize: vertical;
        }
        .owner-form-field input::placeholder,
        .owner-form-field textarea::placeholder {
            color: rgba(61, 92, 93, 0.72);
        }
        .owner-form-field input[type="file"] {
            min-height: 58px;
            padding: 12px 14px;
            font-size: 13px;
            line-height: 1.4;
        }
        .owner-form-field input[type="file"]::file-selector-button {
            margin-right: 12px;
            border: 1px solid rgba(61, 92, 93, 0.18);
            border-radius: 999px;
            background: white;
            color: var(--brand-dark);
            padding: 8px 12px;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }
        .owner-form-field--wide {
            grid-column: 1 / -1;
        }
        .owner-form-actions {
            display: flex;
            justify-content: flex-start;
        }
        .owner-form-submit {
            justify-content: center;
            min-width: 314px;
            min-height: 56px;
        }
        @media (max-width: 920px) {
            .owner-form-card {
                grid-template-columns: 1fr;
            }
            .owner-form-grid {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 640px) {
            .owner-lead-form {
                gap: 18px;
            }
            .owner-form-title {
                font-size: 34px;
            }
            .owner-form-card {
                padding: 22px 20px;
                gap: 22px;
            }
            .owner-form-card-title {
                font-size: 24px;
            }
            .owner-form-actions {
                justify-content: stretch;
            }
            .owner-form-submit {
                width: 100%;
                min-width: 0;
            }
        }
