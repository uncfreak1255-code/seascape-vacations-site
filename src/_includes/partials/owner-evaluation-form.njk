{% macro ownerEvaluationForm(options = {}) %}
<form
  class="owner-lead-form{% if options.className %} {{ options.className }}{% endif %}"
  {% if options.id %}id="{{ options.id }}"{% endif %}
  name="{{ options.formName or 'owner-revenue-teardown' }}"
  method="POST"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-track-form="owner"
  data-form-start-event="owner_form_start"
  data-form-submit-event="owner_form_submit"
  data-page-slug="{{ options.pageSlug or 'property-management' }}"
  data-source-page-slug="{{ options.sourcePageSlug or options.pageSlug or 'property-management' }}"
  data-market="{{ options.market or 'florida-gulf-coast' }}"
  {% if options.formPlacement %}data-form-placement="{{ options.formPlacement }}"{% endif %}
>
  <input type="hidden" name="form-name" value="{{ options.formName or 'owner-revenue-teardown' }}">
  <input type="hidden" name="page_slug" value="{{ options.pageSlug or 'property-management' }}">
  <input type="hidden" name="source_page_slug" value="{{ options.sourcePageSlug or options.pageSlug or 'property-management' }}">
  <input type="hidden" name="market" value="{{ options.market or 'florida-gulf-coast' }}">
  <input type="hidden" name="lead_type" value="{{ options.leadType or 'owner-revenue-teardown' }}">
  <p hidden>
    <label>Do not fill this out if you are human: <input name="bot-field"></label>
  </p>

  {% if options.eyebrow or options.title or options.intro %}
  <div class="owner-form-context">
    {% if options.eyebrow %}
    <p class="owner-form-eyebrow">{{ options.eyebrow }}</p>
    {% endif %}
    {% if options.title %}
    <h3 class="owner-form-title">{{ options.title }}</h3>
    {% endif %}
    {% if options.intro %}
    <p class="owner-form-copy">{{ options.intro }}</p>
    {% endif %}
  </div>
  {% endif %}

  {% if options.formTitle or options.formIntro or options.proofNote or options.detailCopy or options.confirmation %}
  <div class="owner-form-card">
    <div class="owner-form-card-copy">
      <h4 class="owner-form-card-title">{{ options.formTitle or "Request a Revenue Teardown" }}</h4>
      <p class="owner-form-card-intro">{{ options.formIntro or "Share whichever source is easiest. A listing URL is enough to start; an owner statement or fee quote makes the revenue review sharper." }}</p>
      <p class="owner-form-proof-note">{{ options.proofNote or "The review uses the evidence available. Missing statements, calendars, reviews, or fee terms will be marked as missing instead of guessed." }}</p>
      <p class="owner-form-detail-label">{{ options.detailLabel or "What the review separates" }}</p>
      <p class="owner-form-detail-copy">{{ options.detailCopy or "The private review separates proven cost, likely cost, and missing information before recommending whether to stay put, fix the current setup, or talk about transition." }}</p>
      <div class="owner-form-confirmation">
        <p>{{ options.confirmation or "Got it. Seascape will review what you send and return the clearest next step: stay put, fix the current setup, or talk about a transition." }}</p>
      </div>
    </div>

    <div class="owner-form-fieldset">
  {% endif %}
      <div class="owner-form-grid{% if options.gridClassName %} {{ options.gridClassName }}{% endif %}">
        <label class="owner-form-field">
          <span>Your Name</span>
          <input type="text" name="name" autocomplete="name" placeholder="First and last name" required>
        </label>
        <label class="owner-form-field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
        </label>
        <label class="owner-form-field">
          <span>Phone</span>
          <input type="tel" name="phone" autocomplete="tel" placeholder="(941) 555-1234">
        </label>
        <label class="owner-form-field owner-form-field--wide">
          <span>{{ options.propertyFieldLabel or "Property address or listing URL" }}</span>
          <input type="text" name="property_address" autocomplete="street-address" placeholder="{{ options.propertyFieldPlaceholder or '123 Palm Ave or airbnb.com/h/your-listing' }}" required>
        </label>
        {% if options.showBenchmarkFields %}
        <label class="owner-form-field">
          <span>Listing URL</span>
          <input type="url" name="listing_url" inputmode="url" placeholder="airbnb.com/h/your-listing or vrbo.com/...">
        </label>
        <label class="owner-form-field">
          <span>Current manager or self-managed</span>
          <input type="text" name="current_manager" placeholder="Manager name or self-managed">
        </label>
        <label class="owner-form-field">
          <span>Current fee quote, if known</span>
          <input type="text" name="current_fee_quote" placeholder="15%, 20%, 25%, or fee terms">
        </label>
        <label class="owner-form-field owner-form-field--wide">
          <span>What feels off right now?</span>
          <textarea name="what_feels_off" rows="3" placeholder="Example: too Airbnb-heavy, weak reporting, discounting, maintenance misses, or review-quality drift"></textarea>
        </label>
        <label class="owner-form-field owner-form-field--wide owner-form-field--file">
          <span>Upload owner statement, optional</span>
          <input type="file" name="owner_statement" accept="{{ options.fileAccept or '.pdf,.csv,.xls,.xlsx,.png,.jpg,.jpeg,.webp' }}">
          <small class="owner-form-help">{{ options.fileHelp or "PDF, spreadsheet, or screenshot. Missing statements, calendars, reviews, or fee terms will be marked as missing." }}</small>
        </label>
        {% endif %}
      </div>

  {% if options.formTitle or options.formIntro or options.proofNote or options.detailCopy or options.confirmation %}
      <div class="owner-form-actions">
        <button class="btn btn-gold owner-form-submit" type="submit">{{ options.buttonLabel or "Send My Teardown Request" }}</button>
      </div>
    </div>
  </div>
  {% else %}
  <button class="btn btn-gold owner-form-submit" type="submit">{{ options.buttonLabel or "Request Your Revenue Teardown" }}</button>
  {% endif %}

  {% if not options.suppressNote %}
  <p class="owner-form-note">{{ options.note or "Send the property address or listing URL. We will review management fees, booking sources, and operating gaps that may be costing you owner income." }}</p>
  {% endif %}
</form>
{% endmacro %}
