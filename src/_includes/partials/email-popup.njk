<!-- Email Capture Popup -->
<style>
.email-popup-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);z-index:2000;display:none;justify-content:center;align-items:center;opacity:0;transition:transform .4s ease,opacity .4s ease;overscroll-behavior:contain}
.email-popup-overlay.active{display:flex;opacity:1}
.email-popup{background:linear-gradient(135deg,rgba(255,255,255,.95) 0,rgba(245,243,240,.98) 100%);width:90%;max-width:480px;border-radius:24px;padding:48px 40px;box-shadow:0 25px 80px -12px rgba(0,0,0,.35);position:relative;z-index:2;transform:translateY(30px) scale(.95);transition:transform .4s cubic-bezier(.175,.885,.32,1.275),opacity .4s cubic-bezier(.175,.885,.32,1.275);text-align:center}
.email-popup-overlay.active .email-popup{transform:translateY(0) scale(1)}
.email-popup-close{position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:50%;background:#EBE4CC;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:20px;color:#6A6A6A;transition:transform .2s ease,opacity .2s ease}
.email-popup-close:hover{background:#5F8A8B;color:#fff}
.email-popup-badge{display:inline-block;background:linear-gradient(135deg,#C9A962 0,#E8D5A3 100%);color:#fff;padding:6px 16px;border-radius:20px;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:20px}
.email-popup-title{font-family:"Playfair Display",Georgia,serif;font-size:32px;color:#3D5C5D;margin-bottom:12px;line-height:1.2}
.email-popup-subtitle{color:#3A3A3A;font-size:16px;margin-bottom:28px;line-height:1.6}
.email-popup-form{display:flex;flex-direction:column;gap:12px}
.email-popup-input{width:100%;padding:16px 20px;border:2px solid #EBE4CC;border-radius:12px;font-size:16px;font-family:Poppins,sans-serif;background:#fff}
.email-popup-input:focus{outline:0;border-color:#5F8A8B;box-shadow:0 0 0 4px rgba(95,138,139,.1)}
.email-popup-btn{width:100%;padding:16px 24px;background:linear-gradient(135deg,#5F8A8B 0,#3D5C5D 100%);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;font-family:Poppins,sans-serif}
.email-popup-btn:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(95,138,139,.35)}
.email-popup-privacy{font-size:12px;color:#6A6A6A;margin-top:16px}
.email-popup-success{display:none;text-align:center}
.email-popup-success.show{display:block}
.email-popup-success-icon{width:64px;height:64px;background:linear-gradient(135deg,#5F8A8B 0,#3D5C5D 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px;color:#fff}
@media(max-width:600px){.email-popup{padding:36px 24px;margin:20px}.email-popup-title{font-size:26px}}
</style>
<div id="email-popup" class="email-popup-overlay" data-email-capture-root onclick="closeEmailPopup()">
<div class="email-popup" onclick="event.stopPropagation()">
<button class="email-popup-close" onclick="closeEmailPopup()">&times;</button>
<div id="email-form-content" data-email-capture-content>
<span class="email-popup-badge">&#10024; Exclusive Offer</span>
<h3 class="email-popup-title">Get $50 Off Your Next Stay</h3>
<p class="email-popup-subtitle">Join our list for exclusive deals, local tips, and priority access to new properties. Book direct and save more.</p>
<form class="email-popup-form" id="email-capture-form" data-track-form="email_capture" data-form-submit-event="email_capture_submit" data-inline-email-capture="true" data-form-placement="popup">
<input name="name" class="email-popup-input" placeholder="Your first name" required>
<input type="email" name="email" class="email-popup-input" placeholder="Your email address" required>
<button type="submit" class="email-popup-btn">Get My $50 Credit &rarr;</button>
</form>
<p class="email-popup-privacy">&#128274; No spam, ever. Unsubscribe anytime.</p>
</div>
<div id="email-success-content" class="email-popup-success" data-email-capture-success>
<div class="email-popup-success-icon">&#10003;</div>
<h3 class="email-popup-title">You're In! Here's Your Code</h3>
<p style="font-size:2rem;font-weight:700;letter-spacing:4px;color:#5F8A8B;background:#f0f7f7;padding:12px 24px;border-radius:8px;border:2px dashed #5F8A8B;display:inline-block;margin:12px 0;">SAVE50</p>
<p class="email-popup-subtitle">Use code <strong>SAVE50</strong> at checkout to save $50 on your stay (3+ nights).</p>
<button class="email-popup-btn" onclick="closeEmailPopup()" style="margin-top:16px">Browse Properties &rarr;</button>
</div>
</div>
</div>
<script>
var EMAIL_POPUP_KEY="seascape_email_popup_shown";
function showEmailPopup(){var e=localStorage.getItem(EMAIL_POPUP_KEY);if(e==="subscribed")return;if(e){if((Date.now()-parseInt(e))/864e5<7)return}var t=document.getElementById("email-popup");if(t){t.style.display="flex";setTimeout(function(){t.classList.add("active")},10)}}
function closeEmailPopup(){var e=document.getElementById("email-popup");if(e){e.classList.remove("active");setTimeout(function(){e.style.display="none"},400);localStorage.setItem(EMAIL_POPUP_KEY,Date.now().toString())}}
setTimeout(showEmailPopup,30000);
document.addEventListener("mouseout",function(e){if(e.clientY<10&&!localStorage.getItem(EMAIL_POPUP_KEY)){showEmailPopup()}});
</script>
<script defer src="/assets/js/conversion-tracking.js"></script>
<!-- End Email Capture Popup -->
