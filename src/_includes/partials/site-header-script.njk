<script>
  (function () {
    const nav = document.getElementById("mainNav");
    if (!nav) return;

    const menu = document.getElementById("mobileMenu");
    const button = nav.querySelector(".mobile-btn");
    const menuIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
    const closeIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';

    function setMenuState(isExpanded) {
      if (!menu || !button) return;
      menu.classList.toggle("active", isExpanded);
      button.innerHTML = isExpanded ? closeIcon : menuIcon;
      button.setAttribute("aria-label", isExpanded ? "Close menu" : "Open menu");
      button.setAttribute("aria-expanded", isExpanded ? "true" : "false");
    }

    window.toggleSiteMenu = function toggleSiteMenu() {
      if (!menu) return;
      setMenuState(!menu.classList.contains("active"));
    };

    setMenuState(false);

    window.addEventListener("resize", function () {
      if (window.innerWidth >= 768) {
        setMenuState(false);
      }
    });

    window.addEventListener(
      "scroll",
      function () {
        nav.classList.toggle("scrolled", window.scrollY > 50);
      },
      { passive: true }
    );
  })();
</script>
