{#- Optional "How did you hear about us?" select shared by both owner form UIs.
    The caller sets heardAboutFieldClass to its own Waterline field class. Stable
    values are allowlisted server-side in netlify/functions/_owner-lead-contacts.js. -#}
<label class="{{ heardAboutFieldClass }}">
  <span>How did you hear about us? (optional)</span>
  <select name="heard_about">
    <option value="">Choose one (optional)</option>
    <option value="ai_assistant">ChatGPT or another AI assistant</option>
    <option value="google">Google search</option>
    <option value="airbnb_vrbo">Airbnb or Vrbo</option>
    <option value="referral">Referral from an owner, guest or friend</option>
    <option value="other">Other</option>
  </select>
</label>
