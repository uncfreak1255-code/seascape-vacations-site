{#- Optional "How did you hear about us?" plus the AI prompt. Visible without
    JS; owner-heard-about.js hides the prompt until an AI source is picked.
    Allowlisted values live in netlify/functions/_owner-lead-contacts.js. -#}
<label class="{{ heardAboutFieldClass }}">
  <span>How did you hear about us? (optional)</span>
  <select name="heard_about" data-owner-heard-about>
    <option value="">Choose one (optional)</option>
    <option value="google">Google search</option>
    <option value="google_maps">Google Maps</option>
    <option value="chatgpt">ChatGPT</option>
    <option value="google_ai">Google AI (Gemini / AI Mode)</option>
    <option value="other_ai">Perplexity, Claude or other AI</option>
    <option value="referral">Referral from an owner or friend</option>
    <option value="airbnb_vrbo">Airbnb or Vrbo</option>
    <option value="social">Social media</option>
    <option value="other">Other</option>
  </select>
</label>
<label class="{{ heardAboutFieldClass }} owner-heard-about-prompt" id="owner-heard-about-prompt">
  <span>What did you ask it? (optional)</span>
  <input type="text" name="heard_about_prompt" maxlength="500" autocomplete="off" placeholder="e.g. best vacation rental manager in Bradenton">
  <small class="owner-heard-about-count" data-heard-about-count>0/500</small>
</label>
