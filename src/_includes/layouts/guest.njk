<!doctype html>
<html lang="en">
<head>
  {% if propertySlug %}
    {% set metaProperty = properties | propertyBySlug(propertySlug) %}
    {% set pageDescription = metaProperty.name + " in " + metaProperty.city + ": " + metaProperty.bedrooms + " bedrooms, " + metaProperty.bathrooms + " bathrooms, up to " + metaProperty.guests + " guests. " + metaProperty.guestFacts.tagline + " Compare the full total and book direct." %}
    {% set pageImage = site.url + metaProperty.photography.photos[0].src %}
  {% endif %}
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ pageTitle | seoTitle }}</title><meta name="description" content="{{ pageDescription | seoDescription }}">
  <link rel="alternate" type="application/json" title="Seascape property and booking information" href="https://seascape-vacations.com/ai-discovery.json">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}"><meta name="robots" content="index, follow">
  <meta property="og:type" content="website"><meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ pageTitle }}"><meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ pageImage or site.url + '/images/homes/the-oasis/01.webp' }}">
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}"><meta name="twitter:image" content="{{ pageImage or site.url + '/images/homes/the-oasis/01.webp' }}">
  <link rel="icon" href="/logo-optimized.png" type="image/png">
  {% set localFontDisplay = "swap" %}
  {% include "partials/local-font-head.njk" %}
  <link rel="preload" href="/assets/fonts/homepage/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin>
  {% include "partials/organization-schema.njk" %}
  <link rel="stylesheet" href="/css/base.css">
  {{ headExtra | safe }}
  <link rel="stylesheet" href="/css/guest.css">
</head>
<body class="guest-site" data-guest-version="open-house-v2">
  <a class="g-skip" href="#main">Skip to content</a>
  <header class="g-header">
    <a class="g-wordmark" href="/" data-trip-link aria-label="Seascape Vacations home">Seascape<span>VACATIONS</span></a>
    <nav class="g-nav" aria-label="Primary">
      <a href="/properties/" data-trip-link>Our five homes</a><a href="/guides/">Explore the coast</a><a href="/about-us/">Meet your hosts</a>
    </nav>
    <div class="g-header-actions"><a class="g-button btn-brand" href="/properties/" data-trip-link>Find your home</a><button class="g-menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="guest-menu">Menu</button></div>
    <nav class="g-mobile-menu" id="guest-menu" aria-label="Mobile" hidden><a href="/properties/" data-trip-link>Our five homes</a><a href="/guides/">Explore the coast</a><a href="/about-us/">Meet your hosts</a><a href="tel:9417048545">Call (941) 704-8545</a><a href="/property-management/">Property owners</a></nav>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="g-footer" id="contact"><div class="g-wrap g-footer-grid"><div><a class="g-wordmark" href="/" data-trip-link>Seascape<span>VACATIONS</span></a><p>Five homes. A local connection.<br>Bradenton & Sarasota, Florida.</p></div><div><p class="g-label">Let's talk about your trip</p><a href="tel:9417048545">(941) 704-8545</a><a href="mailto:info@seascape-vacations.com">info@seascape-vacations.com</a></div><div><a href="/properties/" data-trip-link>Our homes</a><a href="/guides/">Local guides</a><a href="/property-management/">For property owners</a><a href="/services/concierge-services/">Help planning your stay</a></div></div><div class="g-wrap g-footer-bottom"><span>© 2026 Seascape Vacations</span><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookies/">Cookies</a></div></div></footer>
  {% include "partials/analytics-ga4.njk" %}
  <script defer src="/assets/js/guest.js"></script>
</body></html>
