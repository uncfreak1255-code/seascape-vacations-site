<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary SEO -->
    <title>{{ pageTitle | seoTitle }}</title>
    <meta name="description" content="{{ pageDescription | seoDescription }}">
    <meta name="author" content="{{ pageAuthor or site.author }}">
    <meta name="robots" content="{{ pageRobots or 'index, follow' }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ pageImage or site.url + '/images/seascape-og-default.jpg' }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Seascape Vacations">
    {% if pageUpdated %}
    <meta property="article:modified_time" content="{{ pageUpdated }}">
    {% endif %}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage or site.url + '/images/seascape-og-default.jpg' }}">
    <link rel="icon" href="/logo-optimized.png" type="image/png">

    {% include "partials/organization-schema.njk" %}
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    </noscript>
    
    {{ headExtra | safe }}

    <link rel="stylesheet" href="/css/base.css">
    <style>
        {% include "partials/site-header-styles.njk" %}
    </style>
</head>
<body>
    {% include "partials/site-header.njk" %}

    <main class="main-content">
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-logo">Seascape Vacations</div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/guides/anna-maria-island-area-guide/">Anna Maria Island</a>
                <a href="/guides/bradenton-area-guide/">Bradenton</a>
                <a href="/guides/sarasota-area-guide/">Sarasota</a>
                <a href="/property-management/">Property Owners</a>
            </div>
            <div class="footer-copyright">
                © 2026 Seascape Vacations. All rights reserved. | Book Direct & Save
                <div class="footer-meta-links">
                    <a href="/privacy/">Privacy</a>
                    <a href="/terms/">Terms</a>
                    <a href="/cookies/">Cookies</a>
                </div>
            </div>
        </div>
    </footer>

    {% include "partials/site-header-script.njk" %}
    {% include "partials/analytics-ga4.njk" %}
</body>
</html>
