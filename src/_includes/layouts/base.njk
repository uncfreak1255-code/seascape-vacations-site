<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary SEO -->
    <title>{{ pageTitle | seoTitle }}</title>
    <meta name="description" content="{{ pageDescription | seoDescription }}">
    <meta name="author" content="{{ pageAuthor or site.author }}">
    <meta name="robots" content="{{ pageRobots or 'index, follow' }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ pageImage or site.url + '/images/seascape-og-default.jpg' }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Seascape Vacations">
    {% if pageUpdated %}
    <meta property="article:modified_time" content="{{ pageUpdated }}">
    {% endif %}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage or site.url + '/images/seascape-og-default.jpg' }}">
    <link rel="icon" href="/logo-optimized.png" type="image/png">

    {% include "partials/organization-schema.njk" %}
    
    <!-- Fonts -->
    {% include "partials/local-font-head.njk" %}
    
    {{ headExtra | safe }}
    {% if legalPage %}
    <style>
        {% include "partials/legal-page-styles.njk" %}
    </style>
    {% endif %}

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/guest.css?v=waterline-v3">
</head>
<body class="guest-shell">
    {% include "partials/guest-header.njk" %}

    <main class="main-content">
        {{ content | safe }}
    </main>

    {% include "partials/guest-footer.njk" %}

    {% include "partials/analytics-ga4.njk" %}
</body>
</html>
