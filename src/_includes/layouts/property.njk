---
layout: layouts/guest.njk
---
{% set property = properties | propertyBySlug(propertySlug) %}
{% set facts = property.guestFacts %}
{% include "partials/property-schema.njk" %}
{{ content | safe }}
<div class="g-property g-wrap" data-property-page="{{ property.slug }}" data-capacity="{{ property.guests }}">
  <nav class="g-breadcrumb" aria-label="Breadcrumb"><a href="/" data-trip-link>Home</a><span>/</span><a href="/properties/" data-trip-link>Our homes</a><span>/</span><span aria-current="page">{{ property.name }}</span></nav>
  <header class="g-property-heading"><div><p class="g-label">{{ property.city }}, Florida · The Seascape collection</p><h1>{{ property.name }}</h1><p>{{ facts.tagline }}</p></div><div class="g-property-actions"><a class="g-button btn-brand" href="#booking" data-track-event="property_check_availability_click" data-placement="property_heading">Check dates & total</a><a class="g-inline-link" href="/properties/?compare={{ property.slug }}" data-trip-link>View comparison <span aria-hidden="true">→</span></a></div></header>
  <div class="g-gallery" aria-label="{{ property.name }} photos">{% for photo in property.photography.photos.slice(0,3) %}<a class="g-gallery-photo" href="#all-photos" aria-label="See all {{ property.name }} photos"><img data-property-photo="{{ property.slug }}" src="{{ photo.src }}" srcset="{{ photo.src | replace('.webp', '-800.webp') }} 800w, {{ photo.src }} {{ photo.width }}w" sizes="(min-width: 900px) 60vw, calc(100vw - 40px)" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></a>{% endfor %}<button class="g-gallery-open" type="button" data-open-gallery hidden>View all {{ property.photography.photos | length }} photos</button></div>
  <div class="g-property-columns"><div class="g-property-content">
    <div class="g-property-specs"><span><strong>{{ property.bedrooms }}</strong> bedrooms</span><span><strong>{{ property.bathrooms }}</strong> bathrooms</span><span>Up to <strong>{{ property.guests }}</strong> guests</span></div>
    <nav class="g-detail-nav" aria-label="Home details"><a href="#overview">The home</a><a href="#sleeping">Sleeping</a><a href="#before-booking">Before you book</a><a href="#all-photos">Photos</a></nav>
    <section id="overview" class="g-detail-section"><p class="g-label">Your time here</p><h2>{{ facts.tagline }}</h2><p class="g-lede">{{ facts.summary }}</p><ul class="g-highlights">{% for highlight in property.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul></section>
    <section id="sleeping" class="g-detail-section"><p class="g-label">Who sleeps where</p><h2>Room for the group.</h2><p>Up to {{ property.guests }} guests. Check the sleeping arrangements as well as the total capacity.</p><ol class="g-sleeping-list">{% for room in facts.sleeping %}<li><span aria-hidden="true">0{{ loop.index }}</span>{{ room }}</li>{% endfor %}</ol>{% if facts.confirmGuestsAbove %}<p class="g-consideration">Planning for 9–12 guests? Confirm the group size with us before booking.</p>{% endif %}</section>
    <section id="before-booking" class="g-detail-section"><p class="g-label">The details worth knowing</p><h2>Before you book.</h2>
      {% for note in facts.considerations %}<p class="g-consideration">{{ note }}</p>{% endfor %}
      <div class="g-faqs"><details><summary>Can I bring a dog?</summary><p>{{ facts.pets.text }}</p></details><details><summary>Is pool heating included?</summary><p>{{ facts.poolHeat }}</p></details><details><summary>What will the stay cost?</summary><p>Select your dates and the full guest count on our secure booking page to see availability and the complete total, including mandatory fees and taxes. Optional extras, such as pool heat, need confirmation before you book.</p>{% if facts.extraGuestsAbove %}<p>Additional-guest charges apply above {{ facts.extraGuestsAbove }} guests. Include everyone in your group when checking the total.</p>{% endif %}</details><details><summary>What are the cancellation terms?</summary><p>Review the cancellation policy shown for your reservation on the booking page before paying. Ask us if you need help understanding the terms.</p></details>{% if facts.checkIn %}<details><summary>When are check-in and check-out?</summary><p>Check-in is from {{ facts.checkIn }}; check-out is by {{ facts.checkOut }}. Confirm any special arrival needs with us before booking.</p></details>{% endif %}</div>
      <p class="g-source-note">Home details checked against the <a href="{{ facts.sourceUrl }}" target="_blank" rel="noopener noreferrer">booking listing</a> on September 4, 2026. Current availability and reservation terms are confirmed at checkout.</p>
    </section>
    {% if facts.reviews | length %}<section class="g-detail-section g-reviews"><p class="g-label">From guests who stayed here</p><h2>Time well spent.</h2>{% for review in facts.reviews %}<figure><blockquote><p>“{{ review.text }}”</p></blockquote><figcaption>{{ review.author }} · {{ review.date }} · {{ review.rating }}/5</figcaption></figure>{% endfor %}<a class="g-inline-link" href="{{ property.bookingUrl }}" target="_blank" rel="noopener noreferrer">Read reviews on the booking page</a></section>{% endif %}
    <section class="g-detail-section g-question" id="ask-about-home"><p class="g-label">A detail could decide it</p><h2>Ask about this home.</h2><p>Dog approval, boat size, or a sleeping arrangement. Send the question with your trip details so we can help.</p><label for="question-topic">What would you like to check?</label><select id="question-topic"><option value="sleeping arrangements">Sleeping arrangements</option><option value="pet approval">Bringing a dog</option><option value="boat and parking space">Boat or parking space</option><option value="steps and access needs">Steps and access</option><option value="pool heating">Pool heating</option><option value="my group size">My group size</option></select><a class="g-button btn-brand" data-question-email href="mailto:info@seascape-vacations.com">Prepare an email</a><a class="g-inline-link" href="tel:9417048545">Or call (941) 704-8545</a><p class="g-small">Opens your email app with the home and trip details. You add your question and send it.</p></section>
  </div>
  <aside class="g-booking" id="booking" aria-label="Dates and booking"><span id="check-availability" aria-hidden="true"></span><p class="g-label">Book {{ property.name }} direct</p><h2>Make it your stay.</h2><p class="g-small">{{ property.bedrooms }} bedrooms · Up to {{ property.guests }} guests</p><div class="property-trip-context" aria-label="Your trip"><p data-trip-summary>Choose dates or keep them flexible.</p><a href="/properties/" data-trip-link>Change trip / compare homes</a></div>{% set tripFormId = 'property-trip' %}{% include "partials/guest-trip-form.njk" %}<a class="g-booking-direct" data-property-checkout href="{{ property.bookingUrl }}" data-track-event="property_booking_page_click" data-page-slug="{{ property.slug }}" data-placement="property_booking_panel" target="_blank" rel="noopener noreferrer">Open the booking page</a><p class="g-small">Secure checkout through Hostaway.</p><a class="g-inline-link" href="#ask-about-home">A question before you choose?</a></aside></div>
  <section id="all-photos" class="g-section g-all-photos" aria-labelledby="photos-heading"><p class="g-label">A closer look</p><h2 id="photos-heading">{{ property.name }}, in pictures.</h2><div class="g-photo-grid">{% for photo in property.photography.photos.slice(3,9) %}<figure><img data-property-photo="{{ property.slug }}" src="{{ photo.src }}" srcset="{{ photo.src | replace('.webp', '-800.webp') }} 800w, {{ photo.src }} {{ photo.width }}w" sizes="(min-width: 900px) 60vw, calc(100vw - 40px)" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy"><figcaption>{{ photo.alt }}</figcaption></figure>{% endfor %}</div><a class="g-inline-link" href="{{ property.bookingUrl }}" target="_blank" rel="noopener noreferrer">See the complete gallery on the booking page</a></section>
  <section class="g-next-home g-section"><div><p class="g-label">Still deciding?</p><h2>See what else fits.</h2><p>Keep your dates and guest count as you compare our other homes.</p></div><a class="g-button btn-brand" href="/properties/?compare={{ property.slug }}" data-trip-link>Compare the collection</a><a class="g-inline-link" href="{% if property.city == 'Sarasota' %}/guides/sarasota-area-guide/{% else %}/guides/anna-maria-island-area-guide/{% endif %}">Plan some time on the coast <span aria-hidden="true">→</span></a></section>
  <div class="g-mobile-booking" hidden><div><strong>{{ property.name }}</strong><span data-mobile-trip>Choose dates & guests</span></div><a class="g-button btn-brand" href="#booking" data-track-event="property_check_availability_click" data-placement="property_mobile_booking">Check dates</a></div>
  <dialog class="g-photo-dialog" aria-label="{{ property.name }} photo gallery"><div><h2>{{ property.name }}</h2><button type="button" data-close-gallery>Close</button></div><div class="g-photo-grid">{% for photo in property.photography.photos %}<img data-property-photo="{{ property.slug }}" data-gallery-src="{{ photo.src }}" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}">{% endfor %}</div></dialog>
</div>
