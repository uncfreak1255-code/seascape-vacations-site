---
permalink: "/stays/"
eleventyComputed:
  pageTitle: "Vacation Rental Stay Collections"
  pageDescription: "Compare Seascape private-pool homes in Bradenton and Sarasota by area, group size, and trip priorities, including near-island collections for Anna Maria Island and Siesta Key."
---
{% set destinationSections = [
  {
    "key": "anna-maria-island",
    "title": "Anna Maria Island",
    "intro": "Near-island pool homes for beach days on AMI without an on-island address."
  },
  {
    "key": "bradenton",
    "title": "Bradenton",
    "intro": "Bigger houses, one canal-front dock home, and more space for the money than the island usually gives."
  },
  {
    "key": "sarasota",
    "title": "Sarasota",
    "intro": "A downtown Sarasota house when restaurants, museums, and city evenings matter more than an island address."
  },
  {
    "key": "siesta-key",
    "title": "Siesta Key",
    "intro": "Siesta Key sand is the draw. Seascape's Sarasota home is a short drive from the island, not an on-key stay."
  }
] %}
{% set pageUpdatedLabel = gitLastModifiedLabel(page.inputPath) %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ pageTitle }} | Seascape Vacations</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ site.url }}/stays/">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/stays/">
  <meta property="og:title" content="{{ pageTitle }} | Seascape Vacations">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ site.url }}/images/seascape-og-default.jpg">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }} | Seascape Vacations">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/images/seascape-og-default.jpg">

  {% include "partials/organization-schema.njk" %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/"},
      {"@type": "ListItem", "position": 2, "name": "Stay Collections", "item": "{{ site.url }}/stays/"}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ pageTitle }}",
    "description": "{{ pageDescription }}",
    "url": "{{ site.url }}/stays/"
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" media="print" onload='this.media="all"'>
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"></noscript>
  <link rel="stylesheet" href="/css/guest.css?v=waterline-v3">
  <style>
    :root {
      --brand: #5F8A8B;
      --brand-dark: #3D5C5D;
      --brand-darker: #22393A;
      --gold: #C9A962;
      --cream: #F5EED6;
      --cream-light: #FAF7EE;
      --stone: #3A3A3A;
      --stone-light: #6A6A6A;
      --white: #FFFFFF;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Poppins, -apple-system, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(232, 213, 163, 0.28), transparent 32%),
        linear-gradient(180deg, #fbf7ef 0%, #f4ecdb 100%);
      color: var(--stone);
      line-height: 1.65;
    }

    h1, h2, h3 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    a { color: inherit; text-decoration: none; }

    .skip-link {
      position: absolute;
      top: 8px;
      left: 8px;
      transform: translateY(-200%);
      background: var(--brand-darker);
      color: white;
      padding: 10px 14px;
      border-radius: 10px;
      z-index: 100;
      transition: transform .2s ease;
    }

    .skip-link:focus { transform: translateY(0); }

    .nav-inner,
    .hero,
    .section,
    .footer-inner {
      max-width: 1240px;
      margin: 0 auto;
      padding-left: 24px;
      padding-right: 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 22px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      font-size: 13px;
      font-weight: 700;
      box-shadow: 0 8px 22px rgba(61, 92, 93, 0.18);
    }

    .hero {
      padding-top: 112px;
      padding-bottom: 24px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 32px;
      align-items: end;
    }

    .hero-tag,
    .section-tag {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--brand-dark);
      margin-bottom: 14px;
    }

    .hero-title {
      font-size: clamp(38px, 6vw, 68px);
      line-height: 0.98;
      margin-bottom: 16px;
      max-width: 760px;
    }

    .hero-subtitle {
      max-width: 720px;
      font-size: 18px;
      color: var(--stone-light);
    }

    .hero-note,
    .category-card,
    .utility-card {
      border-radius: 26px;
      border: 1px solid rgba(0, 0, 0, 0.06);
      background: rgba(255, 255, 255, 0.84);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
      overflow: hidden;
    }

    .hero-note {
      padding: 24px;
      backdrop-filter: blur(10px);
    }

    .hero-note strong,
    .card-kicker {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--brand);
      margin-bottom: 12px;
    }

    .hero-note p,
    .section-note,
    .category-intro,
    .utility-copy {
      color: var(--stone-light);
    }

    .hero-note p { margin-bottom: 12px; }
    .hero-note small { font-size: 13px; color: var(--stone-light); }

    .section {
      padding-top: 28px;
      padding-bottom: 28px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 18px;
    }

    .section-head h2 {
      font-size: clamp(28px, 4vw, 40px);
      color: var(--brand-darker);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .category-card-body,
    .utility-card-body {
      padding: 24px;
    }

    .category-card h3,
    .utility-card h3 {
      font-size: 26px;
      color: var(--brand-dark);
      margin-bottom: 10px;
    }

    .category-links,
    .utility-links {
      list-style: none;
      display: grid;
      gap: 10px;
      margin-top: 18px;
    }

    .category-links a,
    .utility-links a {
      color: var(--brand-darker);
      font-weight: 600;
    }

    .category-links a:hover,
    .utility-links a:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    .utility-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 18px;
    }

    .utility-pills {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .utility-pills a {
      display: inline-flex;
      align-items: center;
      min-height: 38px;
      padding: 0 14px;
      border-radius: 999px;
      background: var(--cream-light);
      border: 1px solid rgba(95, 138, 139, 0.14);
      color: var(--brand-dark);
      font-size: 13px;
      font-weight: 600;
    }

    .cta-section {
      padding-top: 12px;
      padding-bottom: 28px;
    }

    .cta-panel {
      max-width: 1240px;
      margin: 0 auto;
      padding: 32px 24px;
      border-radius: 30px;
      background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand-darker) 100%);
      color: white;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      align-items: center;
    }

    .cta-panel h2 {
      font-size: clamp(28px, 4vw, 38px);
      margin-bottom: 10px;
    }

    .cta-panel p {
      max-width: 640px;
      color: rgba(255, 255, 255, 0.82);
    }

    .cta-panel .btn {
      background: linear-gradient(135deg, #E3C47A 0%, var(--gold) 38%, #8E6D28 100%);
      color: #2A2014;
      box-shadow: none;
      flex-shrink: 0;
    }

    .footer {
      margin-top: 28px;
      background: var(--brand-darker);
      color: rgba(255, 255, 255, 0.86);
    }

    .footer-inner {
      padding-top: 34px;
      padding-bottom: 34px;
      display: flex;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .footer a { color: rgba(255, 255, 255, 0.9); }

    a:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--gold);
      outline-offset: 2px;
    }

    @media (max-width: 960px) {
      .hero,
      .category-grid,
      .utility-grid {
        grid-template-columns: 1fr;
      }

      .cta-panel {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body class="guest-shell">
  <a class="skip-link" href="#main">Skip to content</a>

  {% set navButtonHref = "/properties/" %}
  {% set navButtonLabel = "Browse Homes" %}
  {% include "partials/guest-header.njk" %}

  <main id="main">
    <header class="hero">
      <div>
        <p class="hero-tag">Stay Collections</p>
        <h1 class="hero-title">Compare Gulf Coast private-pool homes by area, group size, and trip priorities</h1>
        <p class="hero-subtitle">Seascape's homes sit in Bradenton and Sarasota. These collections group them by town, group size, pool setup, and drive time to the beaches — including near-island stays for Anna Maria Island and Siesta Key, not on-island addresses.</p>
      </div>
      <aside class="hero-note">
        <strong>Area or trip details</strong>
        <p>Destination collections group homes by Bradenton, Sarasota, Anna Maria Island, and Siesta Key. Amenity collections group them by pool, dock, group size, and pets.</p>
        <p>Each collection lists the Seascape homes for that area or amenity so you can compare listings side by side.</p>
        <small>Updated {{ pageUpdatedLabel }}</small>
      </aside>
    </header>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-tag">Browse by Destination</p>
          <h2>Destination collections</h2>
        </div>
        <p class="section-note">Bradenton, Sarasota, Anna Maria Island, and Siesta Key collections sit here. Seascape homes are in Bradenton and Sarasota; island collections are near-island drives, not on-key addresses.</p>
      </div>

      <div class="category-grid">
        {% for section in destinationSections %}
        <article class="category-card">
          <div class="category-card-body">
            <span class="card-kicker">Destination</span>
            <h3>{{ section.title }}</h3>
            <p class="category-intro">{{ section.intro }}</p>
            <ul class="category-links">
              {% for page in staysPages %}
              {% set isIndexableStay = seoGovernance.staysNoindexSlugs.indexOf(page.slug) === -1 %}
              {% if isIndexableStay and page.destination == section.key %}
              <li><a href="/stays/{{ page.slug }}/">{{ page.title }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-tag">Trip Type & Amenities</p>
          <h2>Collections by trip and amenities</h2>
        </div>
        <p class="section-note">Pool, dock, group size, pets, and longer stays, across the same Bradenton and Sarasota homes.</p>
      </div>

      <div class="utility-grid">
        <article class="utility-card">
          <div class="utility-card-body">
            <span class="card-kicker">By amenity</span>
            <h3>Pool, dock, group, and stay-length pages</h3>
            <p class="utility-copy">Pool, dock, group, pet, and longer-stay collections sit beside the destination list.</p>
            <ul class="utility-pills">
              {% for page in staysPages %}
              {% set isIndexableStay = seoGovernance.staysNoindexSlugs.indexOf(page.slug) === -1 %}
              {% if isIndexableStay and (not page.destination or page.destination == "florida-gulf-coast") %}
              <li><a href="/stays/{{ page.slug }}/">{{ page.title }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
        </article>

        <article class="utility-card">
          <div class="utility-card-body">
            <span class="card-kicker">Next step</span>
            <h3>Ready to compare actual homes</h3>
            <p class="utility-copy">The direct-book catalog is next: compare homes and dates.</p>
            <ul class="utility-links">
              <li><a href="/properties/">Open the full direct-book property collection</a></li>
              <li><a href="/guides/where-to-stay-near-anna-maria-island/">Read the where-to-stay guide first</a></li>
              <li><a href="/guides/booking-direct-vacation-rentals/">See why booking direct changes the total trip cost</a></li>
              <li><a href="/guides/anna-maria-island-vs-siesta-key/">Compare AMI and Siesta Key before you choose the island</a></li>
            </ul>
          </div>
        </article>
      </div>
    </section>

    <section class="cta-section">
      <div class="cta-panel">
        <div>
          <h2>Ready to compare actual homes?</h2>
          <p>Open the catalog and compare current Seascape homes in one place.</p>
        </div>
        <a class="btn" href="/properties/">Browse Direct-Book Homes</a>
      </div>
    </section>
  </main>

  {% include "partials/guest-footer.njk" %}

  {% include "partials/analytics-ga4.njk" %}
</body>
</html>
