  <style>
    :root {
      --brand: #5F8A8B;
      --brand-light: #7BA3A4;
      --brand-dark: #3D5C5D;
      --brand-darker: #2D4647;
      --gold: #C9A962;
      --gold-light: #E8D5A3;
      --cream: #F5EED6;
      --cream-dark: #EBE4CC;
      --cream-light: #FAF7EE;
      --stone: #3A3A3A;
      --stone-light: #6A6A6A;
      --white: #FFFFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Poppins', -apple-system, sans-serif;
      background: var(--cream);
      color: var(--stone);
      line-height: 1.7;
    }

    h1, h2, h3, h4 {
      font-family: 'Playfair Display', Georgia, serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { text-decoration: none; color: inherit; }

    /* ─── Nav ─────────────────────────────────────────── */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(245, 238, 214, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0,0,0,0.06);
      box-shadow: 0 4px 30px rgba(0,0,0,0.08);
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .nav-logo img {
      width: auto;
      height: 40px;
      max-width: none;
      flex: 0 0 auto;
    }

    .nav-logo-text {
      font-family: 'Playfair Display', serif;
      font-size: 20px;
      font-weight: 500;
      color: var(--brand);
      letter-spacing: 0.05em;
    }

    .nav-logo-sub {
      font-size: 9px;
      letter-spacing: 0.2em;
      color: var(--stone-light);
      text-transform: uppercase;
      margin-top: -2px;
    }

    /* ─── Buttons ─────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 32px;
      border-radius: 50px;
      font-family: 'Poppins', sans-serif;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: none;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(.22,.9,.28,1);
      text-decoration: none;
    }

    .btn-brand {
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      box-shadow: 0 4px 15px rgba(61, 92, 93, 0.3), inset 0 0 0 1px rgba(201,169,98,.35);
    }

    .btn-brand:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(61, 92, 93, 0.4), inset 0 0 0 1px var(--gold);
    }

    .btn-gold {
      background: linear-gradient(135deg, #E3C47A 0%, var(--gold) 38%, #8E6D28 62%, var(--gold) 100%);
      color: #2A2014;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(201, 169, 98, 0.3);
    }

    .btn-gold:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(201, 169, 98, 0.45);
    }

    .btn-outline-light {
      background: rgba(255,255,255,0.08);
      color: white;
      border: 1px solid rgba(255,255,255,0.4);
      backdrop-filter: blur(16px);
    }

    .btn-outline-light:hover {
      background: rgba(255,255,255,0.14);
      border-color: var(--gold);
    }

    /* ─── Layout ──────────────────────────────────────── */
    .main-content { padding-top: 80px; }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .section {
      padding: 80px 24px;
    }

    .section--tight {
      padding: 48px 24px;
    }

    /* ─── Breadcrumbs ─────────────────────────────────── */
    .breadcrumbs {
      background: white;
      padding: 12px 24px;
      border-bottom: 1px solid var(--cream-dark);
    }

    .breadcrumbs ol {
      display: flex;
      gap: 8px;
      list-style: none;
      font-size: 13px;
      max-width: 1100px;
      margin: 0 auto;
      flex-wrap: wrap;
    }

    .breadcrumbs a { color: var(--brand); }
    .breadcrumbs span { color: var(--stone-light); }

    /* ─── Hero ────────────────────────────────────────── */
    .hub-hero {
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      padding: 80px 24px 72px;
      text-align: center;
    }

    .hero-tag {
      display: inline-block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
    }

    .hub-hero h1 {
      font-size: clamp(32px, 5vw, 52px);
      color: white;
      margin-bottom: 20px;
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }

    .hub-hero-intro {
      font-size: 18px;
      opacity: 0.9;
      max-width: 680px;
      margin: 0 auto 32px;
      line-height: 1.75;
    }

    .hub-hero-actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    /* ─── Answer box ──────────────────────────────────── */
    .answer-strip {
      background: var(--cream-light);
      padding: 42px 24px;
    }

    .answer-box {
      background: white;
      border-left: 5px solid var(--gold);
      border-radius: 0 14px 14px 0;
      padding: 24px 28px;
      box-shadow: 0 8px 26px rgba(28,38,39,0.08);
      max-width: 900px;
      margin: 0 auto;
    }

    .answer-box p {
      font-size: 17px;
      line-height: 1.8;
      color: var(--stone);
    }

    /* ─── Section header ──────────────────────────────── */
    .section-header {
      margin-bottom: 36px;
    }

    .section-tag {
      display: inline-block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 10px;
    }

    .section-title {
      font-size: clamp(26px, 4vw, 36px);
      color: var(--stone);
      margin-bottom: 10px;
    }

    .section-subtitle {
      color: var(--stone-light);
      max-width: 620px;
      font-size: 15px;
    }

    /* ─── Category blocks ─────────────────────────────── */
    .category-block {
      margin-bottom: 60px;
    }

    .category-block:last-child {
      margin-bottom: 0;
    }

    .category-head {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 20px;
      border-bottom: 2px solid var(--cream-dark);
      padding-bottom: 12px;
    }

    .category-label {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 500;
      color: var(--brand-dark);
    }

    .category-count {
      font-size: 13px;
      color: var(--stone-light);
      font-family: 'Poppins', sans-serif;
    }

    /* ─── Link cards ──────────────────────────────────── */
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
    }

    .link-card {
      background: white;
      border-radius: 16px;
      padding: 20px 22px;
      box-shadow: 0 4px 16px rgba(28,38,39,0.07);
      border: 1px solid rgba(61,92,93,0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .link-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(28,38,39,0.12);
    }

    .link-card-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--brand-dark);
      line-height: 1.4;
    }

    .link-card-meta {
      font-size: 12px;
      color: var(--stone-light);
      line-height: 1.5;
    }

    .link-card-arrow {
      margin-top: auto;
      padding-top: 8px;
      font-size: 12px;
      color: var(--brand);
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    /* ─── CTA section ─────────────────────────────────── */
    .cta-section {
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      padding: 80px 24px;
      text-align: center;
      color: white;
    }

    .cta-title {
      font-size: clamp(28px, 4vw, 40px);
      margin-bottom: 16px;
    }

    .cta-body {
      opacity: 0.9;
      max-width: 520px;
      margin: 0 auto 32px;
      font-size: 17px;
      line-height: 1.7;
    }

    .cta-actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    /* ─── Footer ──────────────────────────────────────── */
    .footer {
      background: var(--brand-darker);
      color: rgba(255,255,255,0.8);
      padding: 60px 24px 30px;
    }

    .footer-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }

    .footer-logo {
      font-family: 'Playfair Display', serif;
      font-size: 24px;
      color: white;
      margin-bottom: 16px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: rgba(255,255,255,0.7);
      font-size: 14px;
      transition: color 0.3s ease;
    }

    .footer-links a:hover { color: white; }

    .footer-copyright {
      font-size: 13px;
      opacity: 0.6;
    }

    /* ─── Responsive ──────────────────────────────────── */
    @media (max-width: 640px) {
      .hub-hero-actions,
      .cta-actions {
        flex-direction: column;
        align-items: center;
      }

      .hub-hero-actions .btn,
      .cta-actions .btn {
        width: 100%;
        max-width: 320px;
      }
    }
  </style>
</head>
