---
permalink: /stays/
eleventyExcludeFromCollections: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vacation Rentals | Seascape Vacations</title>
    <meta name="description" content="Browse direct-book vacation rentals on Anna Maria Island, Bradenton, Sarasota, and Siesta Key. Skip the OTA fees — book direct with Seascape Vacations.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ site.url }}/stays/">

    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}/stays/">
    <meta property="og:title" content="Vacation Rentals | Seascape Vacations">
    <meta property="og:description" content="Browse direct-book vacation rentals on Anna Maria Island, Bradenton, Sarasota, and Siesta Key.">
    <meta property="og:image" content="{{ site.url }}/images/seascape-og-default.jpg">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Seascape Vacations">

    {% include "partials/organization-schema.njk" %}

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Vacation Rentals | Seascape Vacations",
        "description": "Direct-book vacation rentals on Anna Maria Island, Bradenton, Sarasota, and Siesta Key, Florida.",
        "url": "{{ site.url }}/stays/",
        "publisher": {
            "@type": "Organization",
            "name": "Seascape Vacations",
            "url": "{{ site.url }}"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
            { "@type": "ListItem", "position": 2, "name": "Vacation Rentals", "item": "{{ site.url }}/stays/" }
        ]
    }
    </script>

    {% include "partials/deferred-meta-pixel.njk" %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>

    <style>
        :root {
            --brand: #5F8A8B;
            --brand-light: #7BA3A4;
            --brand-dark: #3D5C5D;
            --brand-darker: #2D4647;
            --gold: #C9A962;
            --gold-light: #E8D5A3;
            --cream: #F5EED6;
            --cream-dark: #EBE4CC;
            --stone: #3A3A3A;
            --stone-light: #595959;
            --white: #FFFFFF;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Poppins, sans-serif; background: var(--cream); color: var(--stone); }

        .nav { position: fixed; top: 0; left: 0; right: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); z-index: 1000; border-bottom: 1px solid rgba(0,0,0,0.05); }
        .nav-inner { max-width: 1100px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; }
        .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .nav-logo-text { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: var(--brand-dark); letter-spacing: 2px; line-height: 1.1; }
        .nav-logo-sub { font-size: 10px; color: var(--brand); letter-spacing: 3px; text-transform: uppercase; }
        .btn { display: inline-block; background: var(--brand); color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; transition: background 0.2s; }
        .btn:hover { background: var(--brand-dark); }
        .btn-gold { background: var(--gold); color: var(--stone); }
        .btn-gold:hover { background: #b89550; color: var(--stone); }

        .hero { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%); color: white; padding: 120px 24px 64px; text-align: center; }
        .hero-tag { display: inline-block; background: rgba(255,255,255,0.15); color: var(--gold); border: 1px solid var(--gold); border-radius: 20px; padding: 6px 18px; font-size: 13px; font-weight: 500; margin-bottom: 20px; letter-spacing: 1px; text-transform: uppercase; }
        .hero-title { font-family: 'Playfair Display', serif; font-size: clamp(32px, 5vw, 52px); margin-bottom: 20px; line-height: 1.15; }
        .hero-sub { font-size: 18px; opacity: 0.9; max-width: 600px; margin: 0 auto 32px; }
        .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

        .main-content { padding-top: 0; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
        .section { padding: 56px 0; }

        .breadcrumbs { background: white; padding: 12px 0; border-bottom: 1px solid rgba(0,0,0,0.06); }
        .breadcrumbs ol { list-style: none; display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--stone-light); flex-wrap: wrap; }
        .breadcrumbs a { color: var(--brand); text-decoration: none; }
        .breadcrumbs a:hover { text-decoration: underline; }

        .dest-section { padding: 48px 0 32px; }
        .dest-section + .dest-section { border-top: 1px solid rgba(0,0,0,0.07); }
        .dest-heading { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--brand-dark); margin-bottom: 8px; }
        .dest-count { font-size: 14px; color: var(--stone-light); margin-bottom: 28px; }

        .stays-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
        .stay-card { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); text-decoration: none; color: inherit; display: block; transition: transform 0.2s, box-shadow 0.2s; }
        .stay-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
        .stay-card-title { font-size: 16px; font-weight: 600; color: var(--brand-dark); margin-bottom: 8px; line-height: 1.3; }
        .stay-card-desc { font-size: 13px; color: var(--stone-light); line-height: 1.5; }

        .cta-section { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%); padding: 72px 24px; text-align: center; color: white; }
        .cta-title { font-family: 'Playfair Display', serif; font-size: clamp(26px, 4vw, 38px); margin-bottom: 16px; }
        .cta-sub { opacity: 0.9; max-width: 480px; margin: 0 auto 32px; }

        .footer { background: var(--brand-darker); color: rgba(255,255,255,0.8); padding: 60px 24px 30px; }
        .footer-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
        .footer-logo { font-family: 'Playfair Display', serif; font-size: 24px; color: white; margin-bottom: 16px; }
        .footer-links { display: flex; justify-content: center; gap: 24px; margin-bottom: 24px; flex-wrap: wrap; }
        .footer-links a { color: rgba(255,255,255,0.7); font-size: 14px; text-decoration: none; transition: color 0.3s; }
        .footer-links a:hover { color: white; }
        .footer-copyright { font-size: 13px; opacity: 0.6; }

        @media (max-width: 640px) {
            .hero-actions { flex-direction: column; align-items: center; }
            .stays-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="nav-inner">
            <a href="/" class="nav-logo">
                <img src="/logo-optimized.png" alt="Seascape Vacations" height="40">
                <div>
                    <div class="nav-logo-text">SEASCAPE</div>
                    <div class="nav-logo-sub">Vacations</div>
                </div>
            </a>
            <a href="/properties/" class="btn" data-track-event="catalog_book_direct_click" data-placement="stays_hub_nav">Open Direct-Book Collection</a>
        </div>
    </nav>

    <main class="main-content">
        <section class="hero">
            <div class="container">
                <div class="hero-tag">Direct Book & Save</div>
                <h1 class="hero-title">Gulf Coast Vacation Rentals</h1>
                <p class="hero-sub">Anna Maria Island, Bradenton, Sarasota, and Siesta Key — curated homes you book directly with us, not through an OTA.</p>
                <div class="hero-actions">
                    <a href="/properties/" class="btn btn-gold" data-track-event="catalog_book_direct_click" data-placement="stays_hub_hero">See All Direct-Book Homes</a>
                    <a href="#destinations" class="btn" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);">Browse by Destination</a>
                </div>
            </div>
        </section>

        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <div class="container">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><span>›</span></li>
                    <li><span aria-current="page">Vacation Rentals</span></li>
                </ol>
            </div>
        </nav>

        <div class="container" id="destinations">
            {% set destOrder = ["anna-maria-island", "bradenton", "sarasota", "siesta-key", "florida-gulf-coast"] %}
            {% set destLabels = {
                "anna-maria-island": "Anna Maria Island",
                "bradenton": "Bradenton",
                "sarasota": "Sarasota",
                "siesta-key": "Siesta Key",
                "florida-gulf-coast": "Florida Gulf Coast"
            } %}

            {% for dest in destOrder %}
                {% set destPages = [] %}
                {% for page in staysPages %}
                    {% if page.destination == dest and page.active !== false and page.noindex !== true %}
                        {% set destPages = (destPages.push(page), destPages) %}
                    {% endif %}
                {% endfor %}

                {% if destPages.length > 0 %}
                <section class="dest-section">
                    <h2 class="dest-heading">{{ destLabels[dest] }}</h2>
                    <p class="dest-count">{{ destPages.length }} search-match page{{ "s" if destPages.length != 1 }}</p>
                    <div class="stays-grid">
                        {% for page in destPages %}
                        <a href="/stays/{{ page.slug }}/" class="stay-card">
                            <div class="stay-card-title">{{ page.title }}</div>
                            <div class="stay-card-desc">{{ page.description | truncate(110) }}</div>
                        </a>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}
            {% endfor %}

            {% set ungrouped = [] %}
            {% for page in staysPages %}
                {% if page.destination === null or page.destination === undefined or (page.destination and page.destination not in destOrder) %}
                    {% if page.active !== false and page.noindex !== true %}
                        {% set ungrouped = (ungrouped.push(page), ungrouped) %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% if ungrouped.length > 0 %}
            <section class="dest-section">
                <h2 class="dest-heading">All Stays</h2>
                <p class="dest-count">{{ ungrouped.length }} page{{ "s" if ungrouped.length != 1 }}</p>
                <div class="stays-grid">
                    {% for page in ungrouped %}
                    <a href="/stays/{{ page.slug }}/" class="stay-card">
                        <div class="stay-card-title">{{ page.title }}</div>
                        <div class="stay-card-desc">{{ page.description | truncate(110) }}</div>
                    </a>
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        </div>

        <section class="cta-section">
            <div class="container">
                <h2 class="cta-title">Ready to book direct?</h2>
                <p class="cta-sub">Skip the OTA markup. Every home is bookable direct through Seascape — same home, lower total cost.</p>
                <a href="/properties/" class="btn btn-gold" style="font-size: 16px; padding: 16px 40px;" data-track-event="catalog_book_direct_click" data-placement="stays_hub_bottom_cta">Open the Full Direct-Book Collection</a>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-logo">Seascape Vacations</div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/guides/anna-maria-island-area-guide/">Anna Maria Island</a>
                <a href="/guides/bradenton-area-guide/">Bradenton</a>
                <a href="/guides/sarasota-area-guide/">Sarasota</a>
                <a href="/property-management/">Property Owners</a>
            </div>
            <div class="footer-copyright">© 2026 Seascape Vacations. All rights reserved. | Book Direct & Save</div>
        </div>
    </footer>
</body>
</html>
