---
layout: layouts/base.njk
permalink: "/properties/"
templateEngineOverride: "njk"
pageTitle: "Vacation Rentals Near Anna Maria Island | Seascape Vacations"
pageDescription: "Book direct Bradenton and Sarasota vacation rentals near Anna Maria Island. More space and private pools off-island, or Sarasota when the city is the destination."
pageImage: "https://seascape-vacations.com/images/seascape-og-default.jpg"
pageUpdated: "2026-05-17T12:00:00-04:00"
navActive: "properties"
navButtonLabel: "Book Direct"
navButtonHref: "https://book.seascape-vacations.com"
navButtonTarget: "_blank"
navButtonRel: "noopener noreferrer"
headExtra: |
  <link rel="preconnect" href="https://bookingenginecdn.hostaway.com" crossorigin>
  <link rel="dns-prefetch" href="https://bookingenginecdn.hostaway.com">
  <style>
    .ui-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 0;
      flex-shrink: 0;
    }

    .ui-icon svg {
      width: 1em;
      height: 1em;
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .catalog-hero {
      background:
        linear-gradient(135deg, rgba(45, 70, 71, 0.82) 0%, rgba(61, 92, 93, 0.68) 48%, rgba(201, 169, 98, 0.24) 100%),
        image-set(
          url('/hero-optimized.avif') type('image/avif'),
          url('/hero-optimized.webp') type('image/webp')
        ) center/cover;
      color: white;
      padding: 96px 24px 56px;
    }

    .catalog-hero-inner {
      max-width: 1180px;
      margin: 0 auto;
    }

    .catalog-shell .container {
      max-width: 1400px;
      margin: 0 auto;
    }

    .catalog-hero-copy {
      max-width: 760px;
    }

    .catalog-kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.18);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .catalog-hero h1 {
      font-size: clamp(40px, 6vw, 64px);
      line-height: 0.96;
      margin-bottom: 18px;
      color: white;
    }

    .catalog-hero p {
      max-width: 680px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 18px;
      line-height: 1.8;
    }

    .catalog-highlights {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 34px;
    }

    .catalog-highlight {
      padding: 18px 20px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(18px);
    }

    .catalog-highlight strong {
      display: block;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 8px;
      color: rgba(255, 255, 255, 0.74);
    }

    .catalog-highlight span {
      font-size: 16px;
      line-height: 1.55;
      color: white;
    }

    .catalog-shell {
      padding: 60px 24px 88px;
    }

    .catalog-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .catalog-toolbar-copy {
      max-width: 680px;
    }

    .catalog-toolbar-copy h2 {
      font-size: clamp(28px, 4vw, 40px);
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-toolbar-copy p {
      color: var(--stone-light);
      line-height: 1.8;
    }

    .catalog-toolbar-copy .section-tag {
      margin-bottom: 14px;
    }

    .catalog-toolbar-link {
      color: var(--brand);
      font-weight: 600;
    }

    .catalog-filters {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 28px;
    }

    .catalog-route-panel {
      margin-bottom: 30px;
      padding: 28px;
      border-radius: 28px;
      background: linear-gradient(135deg, rgba(95, 138, 139, 0.12), rgba(201, 169, 98, 0.14));
      border: 1px solid rgba(61, 92, 93, 0.08);
      box-shadow: 0 18px 48px rgba(28, 38, 39, 0.06);
    }

    .catalog-route-header {
      max-width: 760px;
      margin-bottom: 22px;
    }

    .catalog-route-header h3 {
      font-size: clamp(26px, 3vw, 34px);
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-route-header p {
      color: var(--stone-light);
      line-height: 1.8;
    }

    .catalog-route-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
    }

    .catalog-route-card {
      display: block;
      padding: 20px;
      border-radius: 22px;
      background: white;
      border: 1px solid rgba(61, 92, 93, 0.08);
      box-shadow: 0 10px 24px rgba(28, 38, 39, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .catalog-route-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 30px rgba(28, 38, 39, 0.1);
    }

    .catalog-route-card strong {
      display: block;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 10px;
    }

    .catalog-route-card h4 {
      font-size: 20px;
      line-height: 1.15;
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-route-card p {
      color: var(--stone-light);
      font-size: 14px;
      line-height: 1.65;
    }

    .catalog-filter {
      border: 1px solid rgba(61, 92, 93, 0.14);
      background: white;
      color: var(--stone);
      padding: 12px 18px;
      border-radius: 999px;
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .catalog-filter.active,
    .catalog-filter:hover {
      background: var(--brand);
      color: white;
      border-color: var(--brand);
      box-shadow: 0 8px 24px rgba(61, 92, 93, 0.18);
    }

    .catalog-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 28px;
    }

    .catalog-card {
      flex: 0 1 440px;
      width: min(100%, 440px);
      min-height: 100%;
      background: var(--white);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    }

    .catalog-card[hidden] {
      display: none;
    }

    .catalog-card-media {
      position: relative;
      height: 280px;
      overflow: hidden;
    }

    .catalog-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .catalog-card:hover .catalog-card-media img {
      transform: scale(1.04);
    }

    .catalog-card-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.1) 40%, transparent 60%, rgba(0, 0, 0, 0.6));
      pointer-events: none;
    }

    .catalog-card-top,
    .catalog-card-bottom {
      position: absolute;
      left: 18px;
      right: 18px;
      color: var(--white);
    }

    .catalog-card-top {
      top: 18px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: flex-start;
    }

    .catalog-card-bottom {
      bottom: 18px;
    }

    .catalog-eyebrow {
      font-size: 9.5px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 600;
      line-height: 1;
    }

    .catalog-live-pill,
    .catalog-rating-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 50px;
      color: var(--white);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      white-space: nowrap;
    }

    .catalog-live-pill {
      background: rgba(255, 255, 255, 0.2);
    }

    .catalog-live-pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50px;
      background: #7FDBA4;
      box-shadow: 0 0 0 3px rgba(127, 219, 164, 0.3);
      animation: catalogPulse 2s infinite;
      flex: 0 0 auto;
    }

    .catalog-live-pill.is-muted::before {
      background: rgba(255, 255, 255, 0.72);
      box-shadow: none;
      animation: none;
    }

    @keyframes catalogPulse {
      0% {
        box-shadow: 0 0 0 0 rgba(127, 219, 164, 0.6);
      }

      70% {
        box-shadow: 0 0 0 8px rgba(127, 219, 164, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(127, 219, 164, 0);
      }
    }

    .catalog-rating-pill {
      background: rgba(0, 0, 0, 0.4);
    }

    .catalog-rating-pill .ui-icon svg {
      width: 12px;
      height: 12px;
      fill: currentColor;
      stroke: none;
    }

    .catalog-card h3 {
      font-size: 30px;
      line-height: 1.05;
      font-weight: 500;
      margin: 0;
      color: var(--white);
      letter-spacing: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .catalog-title-link {
      color: inherit;
      text-decoration: none;
    }

    .catalog-specs {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.9);
      margin-top: 3px;
    }

    .catalog-card-body {
      padding: 22px 26px 10px;
    }

    .catalog-next {
      padding: 14px 16px;
      background: #F5FBF2;
      border-radius: 12px;
      border: 1px solid rgba(127, 219, 164, 0.35);
      margin-bottom: 16px;
    }

    .catalog-next-lbl {
      font-size: 9px;
      letter-spacing: 0.28em;
      color: #1F4733;
      margin-bottom: 4px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .catalog-next-dates {
      font-size: 15px;
      font-weight: 500;
      color: #0E3222;
    }

    .catalog-next-sub {
      font-size: 11px;
      color: #3F6B55;
      margin-top: 2px;
      line-height: 1.45;
    }

    .catalog-chips {
      display: flex;
      gap: 8px;
      font-size: 11px;
    }

    .catalog-chip {
      flex: 1;
      min-width: 0;
      text-align: center;
      padding: 9px 8px;
      background: var(--cream-light);
      border-radius: 8px;
    }

    .catalog-chip-val {
      font-family: "Playfair Display", serif;
      font-size: 20px;
      font-weight: 400;
      color: var(--brand-dark);
      line-height: 1;
    }

    .catalog-chip-val.gold {
      color: var(--gold);
    }

    .catalog-chip-lbl {
      font-size: 8.5px;
      letter-spacing: 0.28em;
      color: var(--stone-light);
      margin-top: 3px;
      font-weight: 600;
      text-transform: uppercase;
      line-height: 1.2;
    }

    .catalog-card-hairline {
      height: 1px;
      margin: 4px 26px 0;
      background: linear-gradient(90deg, transparent, rgba(201, 169, 98, 0.6), transparent);
    }

    .catalog-card-foot {
      padding: 16px 26px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
    }

    .catalog-price-lbl {
      font-size: 9px;
      letter-spacing: 0.28em;
      color: var(--stone-light);
      font-weight: 600;
      margin-bottom: 2px;
      text-transform: uppercase;
    }

    .catalog-price {
      font-family: "Playfair Display", serif;
      font-size: 22px;
      font-weight: 400;
      line-height: 1;
      color: var(--stone);
    }

    .catalog-price span {
      font-size: 11px;
      font-family: "Poppins", sans-serif;
      color: var(--stone-light);
      margin-left: 4px;
    }

    .catalog-check-dates {
      flex: 0 0 auto;
      padding: 11px 22px;
      font-size: 10.5px;
      letter-spacing: 0.18em;
      white-space: nowrap;
    }

    .catalog-empty {
      display: none;
      padding: 28px;
      border-radius: 22px;
      background: white;
      border: 1px solid rgba(61, 92, 93, 0.08);
      color: var(--stone-light);
      text-align: center;
      box-shadow: 0 18px 48px rgba(28, 38, 39, 0.06);
      margin-top: 20px;
    }

    .catalog-empty.visible {
      display: block;
    }

    .catalog-owner-cta {
      margin-top: 42px;
      padding: 30px;
      border-radius: 28px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) auto;
      gap: 20px;
      align-items: center;
    }

    .catalog-owner-cta h3 {
      font-size: 32px;
      color: white;
      margin-bottom: 10px;
    }

    .catalog-owner-cta p {
      color: rgba(255, 255, 255, 0.84);
      max-width: 700px;
      line-height: 1.8;
    }

    .catalog-owner-cta .section-tag {
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 14px;
    }

    @media (max-width: 900px) {
      .catalog-highlights,
      .catalog-owner-cta {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .catalog-hero {
        padding: 42px 20px 34px;
      }

      .catalog-kicker {
        margin-bottom: 12px;
        padding: 7px 11px;
        font-size: 9.5px;
        letter-spacing: 0.16em;
      }

      .catalog-hero h1 {
        font-size: clamp(36px, 9.5vw, 40px);
        line-height: 1.02;
        margin-bottom: 12px;
      }

      .catalog-hero p {
        font-size: 15px;
        line-height: 1.5;
      }

      .catalog-shell {
        padding: 28px 18px 72px;
      }

      .catalog-toolbar {
        gap: 14px;
        margin-bottom: 14px;
      }

      .catalog-toolbar-copy .section-tag {
        margin-bottom: 10px;
      }

      .catalog-toolbar-copy h2 {
        font-size: clamp(28px, 8vw, 31px);
        line-height: 1.1;
        margin-bottom: 8px;
      }

      .catalog-toolbar-copy p {
        font-size: 15px;
        line-height: 1.45;
      }

      .catalog-toolbar-link {
        font-size: 14px;
        margin-top: 2px;
      }

      .catalog-filters {
        flex-wrap: nowrap;
        overflow-x: auto;
        margin: 0 -18px 22px;
        padding: 0 18px 8px;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }

      .catalog-filters::-webkit-scrollbar {
        display: none;
      }

      .catalog-filter {
        flex: 0 0 auto;
        padding: 10px 15px;
        white-space: nowrap;
      }

      .catalog-grid {
        justify-content: center;
        gap: 24px;
      }

      .catalog-card h3 {
        font-size: 28px;
      }

      .catalog-card-media {
        height: 252px;
      }

      .catalog-card-body,
      .catalog-card-foot {
        padding-left: 18px;
        padding-right: 18px;
      }

      .catalog-card-hairline {
        margin-left: 18px;
        margin-right: 18px;
      }

      .catalog-card-foot {
        align-items: flex-start;
        flex-direction: column;
      }

      .catalog-check-dates {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
---
{% from "partials/ui-icon.njk" import uiIcon %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Properties", "item": "{{ site.url }}/properties/" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Seascape Vacations Properties",
  "description": "Private-pool vacation rentals in Bradenton and Sarasota, including near-AMI options from Seascape Vacations.",
  "numberOfItems": {{ properties | length }},
  "itemListElement": [
    {% for property in properties %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "url": "{{ site.url }}{{ property.pageUrl }}",
      "name": "{{ property.name }}",
      "description": "{{ property.description | stripHtml | escape }}",
      "image": "{{ property.image | imgProxy(1200) }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><span>></span></li>
    <li><span aria-current="page">Properties</span></li>
  </ol>
</nav>

<section class="catalog-hero">
  <div class="catalog-hero-inner">
    <div class="catalog-hero-copy">
      <span class="catalog-kicker">Seascape Collection</span>
      <h1>Vacation rentals near Anna Maria Island with more space and easier beach days.</h1>
      <p>
        These homes are in Bradenton and Sarasota, not on Anna Maria Island itself. Choose them when you want more space, private pools, and lower-fee direct booking without pretending every stay is on-island.
      </p>
      <div class="catalog-highlights" aria-label="Properties page quick answer">
        <div class="catalog-highlight">
          <strong>Best fit</strong>
          <span>Choose Bradenton when AMI beach access matters most and you want better pool-home value.</span>
        </div>
        <div class="catalog-highlight">
          <strong>Tradeoff</strong>
          <span>These are off-island or city-base homes, so you give up walk-out beach claims and gain space, pricing, and easier logistics.</span>
        </div>
        <div class="catalog-highlight">
          <strong>Next move</strong>
          <span>Start with Bradenton near beaches, Sarasota with a pool, or book direct when one of those priorities leads the trip.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="catalog-shell">
  <div class="container">
    <div class="catalog-toolbar">
      <div class="catalog-toolbar-copy">
        <p class="section-tag">Our Collection</p>
        <h2 id="catalog-heading">Pick the right base, then check live dates.</h2>
        <p id="catalog-copy">
          Bradenton is the better lane when you want easier Anna Maria Island beach days. Sarasota is the better lane when the city is the destination and a pool-home setup still matters.
        </p>
      </div>
      <a class="catalog-toolbar-link" href="/guides/">Explore local guides →</a>
    </div>

    <section class="catalog-route-panel" aria-label="Explore by trip type">
      <div class="catalog-route-header">
        <p class="section-tag">Explore by Trip Type</p>
      <h3>Looking for something specific?</h3>
        <p>
          Choose Bradenton when Anna Maria Island beach access matters most, Sarasota when the city is part of the trip, or the book-direct route when avoiding Airbnb and Vrbo fees matters most.
        </p>
      </div>
      <div class="catalog-route-grid">
        <a
          class="catalog-route-card"
          href="/stays/book-direct-anna-maria-island/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Book Direct Near AMI"
        >
          <strong>Fee-first</strong>
          <h4>Book direct near AMI</h4>
          <p>Bradenton-based homes with lower-fee direct booking and easier access to Anna Maria Island beach days.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/anna-maria-island-vacation-rentals/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Anna Maria Island Vacation Rentals"
        >
          <strong>Near-island</strong>
          <h4>Near Anna Maria Island stays</h4>
          <p>Homes that keep AMI beach days easy without pretending they sit on the island.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/bradenton-vacation-rentals-near-beaches/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Bradenton Near Beaches"
        >
          <strong>Value base</strong>
          <h4>Bradenton near beaches</h4>
          <p>More space, easier parking, and better pool-home value than tighter on-island inventory.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/sarasota-vacation-rentals-with-pool/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Sarasota Pool Homes"
        >
          <strong>City-first</strong>
          <h4>Sarasota pool homes</h4>
          <p>Downtown location, private pool, and about 10 minutes to Lido Key or Siesta Key.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/last-minute-vacation-rentals-florida/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Last-Minute Openings"
        >
          <strong>Fast escape</strong>
          <h4>Last-minute openings</h4>
          <p>Current Gulf Coast availability for short booking windows when dates matter more than route research.</p>
        </a>
      </div>
    </section>

    <div class="catalog-filters" aria-label="Property filters">
      <button class="catalog-filter active" type="button" data-filter="all">All stays</button>
      <button class="catalog-filter" type="button" data-filter="waterfront">Waterfront</button>
      <button class="catalog-filter" type="button" data-filter="pool">Private Pool</button>
      <button class="catalog-filter" type="button" data-filter="hot-tub">Hot Tub</button>
      <button class="catalog-filter" type="button" data-filter="pet-friendly">Pet Friendly</button>
      <button class="catalog-filter" type="button" data-filter="bradenton">Near AMI</button>
      <button class="catalog-filter" type="button" data-filter="sarasota">Sarasota</button>
    </div>

    <div class="catalog-grid" id="catalog-grid">
      {% for property in properties %}
      {% set filterTokens = ((property.amenities or []) | join('|') ~ '|' ~ property.destination ~ '|' ~ property.city ~ '|' ~ property.slug) | lower %}
      {% if property.slug == "dockside-dreams" %}
        {% set primaryTag = "Waterfront" %}
      {% elif property.slug == "the-oasis" %}
        {% set primaryTag = "Sleeps 16" %}
      {% elif property.slug == "sarasota-luxe" %}
        {% set primaryTag = "Downtown Sarasota" %}
      {% elif property.slug == "river-house" %}
        {% set primaryTag = "Guest Favorite" %}
      {% elif property.slug == "bradenton-pool-home" %}
        {% set primaryTag = "Near IMG" %}
      {% else %}
        {% set primaryTag = property.city %}
      {% endif %}
      {% set availability = property.availability %}
      {% set bookingHref = property.bookingUrl or property.pageUrl + '#check-availability' %}
      {% if availability and availability.nextAvailable and property.bookingUrl %}
        {% set bookingSeparator = "?" %}
        {% if "?" in bookingHref %}
          {% set bookingSeparator = "&" %}
        {% endif %}
        {% set bookingHref = bookingHref ~ bookingSeparator ~ "startingDate=" ~ availability.nextAvailable.startDate ~ "&endingDate=" ~ availability.nextAvailable.endDate %}
      {% endif %}
      {% if loop.first %}
        {% set loading = "eager" %}
        {% set fetchpriority = "high" %}
      {% else %}
        {% set loading = "lazy" %}
        {% set fetchpriority = "" %}
      {% endif %}
      <article class="catalog-card" data-filters="{{ filterTokens }}" data-max-guests="{{ property.guests }}">
        <div class="catalog-card-media">
          <img
            src="{{ property.image | imgProxy(900) }}"
            srcset="{{ property.image | imgProxy(500) }} 500w, {{ property.image | imgProxy(900) }} 900w, {{ property.image | imgProxy(1200) }} 1200w"
            sizes="(min-width: 1180px) 440px, (min-width: 768px) 50vw, 100vw"
            alt="{{ property.name }} - {{ property.specs }} vacation rental in {{ property.city }}, Florida"
            loading="{{ loading }}"
            {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
            decoding="async"
            width="900"
            height="620"
            onerror="this.onerror=null;this.src='/images/seascape-og-default.jpg';this.srcset='';">
          <div class="catalog-card-scrim"></div>
          <div class="catalog-card-top">
            <span class="catalog-eyebrow catalog-live-pill{% if not (availability and availability.nextAvailable) %} is-muted{% endif %}">
              {% if availability and availability.nextAvailable %}Availability · live{% else %}Calendar · secure{% endif %}
            </span>
            <span class="catalog-eyebrow catalog-rating-pill">{{ uiIcon('star') }} <span>{{ property.rating }}</span></span>
          </div>
          <div class="catalog-card-bottom">
            <h3>
              <a
                class="catalog-title-link"
                href="{{ property.pageUrl }}"
                aria-label="View {{ property.name }} details"
                data-track-event="catalog_view_details_click"
                data-page-slug="{{ property.slug }}"
                data-placement="catalog_card_title"
                data-track-label="{{ property.name }}"
              >{{ property.name }}</a>
            </h3>
            <div class="catalog-specs">{{ property.city }}, FL · {{ property.bedrooms }} BR · {{ property.bathrooms }} BA · Sleeps {{ property.guests }}</div>
          </div>
        </div>
        <div class="catalog-card-body">
          <div class="catalog-next">
            {% if availability and availability.nextAvailable %}
            <div class="catalog-next-lbl">Next available</div>
            <div class="catalog-next-dates">{{ availability.nextAvailable.label }}</div>
            <div class="catalog-next-sub">{{ availability.nextAvailable.subcopy }}</div>
            {% else %}
            <div class="catalog-next-lbl">Live calendar</div>
            <div class="catalog-next-dates">Check available dates</div>
            <div class="catalog-next-sub">Real-time rates and minimum stays open on the secure booking page.</div>
            {% endif %}
          </div>
          {% if availability and availability.nextAvailable %}
          <div class="catalog-chips" aria-label="{{ property.name }} availability details">
            {% for month in availability.monthNights %}
            <div class="catalog-chip">
              <div class="catalog-chip-val">{{ month.value }}</div>
              <div class="catalog-chip-lbl">{{ month.label }}</div>
            </div>
            {% endfor %}
            <div class="catalog-chip">
              <div class="catalog-chip-val gold">{{ availability.weekendsLeft }}</div>
              <div class="catalog-chip-lbl">Weekends left</div>
            </div>
          </div>
          {% else %}
          <div class="catalog-chips" aria-label="{{ property.name }} listing details">
            <div class="catalog-chip">
              <div class="catalog-chip-val">{{ property.bedrooms }}</div>
              <div class="catalog-chip-lbl">Bedrooms</div>
            </div>
            <div class="catalog-chip">
              <div class="catalog-chip-val">{{ property.bathrooms }}</div>
              <div class="catalog-chip-lbl">Baths</div>
            </div>
            <div class="catalog-chip">
              <div class="catalog-chip-val gold">{{ property.guests }}</div>
              <div class="catalog-chip-lbl">Sleeps</div>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="catalog-card-hairline"></div>
        <div class="catalog-card-foot">
          <div>
            <div class="catalog-price-lbl">Direct from</div>
            <div class="catalog-price">${{ property.price }}<span>/ night</span></div>
          </div>
          <a
            class="btn btn-brand catalog-check-dates"
            href="{{ bookingHref }}"
            data-track-event="catalog_book_direct_click"
            data-page-slug="{{ property.slug }}"
            data-placement="catalog_card"
            data-track-label="{{ property.name }}"
            {% if property.bookingUrl %}target="_blank" rel="noopener noreferrer"{% endif %}
          >Check Dates</a>
        </div>
      </article>
      {% endfor %}
    </div>

    <div class="catalog-empty" id="catalog-empty">
      No homes match that filter. Reset to <strong>All stays</strong>.
    </div>
  </div>
</section>

<script>
  (function () {
    const buttons = Array.from(document.querySelectorAll(".catalog-filter"));
    const cards = Array.from(document.querySelectorAll(".catalog-card"));
    const emptyState = document.getElementById("catalog-empty");
    const heading = document.getElementById("catalog-heading");
    const copy = document.getElementById("catalog-copy");
    const params = new URLSearchParams(window.location.search);
    const requestedArea = (params.get("area") || "").toLowerCase();
    const areaFilterMap = {
      "anna-maria-island": "bradenton",
      "ami": "bradenton",
      "bradenton": "bradenton",
      "sarasota": "sarasota"
    };
    const filterUrlMap = {
      bradenton: "anna-maria-island",
      sarasota: "sarasota"
    };
    const filterCopy = {
      all: {
        heading: "Pick the right base, then check live dates.",
        body: "Use Bradenton when Anna Maria Island beach access matters most. Use Sarasota when the city is the destination and the pool-home setup still matters."
      },
      bradenton: {
        heading: "Bradenton homes near Anna Maria Island, with easier beach-day logistics.",
        body: "These homes are off-island, but they usually make more sense when you want better pool-home value, easier parking, and a shorter drive to AMI beaches."
      },
      sarasota: {
        heading: "Sarasota stays for travelers who want the city first and the coast second.",
        body: "Use this when Sarasota is the destination: restaurants, arts, and a cleaner downtown-to-beach drive."
      }
    };

    function setActiveButton(filter) {
      buttons.forEach((button) => {
        button.classList.toggle("active", (button.dataset.filter || "all") === filter);
      });
    }

    function updateCopy(filter) {
      const content = filterCopy[filter] || filterCopy.all;
      if (heading) heading.textContent = content.heading;
      if (copy) copy.textContent = content.body;
    }

    function syncAreaParam(filter) {
      const url = new URL(window.location.href);
      const nextArea = filterUrlMap[filter];

      if (nextArea) {
        url.searchParams.set("area", nextArea);
      } else {
        url.searchParams.delete("area");
      }

      history.replaceState({}, "", `${url.pathname}${url.search}`);
    }

    // Pull arrive/depart/guests from the URL and propagate them into
    // (a) the Hostaway "Book Direct" links so dates carry through, and
    // (b) a guests filter that hides cards whose max occupancy is too low.
    const requestedArrive = (params.get("arrive") || "").trim();
    const requestedDepart = (params.get("depart") || "").trim();
    const requestedGuests = parseInt(params.get("guests") || "", 10) || 0;

    function cardMaxGuests(card) {
      return parseInt(card.dataset.maxGuests || "0", 10) || 0;
    }

    function decorateBookDirectLinks() {
      if (!requestedArrive && !requestedDepart && !requestedGuests) return;
      cards.forEach((card) => {
        const link = card.querySelector('a[data-track-event="catalog_book_direct_click"]');
        if (!link) return;
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("https://book.seascape-vacations.com/listings/")) return;
        const url = new URL(href);
        if (requestedArrive) url.searchParams.set("startingDate", requestedArrive);
        if (requestedDepart) url.searchParams.set("endingDate", requestedDepart);
        if (requestedGuests) url.searchParams.set("numberOfGuests", String(requestedGuests));
        link.setAttribute("href", url.toString());
      });
    }
    decorateBookDirectLinks();

    function applyFilter(filter, { sync = false } = {}) {
      let visibleCount = 0;

      cards.forEach((card) => {
        const haystack = (card.dataset.filters || "").toLowerCase();
        let matches = filter === "all" || haystack.includes(filter);
        if (matches && requestedGuests && cardMaxGuests(card) < requestedGuests) {
          matches = false;
        }
        card.hidden = !matches;
        if (matches) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.classList.toggle("visible", visibleCount === 0);
      }

      setActiveButton(filter);
      updateCopy(filter);

      if (sync) {
        syncAreaParam(filter);
      }
    }

    function resolveInitialFilter() {
      if (!requestedArea) {
        return "all";
      }

      if (requestedArea.includes("anna-maria-island") || requestedArea.includes("ami")) {
        return "bradenton";
      }

      if (requestedArea.includes("sarasota")) {
        return "sarasota";
      }

      const exactMatch = buttons.find((button) => (button.dataset.filter || "").toLowerCase() === requestedArea);
      return exactMatch ? requestedArea : "all";
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        applyFilter(button.dataset.filter || "all", { sync: true });
      });
    });

    const initialFilter = resolveInitialFilter();
    applyFilter(initialFilter);

    if (requestedArea.length > 0) {
      syncAreaParam(initialFilter);
    }
  })();
</script>
