---
layout: layouts/base.njk
permalink: "/properties/"
templateEngineOverride: "njk"
pageTitle: "Direct Booking Vacation Rentals Near Anna Maria Island & Sarasota | Seascape Vacations"
pageDescription: "Browse direct-booking vacation rentals near Anna Maria Island and in Sarasota with private pools, local support, and fast paths into live availability."
pageImage: "https://seascape-vacations.com/images/seascape-og-default.jpg"
pageUpdated: "2026-03-17T17:45:00-04:00"
navActive: "properties"
navButtonLabel: "Book Direct"
navButtonHref: "https://book.seascape-vacations.com"
navButtonTarget: "_blank"
navButtonRel: "noopener noreferrer"
headExtra: |
  <link rel="preconnect" href="https://bookingenginecdn.hostaway.com" crossorigin>
  <link rel="dns-prefetch" href="https://bookingenginecdn.hostaway.com">
  <style>
    .ui-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 0;
      flex-shrink: 0;
    }

    .ui-icon svg {
      width: 1em;
      height: 1em;
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .catalog-hero {
      background:
        linear-gradient(135deg, rgba(45, 70, 71, 0.82) 0%, rgba(61, 92, 93, 0.68) 48%, rgba(201, 169, 98, 0.24) 100%),
        image-set(
          url('/hero-optimized.avif') type('image/avif'),
          url('/hero-optimized.webp') type('image/webp')
        ) center/cover;
      color: white;
      padding: 112px 24px 84px;
    }

    .catalog-hero-inner,
    .catalog-shell .container {
      max-width: 1180px;
      margin: 0 auto;
    }

    .catalog-hero-copy {
      max-width: 760px;
    }

    .catalog-kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.18);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .catalog-hero h1 {
      font-size: clamp(40px, 6vw, 64px);
      line-height: 0.96;
      margin-bottom: 18px;
      color: white;
    }

    .catalog-hero p {
      max-width: 680px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 18px;
      line-height: 1.8;
    }

    .catalog-highlights {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 34px;
    }

    .catalog-highlight {
      padding: 18px 20px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(18px);
    }

    .catalog-highlight strong {
      display: block;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 8px;
      color: rgba(255, 255, 255, 0.74);
    }

    .catalog-highlight span {
      font-size: 16px;
      line-height: 1.55;
      color: white;
    }

    .catalog-shell {
      padding: 60px 24px 88px;
    }

    .catalog-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .catalog-toolbar-copy {
      max-width: 680px;
    }

    .catalog-toolbar-copy h2 {
      font-size: clamp(28px, 4vw, 40px);
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-toolbar-copy p {
      color: var(--stone-light);
      line-height: 1.8;
    }

    .catalog-toolbar-copy .section-tag {
      margin-bottom: 14px;
    }

    .catalog-toolbar-link {
      color: var(--brand);
      font-weight: 600;
    }

    .catalog-filters {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }

    .catalog-route-panel {
      margin-bottom: 30px;
      padding: 28px;
      border-radius: 28px;
      background: linear-gradient(135deg, rgba(95, 138, 139, 0.12), rgba(201, 169, 98, 0.14));
      border: 1px solid rgba(61, 92, 93, 0.08);
      box-shadow: 0 18px 48px rgba(28, 38, 39, 0.06);
    }

    .catalog-route-header {
      max-width: 760px;
      margin-bottom: 22px;
    }

    .catalog-route-header h3 {
      font-size: clamp(26px, 3vw, 34px);
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-route-header p {
      color: var(--stone-light);
      line-height: 1.8;
    }

    .catalog-route-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
    }

    .catalog-route-card {
      display: block;
      padding: 20px;
      border-radius: 22px;
      background: white;
      border: 1px solid rgba(61, 92, 93, 0.08);
      box-shadow: 0 10px 24px rgba(28, 38, 39, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .catalog-route-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 30px rgba(28, 38, 39, 0.1);
    }

    .catalog-route-card strong {
      display: block;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 10px;
    }

    .catalog-route-card h4 {
      font-size: 20px;
      line-height: 1.15;
      margin-bottom: 10px;
      color: var(--stone);
    }

    .catalog-route-card p {
      color: var(--stone-light);
      font-size: 14px;
      line-height: 1.65;
    }

    .catalog-filter {
      border: 1px solid rgba(61, 92, 93, 0.14);
      background: white;
      color: var(--stone);
      padding: 12px 18px;
      border-radius: 999px;
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .catalog-filter.active,
    .catalog-filter:hover {
      background: var(--brand);
      color: white;
      border-color: var(--brand);
      box-shadow: 0 8px 24px rgba(61, 92, 93, 0.18);
    }

    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
    }

    .catalog-card {
      position: relative;
      min-height: 540px;
      border-radius: 28px;
      overflow: hidden;
      border: 1px solid rgba(61, 92, 93, 0.08);
      box-shadow: 0 18px 48px rgba(28, 38, 39, 0.1);
      background: linear-gradient(135deg, rgba(95, 138, 139, 0.18), rgba(201, 169, 98, 0.22));
      display: flex;
      align-items: stretch;
      isolation: isolate;
    }

    .catalog-card[hidden] {
      display: none;
    }

    .catalog-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
      z-index: -2;
    }

    .catalog-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(10, 14, 14, 0.04) 0%, rgba(10, 14, 14, 0.10) 20%, rgba(10, 14, 14, 0.42) 55%, rgba(10, 14, 14, 0.82) 80%, rgba(10, 14, 14, 0.92) 100%);
      z-index: -1;
    }

    .catalog-card:hover img {
      transform: scale(1.04);
    }

    .catalog-card-inner {
      width: 100%;
      min-height: 100%;
      padding: 22px 22px 24px;
      display: grid;
      grid-template-rows: auto auto auto auto auto 1fr auto;
      align-content: end;
      gap: 12px;
      color: white;
    }

    .catalog-pill-row {
      position: absolute;
      top: 16px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .catalog-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.9);
      color: var(--stone);
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.08);
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
    }

    .catalog-rating {
      background: rgba(33, 48, 49, 0.86);
      color: white;
    }

    .catalog-rating .ui-icon svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
      stroke: none;
    }

    .catalog-location {
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.85);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    }

    .catalog-card h3 {
      font-size: clamp(28px, 3.2vw, 42px);
      line-height: 1;
      color: white;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 1.9em;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .catalog-specs {
      font-size: 15px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.86);
    }

    .catalog-copy {
      color: rgba(255, 255, 255, 0.88);
      font-size: 15px;
      line-height: 1.7;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 76px;
    }

    .catalog-feature-list {
      display: grid;
      gap: 10px;
    }

    .catalog-feature {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.92);
    }

    .catalog-feature .ui-icon {
      color: var(--gold-light);
      font-size: 14px;
    }

    .catalog-actions {
      display: flex;
      gap: 12px;
    }

    .catalog-actions .btn,
    .catalog-secondary {
      padding: 14px 22px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      text-align: center;
      white-space: nowrap;
    }

    .catalog-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.06);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.34);
      backdrop-filter: blur(14px);
    }

    .catalog-empty {
      display: none;
      padding: 28px;
      border-radius: 22px;
      background: white;
      border: 1px solid rgba(61, 92, 93, 0.08);
      color: var(--stone-light);
      text-align: center;
      box-shadow: 0 18px 48px rgba(28, 38, 39, 0.06);
      margin-top: 20px;
    }

    .catalog-empty.visible {
      display: block;
    }

    .catalog-owner-cta {
      margin-top: 42px;
      padding: 30px;
      border-radius: 28px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) auto;
      gap: 20px;
      align-items: center;
    }

    .catalog-owner-cta h3 {
      font-size: 32px;
      color: white;
      margin-bottom: 10px;
    }

    .catalog-owner-cta p {
      color: rgba(255, 255, 255, 0.84);
      max-width: 700px;
      line-height: 1.8;
    }

    .catalog-owner-cta .section-tag {
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 14px;
    }

    @media (max-width: 900px) {
      .catalog-highlights,
      .catalog-owner-cta {
        grid-template-columns: 1fr;
      }

      .catalog-card {
        min-height: 500px;
      }
    }

    @media (max-width: 680px) {
      .catalog-hero {
        padding-top: 96px;
      }

      .catalog-card {
        min-height: 440px;
      }

      .catalog-card-inner {
        padding: 16px 16px 18px;
      }

      .catalog-card h3 {
        font-size: 28px;
        line-height: 1;
      }

      .catalog-specs,
      .catalog-copy,
      .catalog-feature {
        font-size: 14px;
      }

      .catalog-copy {
        -webkit-line-clamp: 2;
        min-height: auto;
      }

      .catalog-feature-list {
        gap: 8px;
      }

      .catalog-feature:nth-child(n + 3) {
        display: none;
      }

      .catalog-actions {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .catalog-actions .btn,
      .catalog-secondary {
        padding: 11px 16px;
      }
    }
  </style>
---
{% from "partials/ui-icon.njk" import uiIcon %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Properties", "item": "{{ site.url }}/properties/" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Seascape Vacations Properties",
  "description": "Luxury vacation rentals in Bradenton and Sarasota from Seascape Vacations.",
  "numberOfItems": {{ properties | length }},
  "itemListElement": [
    {% for property in properties %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "url": "{{ site.url }}{{ property.pageUrl }}",
      "name": "{{ property.name }}",
      "description": "{{ property.description | stripHtml | escape }}",
      "image": "{{ property.image | imgProxy(1200) }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><span>></span></li>
    <li><span aria-current="page">Properties</span></li>
  </ol>
</nav>

<section class="catalog-hero" style="padding:96px 24px 56px">
  <div class="catalog-hero-inner">
    <div class="catalog-hero-copy">
      <span class="catalog-kicker">Seascape Collection</span>
      <h1>Luxury Gulf Coast vacation rentals for direct booking.</h1>
      <p>
        5 private-pool homes in Bradenton and Sarasota. Book direct and save 10-15% vs. Airbnb and VRBO.
      </p>
    </div>
  </div>
</section>

<section class="catalog-shell">
  <div class="container">
    <div class="catalog-toolbar">
      <div class="catalog-toolbar-copy">
        <p class="section-tag">Our Collection</p>
        <h2 id="catalog-heading">Pick the right home fast, then move straight into direct dates.</h2>
        <p id="catalog-copy">
          Every home has a private pool, full kitchen, and local host team. Use the filters or scroll to find your fit.
        </p>
      </div>
      <a class="catalog-toolbar-link" href="/guides/">Explore local guides →</a>
    </div>

    <div class="catalog-filters" aria-label="Property filters">
      <button class="catalog-filter active" type="button" data-filter="all">All stays</button>
      <button class="catalog-filter" type="button" data-filter="waterfront">Waterfront</button>
      <button class="catalog-filter" type="button" data-filter="pool">Private Pool</button>
      <button class="catalog-filter" type="button" data-filter="hot-tub">Hot Tub</button>
      <button class="catalog-filter" type="button" data-filter="pet-friendly">Pet Friendly</button>
      <button class="catalog-filter" type="button" data-filter="bradenton">Near AMI</button>
      <button class="catalog-filter" type="button" data-filter="sarasota">Sarasota</button>
    </div>

    <div class="catalog-grid" id="catalog-grid">
      {% for property in properties %}
      {% set filterTokens = ((property.amenities or []) | join('|') ~ '|' ~ property.destination ~ '|' ~ property.city ~ '|' ~ property.slug) | lower %}
      {% if property.slug == "dockside-dreams" %}
        {% set primaryTag = "Waterfront" %}
      {% elif property.slug == "the-oasis" %}
        {% set primaryTag = "Sleeps 16" %}
      {% elif property.slug == "sarasota-luxe" %}
        {% set primaryTag = "Downtown Sarasota" %}
      {% elif property.slug == "river-house" %}
        {% set primaryTag = "Guest Favorite" %}
      {% elif property.slug == "bradenton-pool-home" %}
        {% set primaryTag = "Near IMG" %}
      {% else %}
        {% set primaryTag = property.city %}
      {% endif %}
      {% set bookingHref = property.bookingUrl or property.pageUrl + '#check-availability' %}
      {% if loop.first %}
        {% set loading = "eager" %}
        {% set fetchpriority = "high" %}
      {% else %}
        {% set loading = "lazy" %}
        {% set fetchpriority = "" %}
      {% endif %}
      <article class="catalog-card" data-filters="{{ filterTokens }}">
        <img
          src="{{ property.image | imgProxy(900) }}"
          srcset="{{ property.image | imgProxy(500) }} 500w, {{ property.image | imgProxy(900) }} 900w, {{ property.image | imgProxy(1200) }} 1200w"
          sizes="(min-width: 1100px) 33vw, (min-width: 768px) 50vw, 100vw"
          alt="{{ property.name }} - {{ property.specs }} vacation rental in {{ property.city }}, Florida"
          loading="{{ loading }}"
          {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
          decoding="async"
          width="900"
          height="620"
          onerror="this.onerror=null;this.src='/images/seascape-og-default.jpg';this.srcset='';">
        <div class="catalog-pill-row">
          <span class="catalog-pill">{{ primaryTag }}</span>
          <span class="catalog-pill catalog-rating">{{ uiIcon('star') }} <span>{{ property.rating }}</span></span>
        </div>
        <div class="catalog-card-inner">
          <p class="catalog-location">{{ property.city }}, Florida</p>
          <h3>{{ property.name }}</h3>
          <p class="catalog-specs">{{ property.specs }}</p>
          <p class="catalog-copy">{{ property.description }}</p>
          <div class="catalog-feature-list">
            {% for highlight in property.highlights %}
              {% if loop.index <= 3 %}
              <span class="catalog-feature">{{ uiIcon('check') }} <span>{{ highlight }}</span></span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="catalog-actions">
            <a
              class="btn btn-gold catalog-booking-link"
              href="{{ bookingHref }}"
              data-booking-url="{{ bookingHref }}"
              data-track-event="catalog_book_direct_click"
              data-page-slug="{{ property.slug }}"
              data-placement="catalog_card"
              data-track-label="{{ property.name }}"
              {% if property.bookingUrl %}target="_blank" rel="noopener noreferrer"{% endif %}
            >Book Direct</a>
            <a
              class="catalog-secondary"
              href="{{ property.pageUrl }}"
              data-track-event="catalog_view_details_click"
              data-page-slug="{{ property.slug }}"
              data-placement="catalog_card"
              data-track-label="{{ property.name }}"
            >View Details</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>

    <div class="catalog-empty" id="catalog-empty">
      No homes match that filter right now. Reset to <strong>All stays</strong> instead of assuming the collection disappeared.
    </div>

    <section class="catalog-route-panel" aria-label="Explore by trip type" style="margin-top:48px">
      <div class="catalog-route-header">
        <p class="section-tag">Explore by Trip Type</p>
        <h3>Looking for something specific?</h3>
        <p>
          Browse curated stay collections by trip type — each page matches you with the right home for your goals.
        </p>
      </div>
      <div class="catalog-route-grid">
        <a
          class="catalog-route-card"
          href="/stays/book-direct-anna-maria-island/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Book Direct Near AMI"
        >
          <strong>Fee-first</strong>
          <h4>Book direct near AMI</h4>
          <p>Skip Airbnb and Vrbo fees — same homes, lower total.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/anna-maria-island-vacation-rentals/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Anna Maria Island Vacation Rentals"
        >
          <strong>Island-first</strong>
          <h4>Anna Maria Island stays</h4>
          <p>Homes near the island with direct booking savings.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/bradenton-vacation-rentals-near-beaches/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Bradenton Near Beaches"
        >
          <strong>Value base</strong>
          <h4>Bradenton near beaches</h4>
          <p>More space and better pool-home value than on-island inventory.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/sarasota-vacation-rentals-with-pool/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Sarasota Pool Homes"
        >
          <strong>Sarasota</strong>
          <h4>Sarasota pool homes</h4>
          <p>Downtown Sarasota location with resort-style amenities.</p>
        </a>
        <a
          class="catalog-route-card"
          href="/stays/last-minute-vacation-rentals-florida/"
          data-track-event="catalog_collection_click"
          data-placement="catalog_route_card"
          data-track-label="Last-Minute Openings"
        >
          <strong>Fast escape</strong>
          <h4>Last-minute openings</h4>
          <p>Current Gulf Coast availability for short booking windows.</p>
        </a>
      </div>
    </section>
  </div>
</section>

<script>
  (function () {
    const buttons = Array.from(document.querySelectorAll(".catalog-filter"));
    const cards = Array.from(document.querySelectorAll(".catalog-card"));
    const emptyState = document.getElementById("catalog-empty");
    const heading = document.getElementById("catalog-heading");
    const copy = document.getElementById("catalog-copy");
    const params = new URLSearchParams(window.location.search);
    const requestedArea = (params.get("area") || "").toLowerCase();
    const requestedCheckin = normalizeDateParam(params.get("checkin") || "");
    const requestedCheckout = normalizeDateParam(params.get("checkout") || "");
    const requestedGuests = /^\d+$/.test(params.get("guests") || "") ? params.get("guests") : "";
    const areaFilterMap = {
      "anna-maria-island": "bradenton",
      "ami": "bradenton",
      "bradenton": "bradenton",
      "sarasota": "sarasota"
    };
    const filterUrlMap = {
      bradenton: "anna-maria-island",
      sarasota: "sarasota"
    };
    const filterCopy = {
      all: {
        heading: "Pick the right home fast, then move straight into direct dates.",
        body: "Use the filters to cut to the right fit, then choose between the fast path into direct booking or the property page if you need one more look before committing."
      },
      bradenton: {
        heading: "Near Anna Maria Island stays with the fastest path into direct dates.",
        body: "Use this when you want Bradenton-based homes that still keep Anna Maria Island, the beaches, and group-trip logistics easy."
      },
      sarasota: {
        heading: "Sarasota stays for travelers who want a cleaner downtown-to-coast setup.",
        body: "Use this when Sarasota is the real destination and you want to move straight from comparison into live availability."
      }
    };

    function normalizeDateParam(value) {
      return /^\d{4}-\d{2}-\d{2}$/.test(value || "") ? value : "";
    }

    function syncBookingLinks() {
      const bookingLinks = Array.from(document.querySelectorAll(".catalog-booking-link[data-booking-url]"));

      bookingLinks.forEach((link) => {
        const rawHref = link.dataset.bookingUrl || link.getAttribute("href") || "";
        if (!rawHref) return;

        let nextUrl;
        try {
          nextUrl = new URL(rawHref, window.location.origin);
        } catch (error) {
          return;
        }

        if (requestedCheckin) {
          nextUrl.searchParams.set("checkin", requestedCheckin);
        }

        if (requestedCheckout) {
          nextUrl.searchParams.set("checkout", requestedCheckout);
        }

        link.href = nextUrl.origin === window.location.origin
          ? `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`
          : nextUrl.toString();

        if (requestedCheckin || requestedCheckout || requestedGuests) {
          link.dataset.searchState = JSON.stringify({
            checkin: requestedCheckin,
            checkout: requestedCheckout,
            guests: requestedGuests
          });
        }
      });
    }

    function setActiveButton(filter) {
      buttons.forEach((button) => {
        button.classList.toggle("active", (button.dataset.filter || "all") === filter);
      });
    }

    function updateCopy(filter) {
      const content = filterCopy[filter] || filterCopy.all;
      if (heading) heading.textContent = content.heading;
      if (copy) copy.textContent = content.body;
    }

    function syncAreaParam(filter) {
      const url = new URL(window.location.href);
      const nextArea = filterUrlMap[filter];

      if (nextArea) {
        url.searchParams.set("area", nextArea);
      } else {
        url.searchParams.delete("area");
      }

      history.replaceState({}, "", `${url.pathname}${url.search}`);
    }

    function applyFilter(filter, { sync = false } = {}) {
      let visibleCount = 0;

      cards.forEach((card) => {
        const haystack = (card.dataset.filters || "").toLowerCase();
        const matches = filter === "all" || haystack.includes(filter);
        card.hidden = !matches;
        if (matches) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.classList.toggle("visible", visibleCount === 0);
      }

      setActiveButton(filter);
      updateCopy(filter);

      if (sync) {
        syncAreaParam(filter);
      }
    }

    function resolveInitialFilter() {
      if (!requestedArea) {
        return "all";
      }

      if (requestedArea.includes("anna-maria-island") || requestedArea.includes("ami")) {
        return "bradenton";
      }

      if (requestedArea.includes("sarasota")) {
        return "sarasota";
      }

      const exactMatch = buttons.find((button) => (button.dataset.filter || "").toLowerCase() === requestedArea);
      return exactMatch ? requestedArea : "all";
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        applyFilter(button.dataset.filter || "all", { sync: true });
      });
    });

    const initialFilter = resolveInitialFilter();
    applyFilter(initialFilter);
    syncBookingLinks();

    if (requestedArea.length > 0) {
      syncAreaParam(initialFilter);
    }
  })();
</script>
