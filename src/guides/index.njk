---
permalink: "/guides/"
eleventyComputed:
  pageTitle: "Travel Guides & Local Tips"
  pageDescription: "Travel guides, local tips, and owner resources for Bradenton, Anna Maria Island, Sarasota, and Florida's Gulf Coast."
---
{% set featuredGuides = [
  { "url": "/guides/bradenton-vs-sarasota/", "label": "Bradenton vs Sarasota" },
  { "url": "/guides/anna-maria-island-vs-siesta-key/", "label": "Anna Maria Island vs Siesta Key" },
  { "url": "/guides/booking-direct-vacation-rentals/", "label": "Why Booking Direct Saves You Hundreds" },
  { "url": "/guides/hurricane-preparedness-florida-vacation/", "label": "Hurricane Preparedness for Florida Travelers" }
] %}
{% set areaGuides = [
  { "url": "/guides/anna-maria-island-area-guide/", "label": "Anna Maria Island" },
  { "url": "/guides/bradenton-area-guide/", "label": "Bradenton" },
  { "url": "/guides/bradenton-beach-area-guide/", "label": "Bradenton Beach" },
  { "url": "/guides/holmes-beach-area-guide/", "label": "Holmes Beach" },
  { "url": "/guides/longboat-key-area-guide/", "label": "Longboat Key" },
  { "url": "/guides/sarasota-area-guide/", "label": "Sarasota" },
  { "url": "/guides/siesta-key-area-guide/", "label": "Siesta Key" }
] %}
{% set planningGuides = [
  { "url": "/guides/anna-maria-island-beaches/", "label": "Ultimate Guide to Anna Maria Island Beaches" },
  { "url": "/guides/best-restaurants-anna-maria-island/", "label": "Best Restaurants Near Anna Maria Island" },
  { "url": "/guides/fishing-guide-anna-maria-sarasota/", "label": "Complete Fishing Guide: AMI, Bradenton & Sarasota" },
  { "url": "/guides/best-time-visit-anna-maria-island/", "label": "Best Time to Visit Anna Maria Island" },
  { "url": "/guides/shelling-guide-florida/", "label": "Shelling Guide: AMI, Siesta Key & Beyond" },
  { "url": "/guides/family-vacation-anna-maria-island/", "label": "Planning the Perfect Family Vacation to AMI" },
  { "url": "/guides/anna-maria-island-weather/", "label": "Anna Maria Island Weather by Month" },
  { "url": "/guides/how-to-get-to-anna-maria-island/", "label": "How to Get to Anna Maria Island" }
] %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ pageTitle }} | Seascape Vacations</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.name }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ site.url }}/guides/">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/guides/">
  <meta property="og:title" content="{{ pageTitle }} | Seascape Vacations">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ site.url }}/images/seascape-og-default.jpg">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }} | Seascape Vacations">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/images/seascape-og-default.jpg">
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"BreadcrumbList",
    "itemListElement":[
      {"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}"},
      {"@type":"ListItem","position":2,"name":"Guides","item":"{{ site.url }}/guides/"}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"CollectionPage",
    "name":"{{ pageTitle }}",
    "description":"{{ pageDescription }}",
    "url":"{{ site.url }}/guides/"
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" media="print" onload='this.media="all"'>
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"></noscript>
  <style>
    :root{--brand:#5F8A8B;--brand-dark:#3D5C5D;--gold:#C9A962;--cream:#F5EED6;--cream-light:#FAF7EE;--stone:#3A3A3A;--stone-light:#6A6A6A;--white:#FFFFFF}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:Poppins,-apple-system,sans-serif;background:var(--cream);color:var(--stone);line-height:1.7}
    h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:500;letter-spacing:-.02em}
    a{color:inherit;text-decoration:none}
    .skip-link{position:absolute;top:8px;left:8px;padding:10px 14px;background:var(--brand-dark);color:var(--white);border-radius:10px;transform:translateY(-200%);transition:transform .2s ease;z-index:100}
    .skip-link:focus{transform:translateY(0)}
    .nav{position:sticky;top:0;background:rgba(245,238,214,.98);backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,0,0,.06);z-index:10}
    .nav-inner{max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between}
    .nav-logo{display:flex;flex-direction:column}
    .nav-logo-text{font-family:'Playfair Display',serif;font-size:20px;color:var(--brand-dark);letter-spacing:.05em}
    .nav-logo-sub{font-size:9px;letter-spacing:.2em;color:var(--stone-light);text-transform:uppercase;margin-top:-2px}
    .nav-links{display:flex;gap:20px;font-weight:500;font-size:14px}
    .btn{background:linear-gradient(135deg,var(--brand) 0,var(--brand-dark) 100%);color:#fff;padding:10px 20px;border-radius:50px;font-weight:600;font-size:12px}
    .hero{max-width:1200px;margin:0 auto;padding:64px 24px 16px}
    .hero-tag{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--brand-dark);margin-bottom:12px}
    .hero-title{font-size:clamp(28px,4vw,44px);margin-bottom:12px}
    .hero-subtitle{color:var(--stone-light);max-width:760px}
    .section{max-width:1200px;margin:0 auto;padding:32px 24px}
    .section-card{background:var(--cream-light);border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:20px;box-shadow:0 6px 18px rgba(0,0,0,.06)}
    .section-title{font-size:clamp(22px,3vw,30px);margin-bottom:12px}
    .section-note{color:var(--stone-light);margin-bottom:16px}
    .link-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px 16px;list-style:none}
    .link-grid a{color:var(--brand-dark);font-weight:500}
    .link-grid a:hover{text-decoration:underline;color:var(--brand)}
    .footer{background:var(--brand-dark);color:rgba(255,255,255,.85);padding:40px 24px;margin-top:40px}
    .footer-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}
    .footer a{color:rgba(255,255,255,.85)}
    a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <span class="nav-logo-text">Seascape Vacations</span>
        <span class="nav-logo-sub">Luxury Coastal Stays</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/properties/">Stays</a>
        <a href="/property-management/">Property Owners</a>
      </div>
      <a class="btn" href="/properties/">Browse Homes</a>
    </div>
  </nav>
  <main id="main">
    <header class="hero">
      <p class="hero-tag">Travel Tips & Local Guides</p>
      <h1 class="hero-title">Seascape Guides</h1>
      <p class="hero-subtitle">Explore local area guides, vacation planning resources, and owner resources for Florida's Gulf Coast.</p>
      <p style="font-size:.85rem;color:#666;margin:.5rem 0;"><em>Updated {{ site.dateUpdated }}</em></p>
    </header>

    <section class="section" style="padding-top:0">
      <div class="section-card">
        <h2 class="section-title">Start Here</h2>
        <p class="section-note">These are the highest-value pages if you are comparing destinations, planning a direct booking, or trying to understand the market before you travel.</p>
        <ul class="link-grid">
          {% for guide in featuredGuides %}
          <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-card">
        <h2 class="section-title">Area Guides</h2>
        <ul class="link-grid">
          {% for guide in areaGuides %}
          <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-card">
        <h2 class="section-title">Travel & Local Guides</h2>
        <ul class="link-grid">
          {% for guide in planningGuides %}
          <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-card">
        <h2 class="section-title">Vacation Stay Guides</h2>
        <p class="section-note">These pages target real stay filters and property-fit questions. Pages we have intentionally rehomed or suppressed are not surfaced here.</p>
        <ul class="link-grid">
          {% for page in staysPages %}
          {% if seoGovernance.staysNoindexSlugs.indexOf(page.slug) === -1 %}
          <li><a href="/stays/{{ page.slug }}/">{{ page.title }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-card">
        <h2 class="section-title">Property Owner Resources</h2>
        <ul class="link-grid">
          {% for page in seoPages.owner %}
          <li><a href="/property-management/{{ page.slug }}/">{{ page.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>© 2026 {{ site.name }}</div>
      <div><a href="/">Home</a> · <a href="/property-management/">Property Owners</a></div>
    </div>
  </footer>

  {% include "partials/analytics-ga4.njk" %}
</body>
</html>
