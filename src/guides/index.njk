  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" media="print" onload='this.media="all"'>
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"></noscript>
  <style>
    :root {
      --brand: #5F8A8B;
      --brand-dark: #3D5C5D;
      --brand-darker: #22393A;
      --gold: #C9A962;
      --gold-light: #E8D5A3;
      --cream: #F5EED6;
      --cream-light: #FAF7EE;
      --stone: #3A3A3A;
      --stone-light: #6A6A6A;
      --white: #FFFFFF;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Poppins, -apple-system, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(232, 213, 163, 0.28), transparent 30%),
        linear-gradient(180deg, #fbf7ef 0%, #f4ecdb 100%);
      color: var(--stone);
      line-height: 1.65;
    }

    h1, h2, h3, h4 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    .skip-link {
      position: absolute;
      top: 8px;
      left: 8px;
      transform: translateY(-200%);
      background: var(--brand-darker);
      color: white;
      padding: 10px 14px;
      border-radius: 10px;
      z-index: 100;
      transition: transform .2s ease;
    }

    .skip-link:focus { transform: translateY(0); }

    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(250, 247, 238, 0.9);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .nav-inner,
    .hero,
    .section,
    .footer-inner {
      max-width: 1240px;
      margin: 0 auto;
      padding-left: 24px;
      padding-right: 24px;
    }

    {% include "partials/site-header-styles.njk" %}

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 22px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      color: white;
      font-size: 13px;
      font-weight: 700;
      box-shadow: 0 8px 22px rgba(61, 92, 93, 0.18);
    }

    .hero {
      padding-top: 112px;
      padding-bottom: 28px;
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 32px;
      align-items: end;
    }

    .hero-tag,
    .section-tag {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--brand-dark);
      margin-bottom: 14px;
    }

    .hero-title {
      font-size: clamp(38px, 6vw, 72px);
      line-height: 0.97;
      margin-bottom: 16px;
      max-width: 820px;
    }

    .hero-subtitle {
      max-width: 720px;
      font-size: 18px;
      color: var(--stone-light);
    }

    .hero-note {
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(0, 0, 0, 0.07);
      border-radius: 24px;
      padding: 24px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.05);
      backdrop-filter: blur(10px);
    }

    .hero-note strong {
      display: block;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--brand);
      margin-bottom: 12px;
    }

    .hero-note p {
      color: var(--stone);
      margin-bottom: 12px;
    }

    .hero-note small {
      color: var(--stone-light);
      font-size: 13px;
    }

    .section { padding-top: 28px; padding-bottom: 28px; }

    .feature-grid {
      display: grid;
      grid-template-columns: 1.18fr 0.82fr;
      gap: 22px;
    }

    .feature-main,
    .feature-stack-card,
    .start-card,
    .category-card,
    .utility-card {
      overflow: hidden;
      border-radius: 26px;
      border: 1px solid rgba(0, 0, 0, 0.06);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
    }

    .feature-main {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      min-height: 420px;
    }

    .feature-main-image {
      min-height: 100%;
      background-size: cover;
      background-position: center;
    }

    .feature-main-body,
    .feature-stack-card-body,
    .start-card-body,
    .category-card-body,
    .utility-card-body {
      padding: 24px;
    }

    .feature-kicker,
    .card-kicker {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--brand);
      font-weight: 700;
      margin-bottom: 10px;
    }

    .feature-main h2 {
      font-size: clamp(30px, 4vw, 44px);
      margin-bottom: 12px;
      color: var(--brand-darker);
      line-height: 1.02;
    }

    .feature-main p,
    .feature-stack-card p,
    .start-card p,
    .category-intro,
    .utility-card p {
      color: var(--stone-light);
    }

    .feature-meta {
      color: var(--stone-light);
      font-size: 13px;
      margin-top: 16px;
    }

    .feature-stack {
      display: grid;
      gap: 20px;
    }

    .feature-stack-card {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      min-height: 200px;
    }

    .feature-stack-card-image {
      background-size: cover;
      background-position: center;
      min-height: 100%;
    }

    .feature-stack-card h3 {
      font-size: 28px;
      line-height: 1.05;
      margin-bottom: 10px;
      color: var(--brand-darker);
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: end;
      margin-bottom: 18px;
    }

    .section-head h2 {
      font-size: clamp(28px, 4vw, 40px);
      color: var(--brand-darker);
    }

    .section-note {
      max-width: 720px;
      color: var(--stone-light);
    }

    .link-arrow {
      color: var(--brand);
      font-size: 14px;
      font-weight: 700;
    }

    .start-grid,
    .category-grid,
    .utility-grid {
      display: grid;
      gap: 18px;
    }

    .start-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .start-card-body {
      min-height: 190px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(250,247,238,0.95) 100%);
    }

    .start-card h3 {
      font-size: 23px;
      color: var(--brand-dark);
      margin-bottom: 10px;
      line-height: 1.08;
    }

    .start-card-tag {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 14px;
    }

    .category-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .category-card-body {
      min-height: 260px;
      display: flex;
      flex-direction: column;
    }

    .category-card h3 {
      font-size: 24px;
      color: var(--brand-dark);
      margin-bottom: 10px;
    }

    .category-intro {
      margin-bottom: 18px;
    }

    .category-links,
    .utility-links {
      list-style: none;
      display: grid;
      gap: 10px;
    }

    .category-links a,
    .utility-links a {
      color: var(--brand-darker);
      font-weight: 600;
    }

    .category-links a:hover,
    .utility-links a:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    .utility-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .utility-card-body {
      background: white;
    }

    .utility-card h3 {
      font-size: 26px;
      color: var(--brand-dark);
      margin-bottom: 10px;
    }

    .utility-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      margin-top: 18px;
    }

    .utility-pills a {
      display: inline-flex;
      align-items: center;
      min-height: 38px;
      padding: 0 14px;
      border-radius: 999px;
      background: var(--cream-light);
      border: 1px solid rgba(95, 138, 139, 0.14);
      color: var(--brand-dark);
      font-size: 13px;
      font-weight: 600;
    }

    .footer {
      margin-top: 56px;
      background: var(--brand-darker);
      color: rgba(255, 255, 255, 0.86);
    }

    .footer-inner {
      padding-top: 34px;
      padding-bottom: 34px;
      display: flex;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .footer a { color: rgba(255, 255, 255, 0.9); }

    a:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--gold);
      outline-offset: 2px;
    }

    @media (max-width: 1080px) {
      .feature-grid,
      .hero,
      .utility-grid,
      .category-grid,
      .start-grid,
      .feature-main,
      .feature-stack-card {
        grid-template-columns: 1fr;
      }

      .feature-main-image,
      .feature-stack-card-image {
        min-height: 240px;
      }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% set navActive = "guides" %}
  {% set navButtonHref = "/properties/" %}
  {% set navButtonLabel = "Browse Homes" %}
  {% include "partials/site-header.njk" %}

  <main id="main">
    <header class="hero">
      <div>
        <p class="hero-tag">Travel Guides</p>
        <h1 class="hero-title">Florida Gulf Coast guides for choosing where to stay and what to do</h1>
        <p class="hero-subtitle">Local advice on Anna Maria Island, Bradenton, Sarasota, and Siesta Key. Use these guides to compare destinations, plan the trip, and book with more confidence.</p>
      </div>
      <aside class="hero-note">
        <strong>Where to start</strong>
        <p>Start with the featured guide if you are still deciding where to stay. If you already know the area, jump to the section that matches the question you want to answer next.</p>
        <small>Updated {{ site.dateUpdated }}</small>
      </aside>
    </header>

    <section class="section" style="padding-top: 8px;">
      <div class="feature-grid">
        <a class="feature-main" href="{{ featuredStory.url }}">
          <div class="feature-main-image" style="background-image:url('{{ featuredStory.image }}');"></div>
          <div class="feature-main-body">
            <span class="feature-kicker">{{ featuredStory.tag }}</span>
            <p class="card-kicker">{{ featuredStory.eyebrow }}</p>
            <h2>{{ featuredStory.title }}</h2>
            <p>{{ featuredStory.excerpt }}</p>
            <p class="feature-meta">{{ featuredStory.meta }} • Best for travelers still deciding where to base their trip</p>
          </div>
        </a>

        <div class="feature-stack">
          {% for story in secondaryStories %}
          <a class="feature-stack-card" href="{{ story.url }}">
            <div class="feature-stack-card-image" style="background-image:url('{{ story.image }}');"></div>
            <div class="feature-stack-card-body">
              <span class="card-kicker">{{ story.tag }}</span>
              <h3>{{ story.title }}</h3>
              <p>{{ story.excerpt }}</p>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-tag">Start Here</p>
          <h2>Start Here</h2>
        </div>
        <p class="section-note">Start here for the biggest booking questions: where to stay, how to save money, and what to know before you book.</p>
      </div>

      <div class="start-grid">
        {% for story in startHere %}
        <a class="start-card" href="{{ story.url }}">
          <div class="start-card-body">
            <div>
              <span class="start-card-tag">{{ story.tag }}</span>
              <h3>{{ story.label }}</h3>
              <p>{{ story.description }}</p>
            </div>
            <span class="link-arrow">Read this first →</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-tag">Browse by Category</p>
          <h2>Browse by category</h2>
        </div>
        <p class="section-note">Choose the section that matches what you still need to decide, from destination comparisons to trip logistics and owner-side research.</p>
      </div>

      <div class="category-grid">
        <div class="category-card">
          <div class="category-card-body">
            <span class="card-kicker">Comparisons</span>
            <h3>Comparisons</h3>
            <p class="category-intro">For travelers deciding between places, beaches, and trip personalities before they commit to a market.</p>
            <ul class="category-links">
              {% for guide in comparisonLinks %}
              <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="category-card">
          <div class="category-card-body">
            <span class="card-kicker">Area Guides</span>
            <h3>Area Guides</h3>
            <p class="category-intro">Use these once you know the destination and want neighborhood context, beach access, and local planning details.</p>
            <ul class="category-links">
              {% for guide in areaGuides %}
              <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="category-card">
          <div class="category-card-body">
            <span class="card-kicker">Trip Planning</span>
            <h3>Trip Planning</h3>
            <p class="category-intro">The practical layer: timing, logistics, local restaurants, and what to prioritize once the trip is real.</p>
            <ul class="category-links">
              {% for guide in tripPlanning %}
              <li><a href="{{ guide.url }}">{{ guide.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="category-card">
          <div class="category-card-body">
            <span class="card-kicker">Owner Insights</span>
            <h3>Owner Insights</h3>
            <p class="category-intro">For owners and investors comparing markets, management options, and revenue questions before making a move.</p>
            <ul class="category-links">
              {% for page in seoPages.owner %}
              {% if ownerInsightSlugs.indexOf(page.slug) !== -1 %}
              <li><a href="/property-management/{{ page.slug }}/">{{ page.title }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="utility-grid">
        <div class="utility-card">
          <div class="utility-card-body">
            <p class="section-tag">Stay Collections</p>
            <h3>Stay collections by trip type</h3>
            <p>Looking for a specific feature or travel style? These stay collections help you jump straight to the homes that fit.</p>
            <ul class="utility-pills">
              {% for page in staysPages %}
              {% if stayUtilitySlugs.indexOf(page.slug) !== -1 %}
              <li><a href="/stays/{{ page.slug }}/">{{ page.title }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="utility-card">
          <div class="utility-card-body">
            <p class="section-tag">Local Resources</p>
            <h3>Market reports and local help</h3>
            <p>Use these for market context, concierge planning, and trip questions that go beyond picking the destination.</p>
            <ul class="utility-links">
              {% for page in marketIntelLinks %}
              <li><a href="{{ page.url }}">{{ page.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>© 2026 {{ site.name }}</div>
      <div><a href="/">Home</a> · <a href="/about-us/">About Us</a> · <a href="/property-management/">Property Owners</a></div>
    </div>
  </footer>

  {% include "partials/site-header-script.njk" %}
  {% include "partials/analytics-ga4.njk" %}
</body>
</html>
