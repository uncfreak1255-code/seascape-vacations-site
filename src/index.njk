{% from "partials/ui-icon.njk" import uiIcon %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Vacation Rentals AMI, Bradenton & Sarasota | Seascape</title>
    <meta name="description"
        content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota Florida. Private pools, waterfront homes, pet-friendly options.">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://seascape-vacations.com/">
    <meta property="og:title" content="Seascape Vacations | Luxury Florida Vacation Rentals">
    <meta property="og:description" content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota Florida. Private pools, waterfront homes, pet-friendly options.">
    <meta property="og:image" content="https://seascape-vacations.com/images/seascape-og-default.jpg">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Seascape Vacations | Luxury Florida Vacation Rentals">
    <meta name="twitter:description" content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota. Private pools, waterfront homes.">
    <meta name="twitter:image" content="https://seascape-vacations.com/images/seascape-og-default.jpg">
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow">
    <meta name="author" content="Seascape Vacations">
    <link rel="canonical" href="https://seascape-vacations.com/">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="preload" href="/hero-mobile.avif" as="image" type="image/avif" fetchpriority="high" media="(max-width: 768px)">
    <link rel="preload" href="/hero-optimized.avif" as="image" type="image/avif" fetchpriority="high" media="(min-width: 769px)">
    <link rel="preload" href="/assets/fonts/homepage/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/homepage/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/homepage/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- LocalBusiness Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Seascape Vacations",
        "description": "Luxury vacation rental property management company serving Anna Maria Island, Bradenton, Sarasota, and Siesta Key, Florida.",
        "url": "https://seascape-vacations.com",
        "logo": "https://seascape-vacations.com/logo-optimized.png",
        "image": "https://seascape-vacations.com/images/seascape-og-default.jpg",
        "telephone": "+1-941-704-8545",
        "email": "info@seascape-vacations.com",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bradenton",
            "addressRegion": "FL",
            "addressCountry": "US",
            "postalCode": "34209"
        },
        "areaServed": [
            {"@type": "City", "name": "Anna Maria Island"},
            {"@type": "City", "name": "Bradenton"},
            {"@type": "City", "name": "Sarasota"},
            {"@type": "City", "name": "Siesta Key"},
            {"@type": "City", "name": "Longboat Key"}
        ],
        "priceRange": "$400-$800/night",
        "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
        },
        "sameAs": [
            {% for profile in site.sameAsLinks %}
            "{{ profile }}"{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
    <!-- WebSite SearchAction Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Seascape Vacations",
        "url": "https://seascape-vacations.com/",
        "potentialAction": {
            "@type": "SearchAction",
            "target": {
                "@type": "EntryPoint",
                "urlTemplate": "https://seascape-vacations.com/properties/?area={search_term_string}"
            },
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2748551298816267&ev=PageView&noscript=1"/></noscript>

    <link rel="stylesheet" href="/css/homepage.css">
    <style>
        {% include "partials/site-header-styles.njk" %}
    </style>
    <!-- Preconnect to image optimization CDN -->
    <link rel="preconnect" href="https://bookingenginecdn.hostaway.com" crossorigin>
</head>

<body>

    <!-- NAV -->
    {% set navActive = "home" %}
    {% set navButtonHref = "https://book.seascape-vacations.com" %}
    {% set navButtonLabel = "Book Direct" %}
    {% set navButtonTarget = "_blank" %}
    {% set navButtonRel = "noopener noreferrer" %}
    {% set navContactHref = "#contact" %}
    {% include "partials/site-header.njk" %}

    <!-- Mobile CTA Bar (visible on mobile only) -->
    <div class="mobile-cta-bar">
        <div class="cta-info">
            <div class="cta-title">Book Direct & Save</div>
            <div class="cta-subtitle">Best rates guaranteed</div>
        </div>
        <button class="btn btn-gold" onclick="window.open('https://book.seascape-vacations.com', '_blank')">Book Now</button>
    </div>

    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "VacationRental",
        "name": "Seascape Vacations",
        "description": "Luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota Florida",
        "url": "https://seascape-vacations.com",
        "telephone": "+1-941-704-8545",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bradenton",
            "addressRegion": "FL",
            "addressCountry": "US",
            "postalCode": "34209"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "27.4989",
            "longitude": "-82.5748"
        },
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "reviewCount": "500"
        },
        "priceRange": "$$$"
    }
    </script>

    <!-- HOME PAGE -->
    <div id="page-home" class="page active">
        <!-- Hero -->
        <section class="hero">
            <div class="hero-bg" aria-hidden="true">
                <picture>
                    <source media="(max-width: 768px)" srcset="/hero-mobile.avif" type="image/avif">
                    <source media="(max-width: 768px)" srcset="/hero-mobile.webp" type="image/webp">
                    <source srcset="/hero-optimized.avif" type="image/avif">
                    <source srcset="/hero-optimized.webp" type="image/webp">
                    <img
                        class="hero-image"
                        src="/hero-optimized.jpg"
                        alt=""
                        width="2400"
                        height="1340"
                        fetchpriority="high"
                        decoding="async">
                </picture>
            </div>
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="stars">{{ uiIcon('star', 'ui-icon--star') }}{{ uiIcon('star', 'ui-icon--star') }}{{ uiIcon('star', 'ui-icon--star') }}{{ uiIcon('star', 'ui-icon--star') }}{{ uiIcon('star', 'ui-icon--star') }}</span>
                    <span>Rated Excellent by 500+ Guests</span>
                </div>
                <h1 class="hero-title">
                    Your Gulf Coast Paradise Awaits
                    <span>ANNA MARIA ISLAND • BRADENTON • SARASOTA</span>
                </h1>
                <p class="hero-subtitle">Handpicked luxury vacation rentals with private pools, waterfront views, and
                    five-star service.</p>
                <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
                    <a class="btn btn-gold" href="/properties/">Explore Properties</a>
                    <a class="btn btn-outline" href="#contact">Contact Us</a>
                </div>
            </div>
            <div class="search-container">
                <div class="search-box">
                    <div class="search-header">
                        <p>Find your perfect getaway</p>
                    </div>
                    <div class="search-fields">
                        <div class="search-field">
                            <label for="location-select" class="search-label">Location</label>
                            <select id="location-select" style="border:none; background:transparent; font-size:15px; font-weight:500; color:var(--stone); width:100%; font-family:inherit; cursor:pointer; padding:0;">
                                <option value="ami">Anna Maria Area</option>
                                <option value="sarasota">Sarasota</option>
                            </select>
                        </div>

                        <button class="btn btn-primary" onclick="handleSearch()"
                            style="height:100%;border-radius:12px">Search</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div style="padding-top:100px">
            <div class="container">
                <div class="stats-bar">
                    <div class="stat-item">
                        <div class="stat-value">4.98</div>
                        <div class="stat-label">Airbnb Rating</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">650+</div>
                        <div class="stat-label">5-Star Reviews</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">10-15%</div>
                        <div class="stat-label">Book Direct Savings</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">24/7</div>
                        <div class="stat-label">Local Support</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Welcome Section -->
        <section class="section" id="welcome" style="padding-top:40px">
            <div class="container">
                <div class="section-header">
                    <p class="section-tag">Welcome to Seascape</p>
                    <h2 class="section-title">Exceptional Service & Exceptional Fun</h2>
                    <p class="section-subtitle">Our guests book vacations confidently knowing they're going to find
                        exactly what they're looking for without any surprises. Even better, if anything is off about
                        your stay, we'll make it right. That's the Seascape promise.</p>
                </div>
            </div>
        </section>

        <!-- Featured Properties -->
        <section class="section" style="padding-top:0">
            <div class="container">
                <div class="property-section-header">
                    <div>
                        <p class="section-tag" style="text-align:left">Our Collection</p>
                        <h2 class="section-title" style="margin-bottom:0">Featured Properties</h2>
                    </div>
                    <a href="/properties/" class="property-section-cta">View All Properties →</a>
                </div>
                <div class="property-grid">
                    {% for property in properties.slice(0, 3) %}
                    <a class="prop-card prop-card-link" href="/properties/{{ property.slug }}/">
                        <div class="prop-card-shadow"></div>
                        <img
                            loading="lazy"
                            decoding="async"
                            src="{{ property.image | imgProxy(800) }}"
                            srcset="{{ property.image | imgProxy(400) }} 400w, {{ property.image | imgProxy(800) }} 800w, {{ property.image | imgProxy(1200) }} 1200w"
                            sizes="(min-width: 1100px) 50vw, 100vw"
                            onerror="this.onerror=null;this.src='/images/seascape-og-default.jpg';this.srcset='';"
                            alt="{{ property.name }}">
                        <div class="prop-card-overlay"></div>
                        <div class="prop-card-content">
                            <div class="prop-card-top">
                                <div>
                                    <h3 class="prop-title">{{ property.name }}</h3>
                                    <p class="prop-location">{{ property.city }} · {{ property.specs }}</p>
                                </div>
                                <div class="prop-badge">{{ uiIcon('star', 'ui-icon--star') }} {{ property.rating }}</div>
                            </div>
                            <div>
                                <p class="prop-desc-snippet">
                                    {{ property.description }}
                                </p>
                                <div class="prop-highlights">
                                    {% for highlight in property.highlights %}
                                    <div class="prop-highlight"><span class="prop-dot"></span>{{ highlight }}</div>
                                    {% endfor %}
                                </div>
                                <div class="prop-bottom">
                                    <span class="prop-btn">View Details →</span>
                                </div>
                            </div>
                        </div>
                    </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Why Book Direct -->
        <section class="section" style="background:var(--cream-dark)">
            <div class="container">
                <div class="section-header">
                    <p class="section-tag">Why Book Direct</p>
                    <h2 class="section-title">The Seascape Difference</h2>
                </div>
                <div class="feature-grid">
                    <div class="feature-card">
                        <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                        <h3 class="feature-title">Best Price Guaranteed</h3>
                        <p class="feature-desc">Book direct and save up to 20%. No hidden OTA fees or service charges.
                        </p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
                        <h3 class="feature-title">Local Hosts Who Care</h3>
                        <p class="feature-desc">We live here and love it. Get real insider tips and personalized
                            recommendations.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
                        <h3 class="feature-title">5-Star Service Always</h3>
                        <p class="feature-desc">Immaculate homes, thoughtful touches, and 24/7 support for peace of
                            mind.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Reviews -->
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <p class="section-tag">Guest Reviews</p>
                    <h2 class="section-title">What Our Guests Say</h2>
                </div>
                <div class="review-grid">
                    <div class="review-card">
                        <div class="review-stars">{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}</div>
                        <p class="review-text">"This home was by far the best we have ever rented. We saw Manatees and
                            Dolphins right from the back porch!! The home was absolutely beautiful, and decorated to a
                            T!"</p>
                        <div class="review-author">
                            <div class="review-avatar">K</div>
                            <div>
                                <div class="review-name">Kate O'Hara</div>
                                <div class="review-property">Dockside Dreams</div>
                            </div>
                        </div>
                    </div>
                    <div class="review-card">
                        <div class="review-stars">{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}</div>
                        <p class="review-text">"Hands down the best rental we've ever experienced. The place was
                            spotlessly clean and the hosts responded to every question immediately!"</p>
                        <div class="review-author">
                            <div class="review-avatar">K</div>
                            <div>
                                <div class="review-name">Kurt Jones</div>
                                <div class="review-property">Dockside Dreams</div>
                            </div>
                        </div>
                    </div>
                    <div class="review-card">
                        <div class="review-stars">{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}{{ uiIcon('star', 'ui-icon--review-star') }}</div>
                        <p class="review-text">"Absolutely perfect for our family vacation! The property is stunning and
                            had everything we needed. Can't wait to come back!"</p>
                        <div class="review-author">
                            <div class="review-avatar">F</div>
                            <div>
                                <div class="review-name">Farzad Alizadeh</div>
                                <div class="review-property">Sarasota Luxe</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="cta-bg" aria-hidden="true">
                <img
                    class="cta-bg-image"
                    src="/images/sarasota-sunset-hero.jpg"
                    alt=""
                    width="1024"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low">
            </div>
            <div class="cta-overlay"></div>
            <div class="cta-content">
                <p style="font-size:12px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.8;margin-bottom:16px">
                    For Property Owners</p>
                <h2 class="cta-title">Partner With Seascape Vacations</h2>
                <p class="cta-text">Own a property in the Bradenton-Sarasota area? Join our portfolio and enjoy
                    exceptional returns with our full-service property management.</p>
                <div class="cta-buttons">
                    <a class="btn btn-white" href="/property-management/">Learn More</a>
                    <a href="tel:9417048545" class="btn btn-outline">Call (941) 704-8545</a>
                </div>
            </div>
        </section>

        <!-- Blog Preview -->
        <section class="section">
            <div class="container">
                <div class="property-section-header">
                    <div>
                        <p class="section-tag" style="text-align:left">Plan Your Stay</p>
                        <h2 class="section-title" style="margin-bottom:0">Start With The Right Guide</h2>
                    </div>
                    <a href="/guides/" style="color:var(--brand);font-weight:500;text-decoration:none">View all →</a>
                </div>
                <div class="blog-grid">
                    <a class="blog-card" href="/guides/bradenton-vs-sarasota/" style="display:block;color:inherit;text-decoration:none">
                        <div class="blog-card-img"><img
                                src="/images/sarasota-sunset-hero.jpg"
                                alt="Bradenton vs Sarasota comparison" width="400" height="250" loading="lazy"
                                decoding="async"></div>
                        <div class="blog-card-body">
                            <span class="blog-tag">City Comparison</span>
                            <h3 class="blog-card-title">Bradenton vs Sarasota</h3>
                            <p class="blog-card-excerpt">Use the high-intent comparison first if you are choosing between value, beaches, dining, and pace.</p>
                            <p class="blog-card-meta">Updated March 2026</p>
                        </div>
                    </a>
                    <a class="blog-card" href="/guides/anna-maria-island-vs-siesta-key/" style="display:block;color:inherit;text-decoration:none">
                        <div class="blog-card-img"><img
                                src="/images/siesta-key-intro.webp"
                                alt="Anna Maria Island vs Siesta Key comparison" width="400" height="250" loading="lazy"
                                decoding="async"></div>
                        <div class="blog-card-body">
                            <span class="blog-tag">Beach Comparison</span>
                            <h3 class="blog-card-title">Anna Maria Island vs Siesta Key</h3>
                            <p class="blog-card-excerpt">See which island fits your trip before you lock in the wrong vibe for a week.</p>
                            <p class="blog-card-meta">Updated March 2026</p>
                        </div>
                    </a>
                    <a class="blog-card" href="/guides/anna-maria-island-area-guide/" style="display:block;color:inherit;text-decoration:none">
                        <div class="blog-card-img"><img
                                src="/images/ami-hero.webp"
                                alt="Anna Maria Island area guide" width="400" height="250" loading="lazy"
                                decoding="async"></div>
                        <div class="blog-card-body">
                            <span class="blog-tag">Destination Guide</span>
                            <h3 class="blog-card-title">Anna Maria Island Area Guide</h3>
                            <p class="blog-card-excerpt">Get the logistics, neighborhoods, and beach access context before you book.</p>
                            <p class="blog-card-meta">Local planning guide</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </div>

    <!-- FOOTER -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-grid" style="grid-template-columns: 2fr 1fr 1fr 1fr 1fr;">
                <div>
                    <div class="footer-brand">
                        <svg viewBox="0 0 100 100" width="44" height="44" fill="none" stroke="rgba(255,255,255,0.9)"
                            stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M50 12 L88 78 Q92 86 84 88 L16 88 Q8 86 12 78 Z" />
                            <path d="M20 72 Q32 50 48 56 Q62 62 72 52 Q78 46 82 48" stroke-width="3.5" />
                            <path d="M26 62 Q32 54 38 58" stroke-width="2.5" />
                            <path d="M30 70 Q36 62 42 66" stroke-width="2.5" />
                            <path d="M22 78 Q28 70 34 74" stroke-width="2.5" />
                        </svg>
                        <div class="footer-logo-text">Seascape Vacations</div>
                    </div>
                    <p class="footer-desc">Your premier destination for luxury vacation rentals in the
                        Sarasota-Bradenton area. Experience exceptional service and unforgettable stays.</p>
                    <div style="margin-top: 16px;">
                        <a href="tel:9417048545" class="footer-link"
                            style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">{{ uiIcon('phone', 'ui-icon--footer') }} (941)
                            704-8545</a>
                        <a href="mailto:info@seascape-vacations.com" class="footer-link"
                            style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">{{ uiIcon('email', 'ui-icon--footer') }}
                            info@seascape-vacations.com</a>
                        <span class="footer-link" style="display: flex; align-items: center; gap: 8px;">{{ uiIcon('location', 'ui-icon--footer') }}
                            Sarasota-Bradenton, FL</span>
                    </div>
                </div>
                <div>
                    <p class="footer-heading">Company</p>
                    <a class="footer-link" href="/about-us/">About Us</a>
                    <a class="footer-link" href="/properties/">Our Properties</a>
                    <a class="footer-link" href="/property-management/">For Owners</a>
                    <a class="footer-link" href="#contact">Contact</a>
                </div>
                <div>
                    <p class="footer-heading">Support</p>
                    <span class="footer-link" onclick="openLegalModal('support')">FAQs</span>
                    <span class="footer-link" onclick="openLegalModal('terms')">Booking Policy</span>
                    <span class="footer-link" onclick="openLegalModal('terms')">Cancellation</span>
                    <span class="footer-link" onclick="openLegalModal('support')">Guest Guide</span>
                </div>
                <div>
                    <p class="footer-heading">Legal</p>
                    <span class="footer-link" onclick="openLegalModal('privacy')">Privacy Policy</span>
                    <span class="footer-link" onclick="openLegalModal('terms')">Terms of Service</span>
                    <span class="footer-link" onclick="openLegalModal('cookies')">Cookie Policy</span>
                </div>
                <div>
                    <p class="footer-heading">Follow Us</p>
                    <div class="footer-social">
                        <a href="{{ site.socialLinks.facebook }}" target="_blank" rel="noopener noreferrer"
                            class="footer-social-link" title="Facebook">FB</a>
                        <a href="{{ site.socialLinks.instagram }}" target="_blank" rel="noopener noreferrer"
                            class="footer-social-link" title="Instagram">IG</a>
                        {% if site.businessProfiles and site.businessProfiles.googleBusinessProfile %}
                        <a href="{{ site.businessProfiles.googleBusinessProfile }}" target="_blank" rel="noopener noreferrer"
                            class="footer-social-link" title="Google Business Profile">G</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="footer-bottom">© 2026 Seascape Vacations. All rights reserved.</div>
        </div>
    </footer>

    <!-- LEGAL MODAL -->
    <div id="legal-modal" class="modal-overlay" onclick="closeLegalModal()">
        <div class="modal-content" onclick="event.stopPropagation()">
            <span class="close-modal" onclick="closeLegalModal()">&times;</span>
            <h2 id="modal-title"
                style="margin-bottom:20px; font-family:'Playfair Display', serif; color:var(--brand-dark);"></h2>
            <div id="modal-body" style="line-height:1.8; color:var(--stone);"></div>
        </div>
    </div>

    <!-- EMAIL CAPTURE POPUP -->
    <div id="email-popup" class="email-popup-overlay" onclick="closeEmailPopup()">
        <div class="email-popup" onclick="event.stopPropagation()">
            <button class="email-popup-close" type="button" aria-label="Close offer popup" onclick="closeEmailPopup()">{{ uiIcon('close', 'ui-icon--control') }}</button>

            <!-- Form Content -->
            <div id="email-form-content">
                <span class="email-popup-badge">Exclusive Offer</span>
                <h3 class="email-popup-title">Get $50 Off Your Next Stay</h3>
                <p class="email-popup-subtitle">Join our list for exclusive deals, local tips, and priority access to
                    new properties. Book direct and save more.</p>

                <form class="email-popup-form" id="email-capture-form" onsubmit="handleEmailSubmit(event)">
                    <input type="text" name="name" class="email-popup-input" placeholder="Your first name" required>
                    <input type="email" name="email" class="email-popup-input" placeholder="Your email address"
                        required>
                    <button type="submit" class="email-popup-btn">Get My $50 Credit →</button>
                </form>

                <p class="email-popup-privacy">{{ uiIcon('secure', 'ui-icon--inline') }} No spam, ever. Unsubscribe anytime.</p>
            </div>

            <!-- Success Content -->
            <div id="email-success-content" class="email-popup-success">
                <div class="email-popup-success-icon">{{ uiIcon('check', 'ui-icon--success') }}</div>
                <h3 class="email-popup-title">You're In! Here's Your Code</h3>
                <p style="font-size:2rem;font-weight:700;letter-spacing:4px;color:#5F8A8B;background:#f0f7f7;padding:12px 24px;border-radius:8px;border:2px dashed #5F8A8B;display:inline-block;margin:12px 0;">SAVE50</p>
                <p class="email-popup-subtitle">Use code <strong>SAVE50</strong> at checkout to save $50 on your stay (3+ nights). We also sent it to your email so you won't lose it.</p>
                <button class="email-popup-btn" onclick="closeEmailPopup()" style="margin-top: 16px;">Browse Properties
                    &rarr;</button>
            </div>
        </div>
    </div>

    <script defer src="/assets/js/homepage.js"></script>
    {% include "partials/site-header-script.njk" %}

</body>

</html>
