{% from "partials/ui-icon.njk" import uiIcon %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Vacation Rentals AMI, Bradenton & Sarasota | Seascape</title>
    <meta name="description"
        content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota Florida. Private pools, waterfront homes, pet-friendly options.">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://seascape-vacations.com/">
    <meta property="og:title" content="Seascape Vacations | Luxury Florida Vacation Rentals">
    <meta property="og:description" content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota Florida. Private pools, waterfront homes, pet-friendly options.">
    <meta property="og:image" content="https://seascape-vacations.com/images/seascape-og-default.jpg">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Seascape Vacations | Luxury Florida Vacation Rentals">
    <meta name="twitter:description" content="Book direct and save on luxury vacation rentals in Anna Maria Island, Bradenton, and Sarasota. Private pools, waterfront homes.">
    <meta name="twitter:image" content="https://seascape-vacations.com/images/seascape-og-default.jpg">
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow">
    <meta name="author" content="Seascape Vacations">
    <link rel="canonical" href="https://seascape-vacations.com/">
    <link rel="icon" href="/logo-optimized.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- DNS Prefetch for third-party resources (improves mobile performance) -->
    <link rel="dns-prefetch" href="https://connect.facebook.net">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <!-- Preload critical assets - responsive hero images -->
    <link rel="preload" href="hero-mobile.webp" as="image" type="image/webp" fetchpriority="high" media="(max-width: 768px)">
    <link rel="preload" href="hero-optimized.webp" as="image" type="image/webp" fetchpriority="high" media="(min-width: 769px)">
    
    <!-- LocalBusiness Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Seascape Vacations",
        "description": "Luxury vacation rental property management company serving Anna Maria Island, Bradenton, Sarasota, and Siesta Key, Florida.",
        "url": "https://seascape-vacations.com",
        "logo": "https://seascape-vacations.com/logo-optimized.png",
        "image": "https://seascape-vacations.com/images/seascape-og-default.jpg",
        "telephone": "+1-941-704-8545",
        "email": "info@seascape-vacations.com",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bradenton",
            "addressRegion": "FL",
            "addressCountry": "US"
        },
        "areaServed": [
            {"@type": "City", "name": "Anna Maria Island"},
            {"@type": "City", "name": "Bradenton"},
            {"@type": "City", "name": "Sarasota"},
            {"@type": "City", "name": "Siesta Key"},
            {"@type": "City", "name": "Longboat Key"}
        ],
        "priceRange": "$400-$800/night",
        "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
        },
        "sameAs": [
            {% for profile in site.sameAsLinks %}
            "{{ profile }}"{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
    <!-- Non-blocking Google Fonts (fixes LCP issue) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" media="print" onload="this.media='all'"
    >
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    </noscript>

