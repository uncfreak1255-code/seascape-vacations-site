# Seascape Vacations - Environment Variables
# Copy this to your Netlify Dashboard > Site Settings > Environment Variables
# NEVER commit actual keys to git!

# Hostaway API Credentials
HOSTAWAY_ID=your_account_id_here
HOSTAWAY_SECRET=your_api_key_here

# Stripe (for payments)
STRIPE_PUBLIC_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here

# Mailchimp guest capture enrichment
# Used by netlify/functions/guest-email-capture.js for member upserts, tags, and capture events.
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER_PREFIX=us6
MAILCHIMP_AUDIENCE_ID=95e5a594d1
