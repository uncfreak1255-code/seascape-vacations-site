# Seascape Vacations - Environment Variables
# Copy this to your Netlify Dashboard > Site Settings > Environment Variables
# NEVER commit actual keys to git!

# Hostaway API Credentials
HOSTAWAY_ID=your_account_id_here
HOSTAWAY_SECRET=your_api_key_here

# Stripe (for payments)
STRIPE_PUBLIC_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here

# Mailchimp guest capture enrichment
# Used by netlify/functions/guest-email-capture.js for member upserts, tags, and capture events.
# Do NOT use Mailchimp for owner-lead confirmation mail.
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER_PREFIX=us6
MAILCHIMP_AUDIENCE_ID=95e5a594d1

# Owner-lead confirmation ack (Microsoft Graph Mail.Send as info@)
# Required for netlify/functions/submission-created.js to email the owner FROM
# info@seascape-vacations.com after an owner-revenue-teardown submit with email.
# Application permission: Mail.Send, scoped to info@ only (no unscoped tenant-wide Mail.Send).
# Without these three, confirmation mail will NOT send — contact capture still works.
MS_GRAPH_TENANT_ID=your_entra_tenant_id
MS_GRAPH_CLIENT_ID=your_entra_app_client_id
MS_GRAPH_CLIENT_SECRET=your_entra_app_client_secret
# Optional overrides (defaults shown):
# OWNER_LEAD_MAIL_FROM=info@seascape-vacations.com
# OWNER_LEAD_INTERNAL_NOTIFY_TO=info@seascape-vacations.com

# Optional chat ping when an owner lead is captured (Discord/Slack incoming webhook).
# One-step turn-on: paste a webhook URL here in Netlify env. Leave unset to rely on
# Netlify form email notifications + Graph internal notify (when Graph is configured).
# OWNER_LEAD_NOTIFY_WEBHOOK_URL=https://hooks.example/incoming/xxx
