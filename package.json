{
  "name": "seascape-vacations-seo",
  "version": "1.0.0",
  "description": "Seascape Vacations marketing website with programmatic SEO",
  "scripts": {
    "clean:site": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
    "test": "node --test scripts/enforcement/*.test.js",
    "lint:content": "node --test scripts/enforcement/content-voice.test.js",
    "git:preflight": "/Users/sawbeck/bin/guardrail-preflight",
    "git:safe-commit": "/Users/sawbeck/bin/guardrail-safe-commit",
    "git:merge-check": "/Users/sawbeck/bin/guardrail-merge-check",
    "normalize:guides": "node scripts/guides/normalize-guides.js",
    "upgrade:priority-guides": "node scripts/guides/upgrade-priority-guides.js",
    "start": "npm run clean:site && npx @11ty/eleventy --serve",
    "build": "node scripts/enforcement/build-site.js",
    "build:prod": "NODE_ENV=production node scripts/enforcement/build-site.js",
    "setup:hooks": "node scripts/enforcement/install-hooks.js",
    "property:truth:regen": "node scripts/regenerate-property-surfaces.js",
    "property:truth:check": "node scripts/regenerate-property-surfaces.js --check",
    "repo:hygiene": "node scripts/enforcement/repo-hygiene.js",
    "repo:graveyard:audit": "node scripts/enforcement/graveyard-prune.js",
    "repo:graveyard:apply": "node scripts/enforcement/graveyard-prune.js --apply",
    "verify:recovery:p0": "node scripts/recovery/assert-build-output.js p0",
    "verify:recovery:guides": "node scripts/recovery/assert-build-output.js guides",
    "verify:recovery:remediation": "node scripts/recovery/assert-build-output.js remediation",
    "verify:recovery:live": "node scripts/recovery/assert-live-smoke.js https://seascape-vacations.com",
    "verify:direct-booking-events": "node scripts/recovery/assert-direct-booking-event-smoke.js https://seascape-vacations.com",
    "verify:redirects": "node scripts/enforcement/validate-redirect-targets.js",
    "verify:links": "node scripts/enforcement/validate-internal-links.js",
    "verify:jsonld": "node scripts/enforcement/validate-jsonld.js",
    "verify:release": "node scripts/enforcement/verify-release.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "html-minifier-terser": "^7.2.0"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.2"
  }
}
